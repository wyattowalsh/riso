    {
      "id": "W4.H.T1",
      "wave": 4,
      "agent": "HANDOFF",
      "deps": ["W3.R.T1", "W3.G.T1"],
      "title": "Residual handoffs + FIX_LIST closeout",
      "writes": ["goals/riso-lane-sys/handoffs/**", "goals/riso-lane-sys/FIX_LIST.json"],
      "acceptance": ["QUAL test handoff if test_go_templates import paths stale"]
    },
    {
      "id": "W4.V.T1",
      "wave": 4,
      "agent": "VERIFY",
      "deps": ["W4.H.T1"],
      "title": "Final verification suite",
      "commands": [
        "uv run riso validate --answers-file samples/go-api/copier-answers.yml --json",
        "uv run riso validate --answers-file samples/go-cli/copier-answers.yml --json",
        "uv run riso validate --answers-file samples/go-mcp/copier-answers.yml --json",
        "uv run pytest tests/unit/test_go_templates.py -q",
        "uv run python scripts/ci/validate_jinja_templates.py $(find template/files/go template/files/rust -name '*.jinja')"
      ],
      "writes": [],
      "acceptance": [
        "template-owned failures zero",
        "C3 answers failures documented only",
        "path audit clean"
      ]
    }
  ],
  "criticalPath": [
    "W0.T4",
    "W1.G.T1",
    "W1.G.T2",
    "W2.G.T1",
    "W2.G.T2",
    "W2.G.T7",
    "W3.G.T1",
    "W4.V.T1"
  ],
  "parallelSets": [
    ["W0.T1", "W0.T2", "W0.T3"],
    ["W1.G.T1", "W1.G.T2", "W1.R.T1", "W1.R.T2", "W1.H.T1"],
    ["W2.G.T2", "W2.G.T3", "W2.G.T4", "W2.G.T5", "W2.G.T6", "W2.R.T1", "W2.R.T2", "W2.R.T3"],
    ["W3.R.T1", "W3.G.T1"]
