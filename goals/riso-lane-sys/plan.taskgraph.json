      "acceptance": ["chi/echo/fiber not thinner than gin for status+latency logging"]
    },
    {
      "id": "W2.G.T5",
      "wave": 2,
      "agent": "GO-CLI",
      "deps": ["W1.G.T1", "W1.G.T2"],
      "title": "CLI import rewire + Cobra polish",
      "writes": ["template/files/go/cli/**"],
      "acceptance": ["shared imports; obsolete cli/internal removed or empty"]
    },
    {
      "id": "W2.G.T6",
      "wave": 2,
      "agent": "GO-MCP",
      "deps": ["W0.T4"],
      "title": "MCP go_version + SDK + server polish",
      "writes": ["template/files/go/mcp/**"],
      "acceptance": ["go.mod uses go_version; README matches"]
    },
    {
      "id": "W2.R.T1",
      "wave": 2,
      "agent": "RS-API",
      "deps": ["W1.R.T1"],
      "title": "Modernize Actix API module",
      "writes": ["template/files/rust/api/**"],
      "acceptance": ["actix-web only; graceful shutdown; tests idiomatic"]
    },
    {
      "id": "W2.R.T2",
      "wave": 2,
      "agent": "RS-CLI",
      "deps": ["W1.R.T1"],
      "title": "Modernize Clap CLI module",
      "writes": ["template/files/rust/cli/**"],
      "acceptance": ["clap derive; tracing; subcommands"]
    },
    {
      "id": "W2.R.T3",
      "wave": 2,
      "agent": "RS-MCP",
      "deps": ["W1.R.T1"],
      "title": "Modernize rmcp MCP module",
      "writes": ["template/files/rust/mcp/**"],
      "acceptance": ["MSRV 1.81; transport axum only for sse/http"]
    },
    {
      "id": "W2.G.T7",
      "wave": 2,
      "agent": "GO-TOOL",
      "deps": ["W1.G.T1", "W2.G.T1", "W2.G.T5", "W2.G.T6"],
      "title": "Root go.mod/work/Makefile/just/Docker/air/golangci/README",
      "writes": [
        "template/files/go/go.mod.jinja",
        "template/files/go/go.work.jinja",
        "template/files/go/Makefile.jinja",
        "template/files/go/justfile.jinja",
        "template/files/go/Dockerfile.jinja",
        "template/files/go/.golangci.yml.jinja",
        "template/files/go/.air.toml.jinja",
        "template/files/go/README.md.jinja",
        "template/files/go/config.example.yaml.jinja"
      ],
      "acceptance": ["module-aware targets; air not forced on cli/internal only"]
    },
    {
      "id": "W3.R.T1",
      "wave": 3,
      "agent": "RS-DOCS",
      "deps": ["W2.R.T1", "W2.R.T2", "W2.R.T3", "W1.R.T2"],
      "title": "Rust docs + in-tree tests alignment",
      "writes": [
        "template/files/rust/README.md.jinja",
        "template/files/rust/QUICKSTART.md.jinja",
        "template/files/rust/ARCHITECTURE.md.jinja",
        "template/files/rust/tests/**"
