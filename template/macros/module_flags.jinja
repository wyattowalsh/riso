{%- macro cli_enabled() -%}
{{ cli_module | lower == "enabled" }}
{%- endmacro -%}

{%- macro python_cli_enabled() -%}
{{ cli_module | lower == "enabled" and "python" in cli_languages }}
{%- endmacro -%}

{%- macro api_feature_enabled(feature) -%}
{{ (feature in api_features) or (feature == "graphql" and graphql_api_module | lower == "enabled") or (feature == "websocket" and websocket_module | lower == "enabled") }}
{%- endmacro -%}

{%- macro python_api_enabled() -%}
{{ api_module == "enabled" and "python" in api_languages }}
{%- endmacro -%}

{%- macro node_api_enabled() -%}
{{ api_module == "enabled" and "node" in api_languages }}
{%- endmacro -%}

{%- macro mcp_enabled() -%}
{{ mcp_module | lower == "enabled" }}
{%- endmacro -%}

{%- macro docs_fumadocs() -%}
{{ docs_module == "enabled" and docs_framework == "fumadocs" }}
{%- endmacro -%}

{%- macro shared_logic_enabled() -%}
{{ shared_logic | lower == "enabled" }}
{%- endmacro -%}

{%- macro monorepo_layout() -%}
{{ project_layout | lower == "monorepo" }}
{%- endmacro -%}
