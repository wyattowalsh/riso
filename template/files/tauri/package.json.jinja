{% if desktop_module == "enabled" and desktop_framework == "tauri" %}
{
  "name": "{{ project_slug }}-tauri",
  "version": "0.1.0",
  "description": "{{ project_description | default(project_name ~ ' - A Tauri desktop application') }}",
  "type": "module",
  "homepage": "https://github.com/{{ github_username | default('your-username') }}/{{ project_slug }}",
  "author": {
    "name": "{{ author_name | default(project_name) }}"
  },
  "license": "MIT",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:frontend": "vite",
    "build": "tauri build",
    "build:frontend": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,html}\"",
    "icons": "tauri icon src-tauri/icons/icon.png",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-shell": "^2.0.0",
    {% if desktop_features is defined and 'auto_updater' in desktop_features %}
    "@tauri-apps/plugin-updater": "^2.0.0",
    "@tauri-apps/plugin-process": "^2.0.0",
    {% endif %}
    {% if desktop_features is defined and 'notifications' in desktop_features %}
    "@tauri-apps/plugin-notification": "^2.0.0",
    {% endif %}
    {% if desktop_features is defined and 'file_system' in desktop_features %}
    "@tauri-apps/plugin-fs": "^2.0.0",
    {% endif %}
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.3",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.2.0",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "postcss": "^8.5.1",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "5.1.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.1.0",
    "@testing-library/jest-dom": "^7.0.1"
  }
}
{% endif %}
