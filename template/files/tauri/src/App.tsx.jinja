{% if desktop_module == "enabled" and desktop_framework == "tauri" %}
import { useState{% if desktop_features is defined and 'system_info' in desktop_features %}, useEffect{% endif %} } from 'react';
import { invoke } from '@tauri-apps/api/core';
{% if desktop_features is defined and 'custom_titlebar' in desktop_features %}
import TitleBar from './components/TitleBar';
{% endif %}
{% if desktop_features is defined and 'auto_updater' in desktop_features %}
import UpdateChecker from './components/UpdateChecker';
{% endif %}

{% if desktop_features is defined and 'system_info' in desktop_features %}
interface SystemInfo {
  os: string;
  os_version: string;
  arch: string;
  hostname: string;
  cpu_count: number;
  total_memory: number;
  available_memory: number;
}

interface SystemInfoResponse {
  success: boolean;
  data?: SystemInfo;
  error?: string;
}
{% endif %}

function App() {
  const [greetMsg, setGreetMsg] = useState('');
  const [name, setName] = useState('');
  {% if desktop_features is defined and 'system_info' in desktop_features %}
  const [systemInfo, setSystemInfo] = useState<SystemInfo | null>(null);
  {% endif %}

  async function greet() {
    try {
      const response = await invoke<string>('greet', { name });
      setGreetMsg(response);
    } catch (error) {
      console.error('Failed to greet:', error);
      setGreetMsg('Error: Failed to call Rust backend');
    }
  }

  {% if desktop_features is defined and 'system_info' in desktop_features %}
  useEffect(() => {
    async function fetchSystemInfo() {
      try {
        const response = await invoke<SystemInfoResponse>('get_system_info');
        if (response.success && response.data) {
          setSystemInfo(response.data);
        }
      } catch (error) {
        console.error('Failed to get system info:', error);
      }
    }
    void fetchSystemInfo();
  }, []);
  {% endif %}

  return (
    <div className="min-h-screen bg-surface text-ink">
      {% if desktop_features is defined and 'custom_titlebar' in desktop_features %}
      <TitleBar />
      {% endif %}

      <div className="container mx-auto px-4 py-8">
        <div className="mx-auto max-w-2xl">
          <header className="mb-12 text-center">
            <h1 className="mb-4 bg-gradient-to-r from-accent-400 to-accent-600 bg-clip-text text-5xl font-bold text-transparent">
              {{ project_name }}
            </h1>
            <p className="text-lg text-muted">
              Built with Tauri + React + TypeScript
            </p>
          </header>

          <div className="rounded-xl border border-border bg-surface-elevated p-8 shadow-lg">
            <div className="space-y-6">
              <div>
                <label htmlFor="name-input" className="mb-2 block text-sm font-medium text-ink">
                  Enter your name
                </label>
                <input
                  id="name-input"
                  type="text"
                  value={name}
                  onChange={(e) => setName(e.target.value)}
                  onKeyDown={(e) => e.key === 'Enter' && void greet()}
                  placeholder="Your name here..."
                  className="w-full rounded-lg border border-border bg-surface px-4 py-3 transition-all focus-visible:border-transparent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-500"
                />
              </div>

              <button
                type="button"
                onClick={() => void greet()}
                className="w-full rounded-lg bg-accent-600 px-6 py-3 font-semibold text-white transition-colors hover:bg-accent-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent-500 focus-visible:ring-offset-2 focus-visible:ring-offset-surface"
              >
                Greet from Rust!
              </button>

              {greetMsg && (
                <div className="rounded-lg border border-accent-800 bg-accent-900/20 p-4" role="status">
                  <p className="font-medium text-accent-200">{greetMsg}</p>
                </div>
              )}
            </div>
          </div>

          {% if desktop_features is defined and 'system_info' in desktop_features %}
          {systemInfo && (
            <div className="mt-8 rounded-xl border border-border bg-surface-elevated p-8 shadow-lg">
              <h2 className="mb-4 text-2xl font-bold text-accent-500">System Information</h2>
              <dl className="space-y-3">
                <div className="flex justify-between">
                  <dt className="text-muted">Operating System:</dt>
                  <dd className="font-medium text-ink">{systemInfo.os}</dd>
                </div>
                <div className="flex justify-between">
                  <dt className="text-muted">Version:</dt>
                  <dd className="font-medium text-ink">{systemInfo.os_version}</dd>
                </div>
                <div className="flex justify-between">
                  <dt className="text-muted">Architecture:</dt>
                  <dd className="font-medium text-ink">{systemInfo.arch}</dd>
                </div>
                <div className="flex justify-between">
                  <dt className="text-muted">Hostname:</dt>
                  <dd className="font-medium text-ink">{systemInfo.hostname}</dd>
                </div>
                <div className="flex justify-between">
                  <dt className="text-muted">CPU Cores:</dt>
                  <dd className="font-medium text-ink">{systemInfo.cpu_count}</dd>
                </div>
                <div className="flex justify-between">
                  <dt className="text-muted">Total Memory:</dt>
                  <dd className="font-medium text-ink">
                    {(systemInfo.total_memory / 1024 / 1024 / 1024).toFixed(2)} GB
                  </dd>
                </div>
                <div className="flex justify-between">
                  <dt className="text-muted">Available Memory:</dt>
                  <dd className="font-medium text-ink">
                    {(systemInfo.available_memory / 1024 / 1024 / 1024).toFixed(2)} GB
                  </dd>
                </div>
              </dl>
            </div>
          )}
          {% endif %}

          {% if desktop_features is defined and 'auto_updater' in desktop_features %}
          <UpdateChecker />
          {% endif %}
        </div>
      </div>
    </div>
  );
}

export default App;
{% endif %}
