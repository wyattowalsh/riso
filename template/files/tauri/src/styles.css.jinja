{% if desktop_module == "enabled" and desktop_framework == "tauri" %}
@tailwind base;
@tailwind components;
@tailwind utilities;

:root {
  --accent: #14b8a6;
  --accent-rgb: 20 184 166;
  --surface: #f8fafc;
  --surface-elevated: #ffffff;
  --surface-muted: #e2e8f0;
  --text: #0b132b;
  --muted: #475569;
  --border: #cbd5e1;
  --riso-accent: var(--accent);
  --riso-surface: var(--surface);
  --riso-text: var(--text);
  color-scheme: light dark;
  font-family: Inter, system-ui, 'Segoe UI', sans-serif;
  line-height: 1.5;
  font-weight: 400;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

.dark,
[data-theme='dark'] {
  --accent: #14b8a6;
  --accent-rgb: 20 184 166;
  --surface: #0f172a;
  --surface-elevated: #1e293b;
  --surface-muted: #334155;
  --text: #f8fafc;
  --muted: #94a3b8;
  --border: #334155;
  --riso-accent: var(--accent);
  --riso-surface: var(--surface);
  --riso-text: var(--text);
}

@media (prefers-color-scheme: dark) {
  :root:not([data-theme='light']) {
    --accent: #14b8a6;
    --accent-rgb: 20 184 166;
    --surface: #0f172a;
    --surface-elevated: #1e293b;
    --surface-muted: #334155;
    --text: #f8fafc;
    --muted: #94a3b8;
    --border: #334155;
    --riso-accent: var(--accent);
    --riso-surface: var(--surface);
    --riso-text: var(--text);
  }
}

body {
  margin: 0;
  padding: 0;
  min-height: 100vh;
  background: var(--surface);
  color: var(--text);
}

#root {
  min-height: 100vh;
}

{% if desktop_features is defined and 'custom_titlebar' in desktop_features %}
[data-tauri-drag-region] {
  user-select: none;
}
{% endif %}

::-webkit-scrollbar {
  width: 10px;
}

::-webkit-scrollbar-track {
  background: var(--surface);
}

::-webkit-scrollbar-thumb {
  background: var(--surface-muted);
  border-radius: 5px;
}

::-webkit-scrollbar-thumb:hover {
  background: var(--muted);
}
{% endif %}
