name: Tauri checks

on:
  push:
    branches: [main, develop]
  pull_request:
    branches: [main, develop]

permissions:
  contents: read

env:
  CARGO_TERM_COLOR: always
  CARGO_PROFILE_DEV_DEBUG: '0'
  CARGO_PROFILE_TEST_DEBUG: '0'

jobs:
  frontend:
    name: Tauri frontend checks
    runs-on: ubuntu-24.04
    timeout-minutes: 15
    steps:
      - uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10 # v6
      - uses: pnpm/action-setup@b906affcce14559ad1aafd4ab0e942779e9f58b1 # v4
      - uses: actions/setup-node@48b55a011bda9f5d6aeb4c2d9c7362e8dae4041e # v6
        with:
          node-version: '22'
          cache: pnpm
      - run: pnpm install --frozen-lockfile
      - run: pnpm --filter ./tauri --fail-if-no-match run typecheck
      - run: pnpm --filter ./tauri --fail-if-no-match run lint
      - run: pnpm --filter ./tauri --fail-if-no-match run test
      - run: pnpm --filter ./tauri --fail-if-no-match run build:frontend
{% set platforms = desktop_platforms | default(['mac', 'windows', 'linux']) %}
{% if 'mac' in platforms or 'windows' in platforms or 'linux' in platforms %}

  native:
    name: Tauri native checks ({% raw %}${{ matrix.target }}{% endraw %})
    runs-on: {% raw %}${{ matrix.os }}{% endraw %}
    needs: frontend
    timeout-minutes: 45
    strategy:
      fail-fast: false
      matrix:
        include:
          {% if 'mac' in platforms %}
          - os: macos-15-intel
            target: x86_64-apple-darwin
          - os: macos-latest
            target: aarch64-apple-darwin
          {% endif %}
          {% if 'windows' in platforms %}
          - os: windows-latest
            target: x86_64-pc-windows-msvc
          {% endif %}
          {% if 'linux' in platforms %}
          - os: ubuntu-24.04
            target: x86_64-unknown-linux-gnu
          {% endif %}
    steps:
      - uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10 # v6
      - uses: pnpm/action-setup@b906affcce14559ad1aafd4ab0e942779e9f58b1 # v4
      - uses: actions/setup-node@48b55a011bda9f5d6aeb4c2d9c7362e8dae4041e # v6
        with:
          node-version: '22'
          cache: pnpm
      - uses: dtolnay/rust-toolchain@4360b52568e2003a75bf9bc1d59f33a8e3fc893c # stable
        with:
          toolchain: stable
          components: rustfmt, clippy
          targets: {% raw %}${{ matrix.target }}{% endraw %}
      {% if 'linux' in platforms %}
      - name: Install Linux Tauri prerequisites
        if: runner.os == 'Linux'
        run: |
          sudo apt-get update
          sudo apt-get install -y libwebkit2gtk-4.1-dev build-essential curl wget file \
            libxdo-dev libssl-dev libayatana-appindicator3-dev librsvg2-dev
      {% endif %}
      - run: pnpm install --frozen-lockfile
      - name: Build frontend assets for the native checks
        run: pnpm --filter ./tauri --fail-if-no-match run build:frontend
      - name: Check Rust formatting
        working-directory: tauri/src-tauri
        run: cargo fmt --all -- --check
      - name: Check native code
        working-directory: tauri/src-tauri
        run: cargo clippy --all-targets --all-features --target {% raw %}${{ matrix.target }}{% endraw %} -- -D warnings
      - name: Run native tests
        working-directory: tauri/src-tauri
        run: cargo test --all-features --target {% raw %}${{ matrix.target }}{% endraw %}
{% endif %}
