{% if ci_platform == 'github-actions' -%}
# Matrix Testing Workflow
# Auto-generated by Riso template • DO NOT EDIT MANUALLY
# Runs quality checks across Python {{ python_versions|join(', ') }} in parallel
# All versions must pass for PR merge to proceed

name: Matrix Testing

on:
  pull_request:
    branches: [main]
  push:
    branches: [main]
  workflow_dispatch:

concurrency:
  group: {% raw %}${{ github.workflow }}-${{ github.ref }}{% endraw %}
  cancel-in-progress: true

permissions:
  contents: read

env:
  QUALITY_PROFILE: {{ quality_profile }}
  PACKAGE_NAME: {{ package_name }}

jobs:
  {% if (cli_module == 'enabled' and 'python' in cli_languages) or (api_module == 'enabled' and 'python' in api_languages) or (mcp_module == 'enabled' and 'python' in mcp_languages) or (docs_module == 'enabled' and docs_framework == 'sphinx-shibuya') %}
  matrix-test:
    name: Python {% raw %}${{ matrix.python-version }}{% endraw %} Quality
    runs-on: ubuntu-latest
    timeout-minutes: 15
    
    strategy:
      # Never fail-fast - we want to see all Python version results
      fail-fast: false
      max-parallel: 3
      matrix:
        python-version: {{ python_versions|tojson }}
    
    steps:
      - name: Checkout repository
        uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10 # v6
      
      - name: Set up Python {% raw %}${{ matrix.python-version }}{% endraw %}
        uses: actions/setup-python@ece7cb06caefa5fff74198d8649806c4678c61a1 # v6
        with:
          python-version: {% raw %}${{ matrix.python-version }}{% endraw %}
      
      - name: Cache dependencies (version-specific)
        uses: actions/cache@caa296126883cff596d87d8935842f9db880ef25 # v5
        with:
          path: |
            ~/.cache/uv
            ~/.cache/pip
          key: {% raw %}${{ runner.os }}-py${{ matrix.python-version }}-${{ hashFiles('python/uv.lock', '**/uv.lock') }}{% endraw %}
          restore-keys: |
            {% raw %}${{ runner.os }}-py${{ matrix.python-version }}-{% endraw %}
            {% raw %}${{ runner.os }}-{% endraw %}
      
      - name: Set up uv
        uses: astral-sh/setup-uv@d0cc045d04ccac9d8b7881df0226f9e82c39688e # v6
        with:
          version: "latest"
          enable-cache: true
          cache-dependency-glob: "**/uv.lock"
      
      - name: Install dependencies with uv
        working-directory: python
        run: uv sync
      
      - name: Run pytest with retry logic
        uses: nick-fields/retry@ce71cc2ab81d554ebbe88c79ab5975992d79ba08 # v3
        with:
          timeout_minutes: 12
          max_attempts: 3
          retry_wait_seconds: 30
          exponential_backoff: true
          command: uv --directory python run pytest --tb=short --junit-xml=test-results.xml --cov --cov-report=xml
      
      - name: Run type checking (ty)
        run: uv --directory python run ty check
      
      - name: Run linting (ruff)
        run: uv --directory python run ruff check .
{% if quality_profile == 'strict' %}
      
      - name: Run static analysis (pylint) - strict profile only
        run: uv --directory python run pylint src/
{% endif %}
      
      - name: Upload test results and coverage
        if: always()
        uses: actions/upload-artifact@b7c566a772e6b6bfb58ed0dc250532a479d7789f # v6
        with:
          name: matrix-results-py{% raw %}${{ matrix.python-version }}{% endraw %}-{% raw %}${{ github.run_id }}{% endraw %}
          path: |
            python/test-results.xml
            python/coverage.xml
            python/.coverage
          if-no-files-found: warn
          retention-days: 90
      
      - name: Report matrix job status
        if: failure()
        run: |
          echo "::error::Python {% raw %}${{ matrix.python-version }}{% endraw %} quality checks failed"
          echo "This failure blocks PR merge per matrix policy"
          echo "Check logs above for specific test/lint/type failures"

  matrix-summary:
    name: Matrix Summary
    needs: matrix-test
    runs-on: ubuntu-latest
    if: always()
    
    steps:
      - name: Check matrix results
        run: |
          if [ "{% raw %}${{ needs.matrix-test.result }}{% endraw %}" != "success" ]; then
            echo "::error::Matrix testing failed - not all Python versions passed"
            echo "All Python versions ({{ python_versions|join(', ') }}) must pass for merge"
            echo ""
            echo "Required checks:"
{%- for version in python_versions %}
            echo "  • Python {{ version }} Quality"
{%- endfor %}
            echo ""
            echo "Download version-specific artifacts to debug failures locally"
            exit 1
          fi
          echo "✅ All Python versions passed quality checks"
          echo "Tested versions: {{ python_versions|join(', ') }}"
  {% else %}
  scaffold-ok:
    name: Scaffold (no Python matrix)
    runs-on: ubuntu-latest
    steps:
      - name: No Python track on this dest
        run: echo "riso-matrix has no Python jobs when python/ is excluded."
  {% endif %}
{% endif -%}
