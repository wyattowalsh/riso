{% if ci_platform == 'github-actions' %}
name: Quality Checks

on:
  pull_request:
    branches: [main]
  push:
    branches: [main]
  workflow_dispatch:

concurrency:
  group: {% raw %}${{ github.workflow }}-${{ github.ref }}{% endraw %}
  cancel-in-progress: true

env:
  QUALITY_PROFILE: {{ quality_profile }}
  PACKAGE_NAME: {{ package_name }}

jobs:
  {% if (cli_module == 'enabled' and 'python' in cli_languages) or (api_module == 'enabled' and 'python' in api_languages) or (mcp_module == 'enabled' and 'python' in mcp_languages) or (docs_module == 'enabled' and docs_framework == 'sphinx-shibuya') %}
  python-quality:
    name: Python Quality Checks
    runs-on: ubuntu-latest
    timeout-minutes: {% if quality_profile == 'strict' %}20{% else %}10{% endif %}
    
    steps:
      - name: Checkout repository
        uses: actions/checkout@v6
      
      - name: Set up Python
        uses: actions/setup-python@v6
        with:
          python-version: '3.11'
      
      - name: Cache Python dependencies
        uses: actions/cache@v5
        with:
          path: |
            ~/.cache/uv
            ~/.cache/pip
          key: {% raw %}${{ runner.os }}-py3.11-${{ hashFiles('**/uv.lock') }}{% endraw %}
          restore-keys: |
            {% raw %}${{ runner.os }}-py3.11-{% endraw %}
            {% raw %}${{ runner.os }}-{% endraw %}
      
      - name: Set up uv
        uses: astral-sh/setup-uv@v6
        with:
          version: "latest"
          enable-cache: true
          cache-dependency-glob: "**/uv.lock"
      
      - name: Install dependencies
        working-directory: python
        run: |
          export PATH="$HOME/.local/bin:$PATH"
          uv sync
      
      - name: Run quality checks with retry
        uses: nick-fields/retry@v3
        with:
          timeout_minutes: {% if quality_profile == 'strict' %}18{% else %}8{% endif %}
          max_attempts: 3
          retry_wait_seconds: 30
          exponential_backoff: true
          command: |
            export PATH="$HOME/.local/bin:$PATH"
            QUALITY_PROFILE={{ quality_profile }} uv --directory python run task quality
      
      {% if cli_module == 'enabled' %}
      - name: Test CLI module
        working-directory: python
        run: |
          export PATH="$HOME/.local/bin:$PATH"
          uv run pytest tests/test_cli*.py -v
      {% endif %}
      
      {% if mcp_module == 'enabled' and 'python' in mcp_languages %}
      - name: Test MCP module
        working-directory: python
        run: |
          export PATH="$HOME/.local/bin:$PATH"
          uv run pytest tests/test_mcp.py -v
      {% endif %}
      
      - name: Upload test results
        if: always()
        uses: actions/upload-artifact@v6
        with:
          name: test-results-py3.11-{% raw %}${{ github.run_id }}{% endraw %}
          path: |
            python/test-results.xml
            python/htmlcov/
            python/.coverage
          retention-days: 90
      
      - name: Upload quality logs
        if: always()
        uses: actions/upload-artifact@v6
        with:
          name: quality-logs-py3.11-{% raw %}${{ github.run_id }}{% endraw %}
          path: |
            python/.riso/quality-durations.json
            python/ruff-output.txt
            python/ty-output.txt
            python/pylint-output.txt
          retention-days: 90
          if-no-files-found: warn
  {% endif %}

  {% if mcp_module == 'enabled' and 'typescript' in mcp_languages %}
  node-mcp-quality:
    name: Node MCP Quality Checks
    runs-on: ubuntu-latest
    timeout-minutes: {% if quality_profile == 'strict' %}20{% else %}10{% endif %}

    steps:
      - name: Checkout repository
        uses: actions/checkout@v6

      - name: Set up Node.js
        uses: actions/setup-node@v6
        with:
          node-version: '20'

      - name: Enable corepack
        run: corepack enable

      - name: Install dependencies
        run: pnpm install --frozen-lockfile

      - name: Lint MCP server
        run: pnpm --filter @{{ package_name }}/mcp-server run lint

      - name: Typecheck MCP server
        run: pnpm --filter @{{ package_name }}/mcp-server run typecheck

      - name: Test MCP server
        run: pnpm --filter @{{ package_name }}/mcp-server test
  {% endif %}

  {% if api_module == 'enabled' and 'node' in api_languages %}
  node-quality:
    name: Node.js Quality Checks
    runs-on: ubuntu-latest
    timeout-minutes: {% if quality_profile == 'strict' %}20{% else %}10{% endif %}
    
    steps:
      - name: Checkout repository
        uses: actions/checkout@v6
      
      - name: Set up Node.js
        uses: actions/setup-node@v6
        with:
          node-version: '20'
      
      - name: Enable corepack
        run: corepack enable
      
      - name: Cache pnpm dependencies
        uses: actions/cache@v5
        with:
          path: |
            node_modules
            .pnpm-store
          key: {% raw %}${{ runner.os }}-node-${{ hashFiles('**/pnpm-lock.yaml') }}{% endraw %}
          restore-keys: |
            {% raw %}${{ runner.os }}-node-{% endraw %}
      
      - name: Install dependencies
        run: pnpm install --frozen-lockfile
      
      - name: Run ESLint
        run: pnpm run lint
      
      - name: Run TypeScript check
        run: pnpm run type-check
      
      - name: Run tests
        run: pnpm test
      
      - name: Upload Node.js test results
        if: always()
        uses: actions/upload-artifact@v6
        with:
          name: node-test-results-{% raw %}${{ github.run_id }}{% endraw %}
          path: coverage/
          retention-days: 90
          if-no-files-found: warn
  {% endif %}

  {% if mcp_module == 'enabled' and 'rust' in mcp_languages %}
  rust-quality:
    name: Rust Quality Checks
    runs-on: ubuntu-latest
    timeout-minutes: 15
    
    steps:
      - name: Checkout repository
        uses: actions/checkout@v6

      - name: Install Rust toolchain
        uses: actions-rust-lang/setup-rust-toolchain@v1
        with:
          toolchain: stable
          components: clippy, rustfmt

      - name: Cache Cargo Dependencies
        uses: actions/cache@v5
        with:
          path: |
            ~/.cargo/bin/
            ~/.cargo/registry/index/
            ~/.cargo/registry/cache/
            ~/.cargo/git/db/
            target/
          key: {% raw %}${{ runner.os }}-cargo-${{ hashFiles('**/Cargo.lock') }}{% endraw %}
          restore-keys: |
            {% raw %}${{ runner.os }}-cargo-{% endraw %}

      - name: Check formatting
        working-directory: rust/mcp
        run: cargo fmt -- --check

      - name: Run clippy
        working-directory: rust/mcp
        run: cargo clippy -- -D warnings

      - name: Run tests
        working-directory: rust/mcp
        run: cargo test
  {% endif %}

  {% if not (
        (cli_module == 'enabled' and 'python' in cli_languages)
     or (api_module == 'enabled' and 'python' in api_languages)
     or (mcp_module == 'enabled' and 'python' in mcp_languages)
     or (docs_module == 'enabled' and docs_framework == 'sphinx-shibuya')
     or (api_module == 'enabled' and 'node' in api_languages)
     or (mcp_module == 'enabled' and 'typescript' in mcp_languages)
     or (mcp_module == 'enabled' and 'rust' in mcp_languages)
  ) %}
  scaffold-ok:
    name: Scaffold (no language quality jobs)
    runs-on: ubuntu-latest
    steps:
      - name: No Python, Node, or Rust quality tracks selected
        run: echo "No language quality jobs for this combination."
  {% endif %}
{% endif %}
