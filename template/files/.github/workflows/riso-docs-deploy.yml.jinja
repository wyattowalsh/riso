{%- if ci_platform == 'github-actions' and docs_module == 'enabled' and docs_framework == 'fumadocs' -%}
name: Deploy Documentation

on:
  push:
    branches: [main]
    paths:
      - 'node/docs/fumadocs/**'
      - 'package.json'
      - 'pnpm-lock.yaml'
      - 'pnpm-workspace.yaml'
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: docs-deploy-{% raw %}${{ github.ref }}{% endraw %}
  cancel-in-progress: true

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout
        uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10 # v6
        with:
          fetch-depth: 0

      - uses: pnpm/action-setup@b906affcce14559ad1aafd4ab0e942779e9f58b1 # v4
        with:
          version: 9

      - name: Setup Node.js
        uses: actions/setup-node@48b55a011bda9f5d6aeb4c2d9c7362e8dae4041e # v6
        with:
          node-version: '22'
          cache: 'pnpm'

      - name: Install dependencies
        run: pnpm install --frozen-lockfile

      - name: Build documentation
        working-directory: node/docs/fumadocs
        run: pnpm build
        env:
          NEXT_TELEMETRY_DISABLED: 1
{%- if fumadocs_search_provider == 'algolia' %}
          NEXT_PUBLIC_ALGOLIA_APP_ID: {% raw %}${{ secrets.ALGOLIA_APP_ID }}{% endraw %}
          NEXT_PUBLIC_ALGOLIA_SEARCH_API_KEY: {% raw %}${{ secrets.ALGOLIA_SEARCH_API_KEY }}{% endraw %}
{%- endif %}
{%- if fumadocs_ai_search == 'enabled' %}
          OPENAI_API_KEY: {% raw %}${{ secrets.OPENAI_API_KEY }}{% endraw %}
{%- endif %}

      - name: Setup Pages
        uses: actions/configure-pages@983d7736d9b0ae728b81ab479565c72886d7745b # v5

      - name: Upload build artifact
        uses: actions/upload-pages-artifact@56afc609e74202658d3ffba0e8f6dda462b719fa # v3
        with:
          path: node/docs/fumadocs/out
{%- if fumadocs_search_provider == 'algolia' %}

  sync-algolia:
    runs-on: ubuntu-latest
    needs: build
    steps:
      - name: Checkout
        uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10 # v6

      - uses: pnpm/action-setup@b906affcce14559ad1aafd4ab0e942779e9f58b1 # v4
        with:
          version: 9

      - name: Setup Node.js
        uses: actions/setup-node@48b55a011bda9f5d6aeb4c2d9c7362e8dae4041e # v6
        with:
          node-version: '22'
          cache: 'pnpm'

      - name: Install dependencies
        run: pnpm install --frozen-lockfile

      - name: Sync search index
        working-directory: node/docs/fumadocs
        run: pnpm search:sync
        env:
          ALGOLIA_APP_ID: {% raw %}${{ secrets.ALGOLIA_APP_ID }}{% endraw %}
          ALGOLIA_ADMIN_API_KEY: {% raw %}${{ secrets.ALGOLIA_ADMIN_API_KEY }}{% endraw %}
{%- endif %}

  deploy:
    runs-on: ubuntu-latest
    needs: build
    permissions:
      pages: write
      id-token: write
    environment:
      name: github-pages
      url: {% raw %}${{ steps.deployment.outputs.page_url }}{% endraw %}
    steps:
      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@d6db90164ac5ed86f2b6aed7e0febac5b3c0c03e # v4
{%- endif -%}
