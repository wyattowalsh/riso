name: Container Publish

# Publish container images to registries on main branch pushes and tags
# Supports: GitHub Container Registry (ghcr.io), Docker Hub, AWS ECR
# Tag pushes: semver (v1.2.3, v1.2, v1). Main pushes: latest + sha only.
# Trivy scans an immutable image in an ephemeral registry before publishing to GHCR.

on:
  push:
    branches: [main]
    tags:
      - 'v[0-9]+.[0-9]+.[0-9]+'
  workflow_dispatch:

concurrency:
  group: {% raw %}${{ github.workflow }}-${{ github.ref }}{% endraw %}
  cancel-in-progress: true

permissions:
  contents: read
  packages: write  # Required for ghcr.io publishing
  id-token: write  # OIDC for ghcr.io trusted publishing

jobs:
{%- if api_module == "enabled" and (("python" in api_languages) or ("node" in api_languages)) %}
  publish-ghcr:
    name: Publish to GitHub Container Registry
    runs-on: ubuntu-latest
    services:
      registry:
        image: registry:3.1.2@sha256:d4032d4cc323c1731c707931ecada07a53076eac38e3b61ae57533f170f2c6c3
        ports:
          - 5000:5000
    strategy:
      matrix:
        target:
{%- if api_module == "enabled" and "python" in api_languages %}
          - { name: python, dockerfile_target: runtime-python, image: api-python }
{%- endif %}
{%- if api_module == "enabled" and "node" in api_languages %}
          - { name: node, dockerfile_target: runtime-node, image: api-node }
{%- endif %}
    steps:
      - name: Checkout code
        uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10 # v6
        with:
          fetch-depth: 0

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@8d2750c68a42422c14e847fe6c8ac0403b4cbd6f # v3
        with:
          driver-opts: network=host
          buildkitd-config-inline: |
            [registry."localhost:5000"]
              http = true

      - name: Wait for local registry
        run: curl --fail --silent --show-error --retry 10 --retry-connrefused --retry-delay 1 http://localhost:5000/v2/

      - name: Generate image tags
        id: tags
        run: |
          OWNER="{% raw %}${{ github.repository_owner }}{% endraw %}"
          IMAGE_NAME="{% raw %}${{ matrix.target.image }}{% endraw %}"
          SHA="{% raw %}${{ github.sha }}{% endraw %}"
          REF_TYPE="{% raw %}${{ github.ref_type }}{% endraw %}"
          REF_NAME="{% raw %}${{ github.ref_name }}{% endraw %}"
          IMAGE="ghcr.io/${OWNER}/${IMAGE_NAME}"
          SCAN_REPOSITORY="riso/${IMAGE_NAME}"
          SCAN_TAG="localhost:5000/${SCAN_REPOSITORY}:${SHA}"
          echo "scan_repository=${SCAN_REPOSITORY}" >> "$GITHUB_OUTPUT"
          echo "scan_tag=${SCAN_TAG}" >> "$GITHUB_OUTPUT"
          if [ "$REF_TYPE" = "tag" ]; then
            VERSION="${REF_NAME#v}"
            MAJOR=$(echo "$VERSION" | cut -d. -f1)
            MINOR=$(echo "$VERSION" | cut -d. -f2)
            PATCH=$(echo "$VERSION" | cut -d. -f3)
            TAGS="${IMAGE}:v${MAJOR}.${MINOR}.${PATCH}"
            TAGS="${TAGS},${IMAGE}:v${MAJOR}.${MINOR}"
            TAGS="${TAGS},${IMAGE}:v${MAJOR}"
          else
            TAGS="${IMAGE}:latest,${IMAGE}:${SHA}"
          fi
          echo "tags=${TAGS}" >> "$GITHUB_OUTPUT"
          echo "Generated tags: $TAGS"

      - name: Cache Docker layers
        uses: actions/cache@caa296126883cff596d87d8935842f9db880ef25 # v5
        with:
          path: /tmp/.buildx-cache
          key: {% raw %}${{ runner.os }}-buildx-${{ matrix.target.name }}-${{ hashFiles('**/uv.lock', '**/pnpm-lock.yaml') }}{% endraw %}
          restore-keys: |
            {% raw %}${{ runner.os }}-buildx-${{ matrix.target.name }}-{% endraw %}

      - name: Build image
        id: build
        uses: docker/build-push-action@ca052bb54ab0790a636c9b5f226502c73d547a25 # v5
        with:
          context: .
          file: .docker/Dockerfile
          target: {% raw %}${{ matrix.target.dockerfile_target }}{% endraw %}
          push: true  # Only the ephemeral local registry receives this build.
          tags: {% raw %}${{ steps.tags.outputs.scan_tag }}{% endraw %}
          cache-from: type=gha
          cache-to: type=gha,mode=max
          provenance: true
          sbom: true

      - name: Run Trivy scan
        uses: aquasecurity/trivy-action@b2933f565dbc598b29947660e66259e3c7bc8561 # 0.20.0
        env:
          # This Docker action shares the service network, not the runner's localhost.
          TRIVY_IMAGE_SRC: remote
          TRIVY_INSECURE: 'true'  # The ephemeral registry uses HTTP; GHCR still uses TLS.
        with:
          image-ref: registry:5000/{% raw %}${{ steps.tags.outputs.scan_repository }}@${{ steps.build.outputs.digest }}{% endraw %}
          format: 'sarif'
          output: 'trivy-results.sarif'
          severity: 'CRITICAL,HIGH'
          exit-code: '1'  # Fail if vulnerabilities found

      - name: Upload scan results
        uses: actions/upload-artifact@b7c566a772e6b6bfb58ed0dc250532a479d7789f # v6
        if: always()
        with:
          name: trivy-scan-{% raw %}${{ matrix.target.name }}{% endraw %}
          path: trivy-results.sarif
          retention-days: 90

      - name: Log in to GitHub Container Registry
        uses: docker/login-action@c94ce9fb468520275223c153574b00df6fe4bcc9 # v3
        with:
          registry: ghcr.io
          username: {% raw %}${{ github.actor }}{% endraw %}
          password: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}

      - name: Push scanned image
        env:
          SOURCE_IMAGE: localhost:5000/{% raw %}${{ steps.tags.outputs.scan_repository }}@${{ steps.build.outputs.digest }}{% endraw %}
          EXPECTED_DIGEST: {% raw %}${{ steps.build.outputs.digest }}{% endraw %}
          IMAGE_TAGS: {% raw %}${{ steps.tags.outputs.tags }}{% endraw %}
        run: |
          IFS=',' read -r -a image_tags <<< "$IMAGE_TAGS"
          tag_args=()
          for tag in "${image_tags[@]}"; do
            tag_args+=(--tag "$tag")
          done
          # Copy the scanned image/index and attestations without rebuilding it.
          docker buildx imagetools create --prefer-index=false "${tag_args[@]}" "$SOURCE_IMAGE"
          for tag in "${image_tags[@]}"; do
            actual_digest=$(docker buildx imagetools inspect "$tag" --format '{% raw %}{{.Manifest.Digest}}{% endraw %}')
            if [ "$actual_digest" != "$EXPECTED_DIGEST" ]; then
              echo "::error::Published digest mismatch for $tag: $actual_digest != $EXPECTED_DIGEST"
              exit 1
            fi
          done
{%- endif %}

  # Optional: Publish to Docker Hub
  # Uncomment and configure secrets.DOCKERHUB_USERNAME and secrets.DOCKERHUB_TOKEN
  # publish-dockerhub:
  #   name: Publish to Docker Hub
  #   runs-on: ubuntu-latest
  #   if: false  # Set to true to enable
  #   strategy:
  #     matrix:
  #       target:
  # {%- if api_module == "enabled" and "python" in api_languages %}
  #         - { name: python, dockerfile_target: runtime-python, image: api-python }
  # {%- endif %}
  # {%- if api_module == "enabled" and "node" in api_languages %}
  #         - { name: node, dockerfile_target: runtime-node, image: api-node }
  # {%- endif %}
  #   steps:
  #     - name: Checkout code
  #       uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10 # v6
  #
  #     - name: Set up Docker Buildx
  #       uses: docker/setup-buildx-action@8d2750c68a42422c14e847fe6c8ac0403b4cbd6f # v3
  #
  #     - name: Log in to Docker Hub
  #       uses: docker/login-action@c94ce9fb468520275223c153574b00df6fe4bcc9 # v3
  #       with:
  #         username: {% raw %}${{ secrets.DOCKERHUB_USERNAME }}{% endraw %}
  #         password: {% raw %}${{ secrets.DOCKERHUB_TOKEN }}{% endraw %}
  #
  #     - name: Build and push
  #       uses: docker/build-push-action@ca052bb54ab0790a636c9b5f226502c73d547a25 # v5
  #       with:
  #         context: .
  #         file: .docker/Dockerfile
  #         target: {% raw %}${{ matrix.target.dockerfile_target }}{% endraw %}
  #         push: true
  #         tags: {% raw %}${{ secrets.DOCKERHUB_USERNAME }}/${{ matrix.target.image }}{% endraw %}:latest
  #         cache-from: type=gha
  #         cache-to: type=gha,mode=max

  summary:
    name: Publish Summary
    runs-on: ubuntu-latest
{%- if api_module == "enabled" and (("python" in api_languages) or ("node" in api_languages)) %}
    needs: [publish-ghcr]
{%- endif %}
    if: always()
    steps:
      - name: Publish summary
{%- if api_module == "enabled" and (("python" in api_languages) or ("node" in api_languages)) %}
        env:
          PUBLISH_RESULT: {% raw %}${{ needs.publish-ghcr.result }}{% endraw %}
{%- endif %}
        run: |
          {
            echo "## Container Publish Summary"
            echo ""
{%- if api_module == "enabled" and (("python" in api_languages) or ("node" in api_languages)) %}
            if [ "$PUBLISH_RESULT" = "success" ]; then
              echo "✓ Images scanned and published to ghcr.io with matching digests"
              echo "✓ Tag pushes use semver; main uses latest + sha"
              echo "✓ SBOM and provenance preserved"
            else
              echo "Container publishing result: $PUBLISH_RESULT"
            fi
{%- else %}
            echo "No Python or Node API images are configured for publishing."
{%- endif %}
          } >> "$GITHUB_STEP_SUMMARY"
