{% if ci_platform == 'github-actions' %}
name: Dependency Updates

on:
  schedule:
    # Run weekly on Monday at 9 AM UTC
    - cron: '0 9 * * 1'
  workflow_dispatch:  # Allow manual triggering

permissions:
  contents: read

env:
  PACKAGE_NAME: {{ package_name }}

jobs:
  {% if (cli_module == 'enabled' and 'python' in cli_languages) or (api_module == 'enabled' and 'python' in api_languages) or (mcp_module == 'enabled' and 'python' in mcp_languages) or (docs_module == 'enabled' and docs_framework == 'sphinx-shibuya') %}
  update-python-deps:
    name: Update Python Dependencies
    runs-on: ubuntu-latest
    timeout-minutes: 15
    permissions:
      contents: write
      pull-requests: write

    steps:
      - name: Checkout repository
        uses: actions/checkout@v6
        with:
          token: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}

      - name: Set up Python
        uses: actions/setup-python@v6
        with:
          python-version: '3.11'

      - name: Set up uv
        uses: astral-sh/setup-uv@v6
        with:
          version: "latest"
          enable-cache: true
          cache-dependency-glob: "**/uv.lock"

      - name: Update Python dependencies
        run: uv --directory python lock --upgrade

      - name: Test with updated dependencies
        run: |
          uv --directory python sync
          QUALITY_PROFILE={{ quality_profile }} uv --directory python run task quality

      - name: Create pull request
        uses: peter-evans/create-pull-request@v6
        with:
          token: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}
          commit-message: "chore(deps): update Python dependencies"
          title: "chore(deps): Update Python dependencies"
          body: |
            Automated dependency update generated by scheduled workflow.

            ## Changes
            - Updated `python/uv.lock` with latest compatible versions

            ## Validation
            - ✅ Quality checks passed with updated dependencies
            - ✅ All tests passed

            ## Review Checklist
            - [ ] Review changelog for breaking changes
            - [ ] Test locally with updated dependencies
            - [ ] Merge if all checks pass
          branch: automated/deps-update-python
          delete-branch: true
          labels: dependencies,automated
  {% endif %}

  {% if api_module == 'enabled' and 'node' in api_languages %}
  update-node-deps:
    name: Update Node.js Dependencies
    runs-on: ubuntu-latest
    timeout-minutes: 15
    permissions:
      contents: write
      pull-requests: write

    steps:
      - name: Checkout repository
        uses: actions/checkout@v6
        with:
          token: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}

      - name: Set up Node.js
        uses: actions/setup-node@v6
        with:
          node-version: '22'

      - name: Enable corepack
        run: corepack enable

      - name: Update Node.js dependencies
        run: |
          pnpm update --latest
          pnpm install --frozen-lockfile

      - name: Test with updated dependencies
        run: |
          pnpm --filter api-node run lint
          pnpm --filter api-node run typecheck
          pnpm --filter api-node test

      - name: Create pull request
        uses: peter-evans/create-pull-request@v6
        with:
          token: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}
          commit-message: "chore(deps): update Node.js dependencies"
          title: "chore(deps): Update Node.js dependencies"
          body: |
            Automated dependency update generated by scheduled workflow.

            ## Changes
            - Updated `pnpm-lock.yaml` with latest compatible versions

            ## Validation
            - ✅ api-node lint passed
            - ✅ api-node typecheck passed
            - ✅ api-node tests passed

            ## Review Checklist
            - [ ] Review changelog for breaking changes
            - [ ] Test locally with updated dependencies
            - [ ] Merge if all checks pass
          branch: automated/deps-update-node
          delete-branch: true
          labels: dependencies,automated
  {% endif %}
  {% if not ((cli_module == 'enabled' and 'python' in cli_languages) or (api_module == 'enabled' and 'python' in api_languages) or (mcp_module == 'enabled' and 'python' in mcp_languages) or (docs_module == 'enabled' and docs_framework == 'sphinx-shibuya') or (api_module == 'enabled' and 'node' in api_languages)) %}
  scaffold-ok:
    name: No dependency jobs
    runs-on: ubuntu-latest
    steps:
      - name: No Python or Node dependency tracks
        run: echo "riso-deps-update has no language jobs for this dest."
  {% endif %}
{% endif %}
