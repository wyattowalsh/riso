"""HTTP fetch tool - web content retrieval.

Demonstrates async tools with external dependencies.
"""

from __future__ import annotations

import ipaddress
import socket
from typing import TYPE_CHECKING, Any
from urllib.parse import urlparse

if TYPE_CHECKING:
    from fastmcp import FastMCP


def _validate_fetch_url(url: str, *, allow_http: bool = False) -> str:
    """SSRF guard: HTTPS preferred; block private/link-local/metadata targets."""
    parsed = urlparse(url)
    if parsed.scheme not in {"https", "http"}:
        msg = "URL must use http or https"
        raise ValueError(msg)
    if parsed.scheme == "http" and not allow_http:
        msg = "HTTP URLs are blocked; use HTTPS or set MCP_HTTP_ALLOW_INSECURE=1"
        raise ValueError(msg)
    if not parsed.hostname:
        msg = "URL must include a hostname"
        raise ValueError(msg)

    host = parsed.hostname.lower()
    blocked_names = {
        "localhost",
        "metadata.google.internal",
        "metadata",
    }
    if host in blocked_names or host.endswith(".localhost"):
        raise ValueError(f"Blocked host: {host}")

    try:
        addr_infos = socket.getaddrinfo(host, None)
    except socket.gaierror as exc:
        raise ValueError(f"Could not resolve host: {host}") from exc

    for info in addr_infos:
        ip = ipaddress.ip_address(info[4][0])
        if (
            ip.is_private
            or ip.is_loopback
            or ip.is_link_local
            or ip.is_reserved
            or ip.is_multicast
        ):
            raise ValueError(f"Blocked private or reserved address: {ip}")

    return url


def register_http_tools(mcp: FastMCP) -> None:
    """Register HTTP tools with the MCP server.

    Parameters
    ----------
    mcp
        FastMCP server instance
    """

    @mcp.tool()
    async def http_get(
        url: str,
        headers: dict[str, str] | None = None,
        timeout: int = 30,
    ) -> dict[str, Any]:
        """Fetch content from a URL via HTTP GET.

        Makes an HTTP GET request and returns the response.

        Parameters
        ----------
        url
            The URL to fetch
        headers
            Optional request headers
        timeout
            Request timeout in seconds

        Returns
        -------
        dict
            Response with status, headers, and content
        """
        import os

        import httpx

        allow_http = os.environ.get("MCP_HTTP_ALLOW_INSECURE", "").lower() in {
            "1",
            "true",
            "yes",
        }
        try:
            safe_url = _validate_fetch_url(url, allow_http=allow_http)
        except ValueError as exc:
            return {"success": False, "error": str(exc)}

        try:
            async with httpx.AsyncClient(
                timeout=timeout, follow_redirects=False
            ) as client:
                response = await client.get(safe_url, headers=headers)

                return {
                    "success": True,
                    "status_code": response.status_code,
                    "headers": dict(response.headers),
                    "content_type": response.headers.get("content-type", ""),
                    "content": response.text[:10000],  # Limit content size
                    "content_length": len(response.content),
                }
        except httpx.TimeoutException:
            return {
                "success": False,
                "error": "Request timed out",
                "timeout": timeout,
            }
        except httpx.RequestError as e:
            return {
                "success": False,
                "error": str(e),
            }

    @mcp.tool()
    async def http_post(
        url: str,
        data: dict[str, Any] | None = None,
        json_body: dict[str, Any] | None = None,
        headers: dict[str, str] | None = None,
        timeout: int = 30,
    ) -> dict[str, Any]:
        """Send data to a URL via HTTP POST.

        Makes an HTTP POST request with optional JSON or form data.

        Parameters
        ----------
        url
            The URL to post to
        data
            Form data to send
        json_body
            JSON body to send (takes precedence over data)
        headers
            Optional request headers
        timeout
            Request timeout in seconds

        Returns
        -------
        dict
            Response with status and content
        """
        import os

        import httpx

        allow_http = os.environ.get("MCP_HTTP_ALLOW_INSECURE", "").lower() in {
            "1",
            "true",
            "yes",
        }
        try:
            safe_url = _validate_fetch_url(url, allow_http=allow_http)
        except ValueError as exc:
            return {"success": False, "error": str(exc)}

        try:
            async with httpx.AsyncClient(timeout=timeout, follow_redirects=False) as client:
                if json_body:
                    response = await client.post(safe_url, json=json_body, headers=headers)
                else:
                    response = await client.post(safe_url, data=data, headers=headers)

                return {
                    "success": True,
                    "status_code": response.status_code,
                    "headers": dict(response.headers),
                    "content": response.text[:10000],
                }
        except httpx.TimeoutException:
            return {
                "success": False,
                "error": "Request timed out",
            }
        except httpx.RequestError as e:
            return {
                "success": False,
                "error": str(e),
            }

    @mcp.tool()
    async def http_head(
        url: str,
        headers: dict[str, str] | None = None,
        timeout: int = 30,
    ) -> dict[str, Any]:
        """Get headers from a URL without downloading content.

        Makes an HTTP HEAD request to check resource metadata.

        Parameters
        ----------
        url
            The URL to check
        headers
            Optional request headers
        timeout
            Request timeout in seconds

        Returns
        -------
        dict
            Response headers and status
        """
        import os

        import httpx

        allow_http = os.environ.get("MCP_HTTP_ALLOW_INSECURE", "").lower() in {
            "1",
            "true",
            "yes",
        }
        try:
            safe_url = _validate_fetch_url(url, allow_http=allow_http)
        except ValueError as exc:
            return {"success": False, "error": str(exc)}

        try:
            async with httpx.AsyncClient(timeout=timeout, follow_redirects=False) as client:
                response = await client.head(safe_url, headers=headers)

                return {
                    "success": True,
                    "status_code": response.status_code,
                    "headers": dict(response.headers),
                    "content_type": response.headers.get("content-type", ""),
                    "content_length": response.headers.get("content-length", "unknown"),
                }
        except httpx.RequestError as e:
            return {
                "success": False,
                "error": str(e),
            }
