target-version = "py311"
line-length = 100
respect-gitignore = true
src = ["src", "tests"]
exclude = [".venv", "build", "dist", "node_modules"]

[format]
quote-style = "double"
indent-style = "space"

[lint]
select = [
  "E",
  "F",
  "I",
  "W",
  "B",
  "C4",
  "UP",
  "SIM",
]
ignore = ["E203", "E266", "E501"]

[lint.per-file-ignores]
"tests/**/*" = ["S101", "PT003", "B018"]
{%- if cli_module == 'enabled' and 'python' in cli_languages %}
"src/{{ package_name }}/cli/core/base.py" = ["B009", "B010"]
{%- endif %}
