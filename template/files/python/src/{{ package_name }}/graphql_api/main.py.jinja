{% if (graphql_api_module == 'enabled' or 'graphql' in api_features) -%}
"""FastAPI Integration for GraphQL API."""

import os

from fastapi import FastAPI
from strawberry.fastapi import GraphQLRouter

from {{ package_name }}.graphql_api.context import get_router_context
from {{ package_name }}.graphql_api.schema import schema

_production = os.environ.get("ENV", os.environ.get("ENVIRONMENT", "development")).lower() in {
    "prod",
    "production",
}

# Create FastAPI app for GraphQL
app = FastAPI(
    title="{{ project_name }} GraphQL API",
    description="GraphQL API built with Strawberry and FastAPI",
    version="1.0.0",
    docs_url=None if _production else "/docs",
    redoc_url=None if _production else "/redoc",
    openapi_url=None if _production else "/openapi.json",
)


# Create GraphQL router with Strawberry
# GraphiQL is development-only; never enable the playground in production.
_graphiql = os.environ.get("GRAPHIQL", "").lower() in {"1", "true", "yes"} and not _production
graphql_app = GraphQLRouter(
    schema=schema,
    context_getter=get_router_context,
    graphql_ide="graphiql" if _graphiql else None,
)


# Mount GraphQL router
app.include_router(graphql_app, prefix="/graphql")


@app.get("/health")
async def health_check():
    """Health check endpoint."""
    return {"status": "healthy", "service": "graphql-api"}


@app.get("/")
async def root():
    """Root endpoint with API information."""
    return {
        "service": "{{ project_name }} GraphQL API",
        "version": "1.0.0",
        "endpoints": {
            "graphql": "/graphql",
            "playground": "/graphql (in browser)",
            "health": "/health",
        },
    }


if __name__ == "__main__":
    import uvicorn

    uvicorn.run(
        "{{ package_name }}.graphql_api.main:app",
        host="127.0.0.1",
        port=8000,
        reload=True,
    )
{% endif -%}
