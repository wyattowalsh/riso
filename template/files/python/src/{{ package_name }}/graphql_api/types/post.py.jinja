{% if (graphql_api_module == 'enabled' or 'graphql' in api_features) -%}
"""Post GraphQL Type - Domain entity for blog posts."""

from datetime import datetime

import strawberry

from {{ package_name }}.graphql_api.pagination import PageInfo


@strawberry.type
class Post:
    """
    Post type represents a blog post or content item.

    Demonstrates:
    - Simple scalar fields (id, title, body)
    - DateTime custom scalar
    - Foreign key relationship (author_id)
    """

    id: strawberry.ID
    author_id: strawberry.ID
    title: str
    body: str | None = None
    created_at: datetime | None = None


@strawberry.type
class PostEdge:
    """Edge type for Post in connection pattern."""

    cursor: str
    node: Post


@strawberry.type
class PostConnection:
    """
    Connection type for paginated Post queries.

    Used for user.posts field and any other paginated post lists.
    """

    edges: list[PostEdge]
    page_info: PageInfo
    total_count: int
{% endif %}
