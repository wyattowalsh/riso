"""User GraphQL Type - Domain entity for users."""

from datetime import UTC, datetime

import strawberry

from {{ package_name }}.graphql_api.pagination import PageInfo, create_connection
from {{ package_name }}.graphql_api.types.post import Post, PostConnection, PostEdge


@strawberry.type
class User:
    """
    User type represents a user in the system.

    This demonstrates GraphQL's flexible field selection - clients can
    request exactly the fields they need, avoiding over-fetching.
    """

    id: strawberry.ID
    name: str
    email: str
    avatar: str | None = None

    @strawberry.field
    async def posts(
        self,
        info: strawberry.Info,
        first: int | None = 20,
        after: str | None = None,
    ) -> PostConnection:
        """
        Fetch user's posts with cursor-based pagination.

        This field demonstrates:
        - Nested queries (user -> posts)
        - Lazy loading (posts only fetched if requested)
        - Pagination support
        - DataLoader optimization (when implemented)

        Args:
            info: GraphQL context
            first: Number of posts to fetch
            after: Cursor for pagination

        Returns:
            PostConnection with edges and pageInfo
        """
        # This is a placeholder implementation
        # In a real app, this would query the database via DataLoader

        # Mock data for demonstration
        mock_posts = [
            Post(
                id=strawberry.ID(f"post-{i}"),
                author_id=self.id,
                title=f"Post {i} by {self.name}",
                body=f"Content of post {i}",
                created_at=datetime.now(UTC),
            )
            for i in range(1, 6)
        ]

        connection = create_connection(
            mock_posts, first=first, after=after, get_cursor=lambda post: f"cursor-{post.id}"
        )

        return PostConnection(
            edges=[PostEdge(cursor=edge.cursor, node=edge.node) for edge in connection.edges],
            page_info=connection.page_info,
            total_count=len(mock_posts),
        )


@strawberry.input
class CreateUserInput:
    """Input type for creating a new user."""

    name: str
    email: str
    avatar: str | None = None


@strawberry.input
class UpdateUserInput:
    """Input type for updating an existing user."""

    name: str | None = None
    email: str | None = None
    avatar: str | None = strawberry.UNSET


@strawberry.type
class UserEdge:
    """Edge type for User in connection pattern."""

    cursor: str
    node: User


@strawberry.type
class UserConnection:
    """
    Connection type for paginated User queries.

    Follows Relay Cursor Connections specification for consistent
    pagination across all list queries.
    """

    edges: list[UserEdge]
    page_info: PageInfo
    total_count: int
