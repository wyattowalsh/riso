"""Query Complexity Analysis - Prevent expensive queries."""

from graphql.language import ast
from graphql.validation import ValidationContext, ValidationRule

from graphql import GraphQLError


class QueryLimitsValidator(ValidationRule):
    """Validate the depth and estimated execution cost of each operation."""

    def __init__(
        self,
        validation_context: ValidationContext,
        max_depth: int = 15,
        max_complexity: int = 5000,
    ) -> None:
        super().__init__(validation_context)
        self.max_depth = max_depth
        self.max_complexity = max_complexity

    def enter_operation_definition(self, node: ast.OperationDefinitionNode, *_) -> None:
        """Walk field selections, including repeated named fragments, under a budget."""
        pending: list[tuple[ast.SelectionNode, int, int, frozenset[str]]] = [
            (selection, 1, 1, frozenset())
            for selection in reversed(node.selection_set.selections)
        ]
        complexity = 0
        while pending:
            selection, depth, weight, fragments = pending.pop()
            if isinstance(selection, ast.FieldNode):
                if depth > self.max_depth:
                    self.report_error(
                        GraphQLError(
                            f"Query depth {depth} exceeds maximum {self.max_depth}.",
                            nodes=selection,
                        )
                    )
                    return

                weight *= _list_multiplier(selection)
                complexity += weight
                if complexity > self.max_complexity:
                    self.report_error(
                        GraphQLError(
                            f"Query complexity {complexity} exceeds maximum {self.max_complexity}.",
                            nodes=selection,
                        )
                    )
                    return

                depth += 1
                children = selection.selection_set
            elif isinstance(selection, ast.InlineFragmentNode):
                children = selection.selection_set
            elif isinstance(selection, ast.FragmentSpreadNode):
                name = selection.name.value
                fragment = self.context.get_fragment(name)
                if fragment is None or name in fragments:
                    # GraphQL's standard rules report undefined and cyclic fragments.
                    continue
                fragments = fragments | {name}
                children = fragment.selection_set
            else:
                continue

            if children is not None:
                pending.extend(
                    (child, depth, weight, fragments)
                    for child in reversed(children.selections)
                )


def _list_multiplier(field: ast.FieldNode) -> int:
    """Apply the largest possible page size when a bound comes from a variable."""
    multiplier = 1
    for argument in field.arguments or ():
        if argument.name.value not in {"first", "limit"}:
            continue
        if isinstance(argument.value, ast.IntValueNode):
            value = argument.value.value
            if not value.startswith("-"):
                multiplier *= 100 if len(value) > 3 else max(1, min(int(value), 100))
        elif isinstance(argument.value, ast.VariableNode):
            multiplier *= 100
    return multiplier


def calculate_query_complexity(query: str, max_complexity: int = 5000) -> int:
    """
    Calculate complexity score for a query string.

    This is useful for logging and monitoring query patterns.

    Args:
        query: GraphQL query string
        max_complexity: Maximum allowed complexity

    Returns:
        Complexity score

    Raises:
        GraphQLError: If query exceeds max complexity
    """
    # This is a simplified implementation
    # In production, use graphql-core's validation with QueryLimitsValidator

    # Count fields (rough approximation)
    field_count = query.count("\n")

    # Count list multipliers
    import re
    first_values = re.findall(r'first:\s*(\d+)', query)
    limit_values = re.findall(r'limit:\s*(\d+)', query)

    multiplier = 1
    for value in first_values + limit_values:
        multiplier *= min(int(value), 100)

    complexity = field_count * multiplier

    if complexity > max_complexity:
        raise GraphQLError(
            f"Query complexity {complexity} exceeds maximum {max_complexity}"
        )

    return complexity


def calculate_query_depth(query: str, max_depth: int = 15) -> int:
    """
    Calculate nesting depth for a query string.

    Args:
        query: GraphQL query string
        max_depth: Maximum allowed depth

    Returns:
        Query depth

    Raises:
        GraphQLError: If query exceeds max depth
    """
    # Simplified implementation - count max brace nesting
    max_level = 0
    current_level = 0

    for char in query:
        if char == "{":
            current_level += 1
            max_level = max(max_level, current_level)
        elif char == "}":
            current_level -= 1

    if max_level > max_depth:
        raise GraphQLError(
            f"Query depth {max_level} exceeds maximum {max_depth}"
        )

    return max_level
