"""Pagination Types and Utilities - Cursor and offset-based pagination."""

import base64
import json
from collections.abc import Callable
from typing import Generic, TypeVar

import strawberry

from {{ package_name }}.graphql_api.errors import ValidationError


@strawberry.type
class PageInfo:
    """
    PageInfo provides pagination metadata.

    Follows Relay Cursor Connections specification for consistent
    pagination across all connection types.
    """

    has_next_page: bool
    has_previous_page: bool
    start_cursor: str | None = None
    end_cursor: str | None = None


T = TypeVar("T")


@strawberry.type
class Edge(Generic[T]):
    """
    Generic Edge type for connection pattern.

    Wraps a node with a cursor for pagination.
    """

    cursor: str
    node: T


@strawberry.type
class Connection(Generic[T]):
    """
    Generic Connection type for paginated queries.

    Provides:
    - edges: List of Edge wrappers with cursors
    - page_info: Pagination metadata
    - total_count: Total number of items (optional)
    """

    edges: list[Edge[T]]
    page_info: PageInfo
    total_count: int | None = None


def encode_cursor(value: str) -> str:
    """
    Encode a value as a base64 cursor.

    Args:
        value: Value to encode (typically an ID or composite key)

    Returns:
        Base64-encoded cursor string
    """
    cursor_dict = {"value": value}
    cursor_json = json.dumps(cursor_dict)
    return base64.b64encode(cursor_json.encode()).decode()


def decode_cursor(cursor: str) -> str:
    """
    Decode a base64 cursor to its original value.

    Args:
        cursor: Base64-encoded cursor string

    Returns:
        Decoded value

    Raises:
        ValueError: If cursor is invalid
    """
    try:
        cursor_dict = json.loads(base64.b64decode(cursor, validate=True))
        value = cursor_dict["value"]
        if not isinstance(value, str):
            raise TypeError("Cursor value must be a string")
    except (KeyError, TypeError, ValueError) as e:
        raise ValueError("Invalid pagination cursor") from e
    return value


def _id_cursor(item: object) -> str:
    """Encode the node's ID as the default cursor."""
    return encode_cursor(str(getattr(item, "id", "")))


def create_connection(
    items: list[T],
    first: int | None = None,
    after: str | None = None,
    get_cursor: Callable[[T], str] | None = None,
) -> Connection[T]:
    """
    Create a Connection from a list of items.

    Args:
        items: List of items to paginate
        first: Number of items to return
        after: Cursor to start from
        get_cursor: Function to generate cursor from item (defaults to using id)

    Returns:
        Connection with edges and pageInfo

    Raises:
        ValidationError: If first is negative or the default cursor is invalid
    """
    if first is not None and first < 0:
        raise ValidationError("first must be non-negative", field="first")

    cursor_for = _id_cursor if get_cursor is None else get_cursor
    start_index = 0
    if after is not None:
        after_cursor = after
        if get_cursor is None:
            try:
                after_cursor = encode_cursor(decode_cursor(after))
            except ValueError as e:
                raise ValidationError(str(e), field="after") from e
        for index, item in enumerate(items):
            if cursor_for(item) == after_cursor:
                start_index = index + 1
                break

    total_count = len(items)
    end_index = total_count if first is None else start_index + first
    edges = [
        Edge(cursor=cursor_for(item), node=item)
        for item in items[start_index:end_index]
    ]

    page_info = PageInfo(
        has_next_page=end_index < total_count,
        has_previous_page=start_index > 0,
        start_cursor=edges[0].cursor if edges else None,
        end_cursor=edges[-1].cursor if edges else None,
    )

    return Connection(
        edges=edges,
        page_info=page_info,
        total_count=total_count,
    )


class OffsetPagination:
    """
    Offset-based pagination helper.

    Simpler than cursor-based pagination but less robust for
    real-time data changes.
    """

    @staticmethod
    def paginate(
        items: list[T],
        offset: int = 0,
        limit: int = 20,
        max_limit: int = 100,
    ) -> tuple[list[T], int]:
        """
        Apply offset-based pagination to a list.

        Args:
            items: List of items to paginate
            offset: Number of items to skip
            limit: Number of items to return
            max_limit: Maximum allowed limit

        Returns:
            Tuple of (paginated_items, total_count)

        Raises:
            ValidationError: If the caller supplies a negative offset or limit
            ValueError: If the configured maximum limit is negative
        """
        for field, value in (("offset", offset), ("limit", limit)):
            if value < 0:
                raise ValidationError(f"{field} must be non-negative", field=field)
        if max_limit < 0:
            raise ValueError("max_limit must be non-negative")
        limit = min(limit, max_limit)
        total_count = len(items)
        paginated_items = items[offset : offset + limit]
        return paginated_items, total_count
