"""GraphQL Error Handling - Custom error classes and formatters."""

from typing import Any

from strawberry.extensions import MaskErrors

from graphql import GraphQLError as CoreGraphQLError


class GraphQLError(Exception):
    """Base class for all GraphQL errors."""

    code: str = "GRAPHQL_ERROR"

    def __init__(self, message: str, extensions: dict[str, Any] | None = None):
        super().__init__(message)
        self.message = message
        self.extensions = extensions or {}
        self.extensions["code"] = self.code


class ValidationError(GraphQLError):
    """
    Validation error for field-level validation failures.

    Examples:
        - Invalid email format
        - Required field missing
        - Field value out of range
        - Type mismatch
    """

    code: str = "VALIDATION_ERROR"

    def __init__(
        self,
        message: str,
        field: str | None = None,
        extensions: dict[str, Any] | None = None
    ):
        extensions = extensions or {}
        if field:
            extensions["field"] = field
        super().__init__(message, extensions)


class AuthError(GraphQLError):
    """
    Authentication/authorization error.

    Examples:
        - No authentication token provided
        - Invalid or expired token
        - Insufficient permissions for operation
        - User not found
    """

    code: str = "AUTH_ERROR"


class SystemError(GraphQLError):
    """
    System-level error (database, network, external services).

    Examples:
        - Database connection failure
        - Network timeout
        - External API error
        - Resource not available

    Note: In production, system errors should be sanitized
    to avoid leaking internal details.
    """

    code: str = "SYSTEM_ERROR"


class QueryError(GraphQLError):
    """
    Query validation error.

    Examples:
        - Query syntax error
        - Invalid field requested
        - Query depth exceeded
        - Query complexity exceeded
    """

    code: str = "QUERY_ERROR"


def format_graphql_error(error: Exception, debug: bool = False) -> dict[str, Any]:
    """
    Format GraphQL errors for response.

    In production (debug=False):
        - Sanitize system errors (no stack traces)
        - Include error codes and messages
        - Remove sensitive information

    With debug=True, include original messages and exception types.

    Args:
        error: Exception that occurred
        debug: Whether to include debug information

    Returns:
        Formatted error dictionary
    """
    if isinstance(error, GraphQLError) and (debug or not isinstance(error, SystemError)):
        formatted = {
            "message": error.message,
            "extensions": dict(error.extensions),
        }

        if debug:
            formatted["extensions"]["debug"] = {
                "exception_type": type(error).__name__,
            }

        return formatted if debug else sanitize_error_for_production(formatted)

    if debug:
        return {
            "message": str(error),
            "extensions": {
                "code": "UNKNOWN_ERROR",
                "exception_type": type(error).__name__,
            },
        }
    return {
        "message": "An internal error occurred",
        "extensions": {"code": SystemError.code},
    }


def sanitize_error_for_production(error: dict[str, Any]) -> dict[str, Any]:
    """
    Sanitize error for production by removing sensitive information.

    Removes:
        - Stack traces
        - Internal paths
        - Database queries
        - Environment variables
        - Other sensitive debug information

    Args:
        error: Error dictionary

    Returns:
        Sanitized error dictionary
    """
    sanitized = {
        "message": error.get("message", "An error occurred"),
        "extensions": {
            "code": error.get("extensions", {}).get("code", "UNKNOWN_ERROR"),
        },
    }

    # Preserve field information for validation errors (helpful for clients)
    if error.get("extensions", {}).get("field"):
        sanitized["extensions"]["field"] = error["extensions"]["field"]

    return sanitized


class FormatExecutionErrors(MaskErrors):
    """Format resolver failures without hiding GraphQL document validation."""

    def __init__(self) -> None:
        """Use Strawberry's response hook for execution errors with a field path."""
        super().__init__(should_mask_error=lambda error: error.path is not None)

    def anonymise_error(self, error: CoreGraphQLError) -> CoreGraphQLError:
        """Return public details and keep GraphQL source and field coordinates."""
        formatted = format_graphql_error(error.original_error or error)
        return CoreGraphQLError(
            message=formatted["message"],
            nodes=error.nodes,
            source=error.source,
            positions=error.positions,
            path=error.path,
            extensions=formatted["extensions"],
        )
