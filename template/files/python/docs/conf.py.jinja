def apply_riso_matplotlib_style() -> Path | None:
    """Load docs/_static/mpl/riso.mplstyle when matplotlib is installed."""
    if not RISO_MPLSTYLE.is_file():
        return None
    try:
        import matplotlib.pyplot as plt
    except ImportError:
        return None
    plt.style.use(RISO_MPLSTYLE)
    return RISO_MPLSTYLE


def apply_riso_plotly_template(*, default: bool = True) -> Path | None:
    """Register the Riso Plotly template when plotly is installed."""
    if not RISO_PLOTLY_TEMPLATE.is_file():
        return None
    try:
        import json

        import plotly.graph_objects as go
        import plotly.io as pio
    except ImportError:
        return None
    payload = json.loads(RISO_PLOTLY_TEMPLATE.read_text(encoding="utf-8"))
    pio.templates["riso"] = go.layout.Template(payload)
    if default:
        pio.templates.default = "riso"
    return RISO_PLOTLY_TEMPLATE


apply_riso_matplotlib_style()
