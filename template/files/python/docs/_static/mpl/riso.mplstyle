# Riso generated-project matplotlib style (DESIGN.md).
# Accent #14b8a6, light paper #f8fafc, text #0b132b, dark surface #0f172a.
# Hex values must be quoted: unquoted # starts a comment in .mplstyle.
# matplotlib is not a default dependency. Load with:
#   plt.style.use(path_to_this_file)
# or apply_riso_matplotlib_style() in python/docs/conf.py.

figure.facecolor: "#f8fafc"
figure.edgecolor: none
figure.dpi: 120
figure.figsize: 6.4, 4.0
figure.titlesize: 14
figure.titleweight: 600
figure.autolayout: True

axes.facecolor: "#f8fafc"
axes.edgecolor: "#cbd5e1"
axes.linewidth: 0.8
axes.labelcolor: "#0b132b"
axes.labelsize: 11
axes.labelweight: 500
axes.titlesize: 13
axes.titleweight: 600
axes.titlecolor: "#0b132b"
axes.titlepad: 10
axes.prop_cycle: cycler('color', ['14b8a6', '0f172a', '0d9488', '334155', '2dd4bf', '64748b', '0f766e', '94a3b8'])
axes.grid: True
axes.axisbelow: True
axes.spines.top: False
axes.spines.right: False

grid.color: "#e2e8f0"
grid.linestyle: -
grid.linewidth: 0.6
grid.alpha: 0.9

xtick.color: "#334155"
ytick.color: "#334155"
xtick.labelsize: 10
ytick.labelsize: 10
xtick.direction: out
ytick.direction: out

legend.frameon: True
legend.facecolor: "#ffffff"
legend.edgecolor: "#cbd5e1"
legend.fontsize: 10
legend.title_fontsize: 11
legend.borderpad: 0.5
legend.framealpha: 1.0

lines.linewidth: 2.0
lines.markersize: 6
lines.solid_capstyle: round

patch.linewidth: 0.8
patch.edgecolor: "#0f172a"
patch.force_edgecolor: False

font.family: sans-serif
font.sans-serif: Inter, Helvetica Neue, Helvetica, Arial, DejaVu Sans, sans-serif
font.size: 11
text.color: "#0b132b"
mathtext.default: regular

savefig.facecolor: "#f8fafc"
savefig.edgecolor: none
savefig.dpi: 150
savefig.bbox: tight
savefig.transparent: False
savefig.pad_inches: 0.15

hist.bins: 24
scatter.edgecolors: none
errorbar.capsize: 3
