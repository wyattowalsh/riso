      "family": "Inter, ui-sans-serif, system-ui, sans-serif",
      "size": 13,
      "color": "#0b132b"
    },
    "paper_bgcolor": "#ffffff",
    "plot_bgcolor": "#f8fafc",
    "colorway": [
