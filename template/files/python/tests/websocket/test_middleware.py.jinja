class RecordingMiddleware(ConnectionMiddleware):
    """Record stage ordering and optionally fail a specific hook."""

    def __init__(self, name: str, events: list[str], fail_at: str | None = None) -> None:
        self.name = name
        self.events = events
        self.fail_at = fail_at
        self.started = asyncio.Event()

    async def on_connect(
        self, connection: WebSocketConnection, request: HTTPConnection
    ) -> dict[str, str]:
        """Observe the real handshake context and earlier admission metadata."""
        assert not connection.is_active()
        previous = connection.metadata.get("stage", "start")
        self.events.append(f"connect:{self.name}:{previous}")
        if self.fail_at == "admission" and request.headers.get("x-deny") == "yes":
            raise AuthenticationError()
        if self.fail_at == "cancel":
            self.started.set()
            await asyncio.Future()
        return {"stage": self.name, "ip_address": "203.0.113.1"}

    async def on_message(self, connection: WebSocketConnection, message: Message) -> Message:
        """Pass a transformed message to the next hook."""
        assert message.sender_id == connection.connection_id
        text = message.payload.get("text", "hello")
        self.events.append(f"message:{self.name}:{text}")
        if self.fail_at == "message":
            raise AuthorizationError()
        message.payload["text"] = f"{text}:{self.name}"
        return message

    async def on_error(self, connection: WebSocketConnection, error: Exception) -> None:
        """Record notification of the original rejection."""
        assert isinstance(error, WebSocketError)
        self.events.append(f"error:{self.name}:{error.code}")
        if self.fail_at == "error":
            raise RuntimeError("Error observer failed")

    async def on_disconnect(
        self, connection: WebSocketConnection, code: int, reason: str
    ) -> None:
        """Use a real async checkpoint during cleanup."""
        await asyncio.sleep(0)
        self.events.append(f"disconnect:{self.name}")
        if self.fail_at == "disconnect":
            raise RuntimeError("Cleanup observer failed")


@pytest.mark.asyncio
async def test_cancelled_admission_rolls_back_completed_hooks(
    isolated_manager: ConnectionManager,
) -> None:
    """Cancellation during admission leaves no accepted or registered socket."""
    events: list[str] = []
    blocked = RecordingMiddleware("blocked", events, "cancel")
    for middleware in (RecordingMiddleware("first", events), blocked, RecordingMiddleware("later", events)):
        isolated_manager.add_middleware(middleware)
    sent: list[ASGIMessage] = []

    async def receive() -> ASGIMessage:
        return {"type": "websocket.connect"}

    async def send(frame: ASGIMessage) -> None:
        sent.append(frame)

    socket = WebSocket({"type": "websocket", "headers": []}, receive, send)
    task = asyncio.create_task(isolated_manager.connect(socket))
    try:
        await asyncio.wait_for(blocked.started.wait(), timeout=2)
    finally:
        task.cancel()
        with pytest.raises(asyncio.CancelledError):
            await task

    assert not sent
    assert isolated_manager.get_connection_count() == 0
    assert events == ["connect:first:start", "connect:blocked:first", "disconnect:first"]


@pytest.mark.asyncio
async def test_failed_asgi_accept_rolls_back_successful_hooks(
    isolated_manager: ConnectionManager,
) -> None:
    """A partial accept closes its socket and preserves the transport error."""
    events: list[str] = []
    for name in ("first", "second"):
        isolated_manager.add_middleware(RecordingMiddleware(name, events))
    sent: list[str] = []

    async def receive() -> ASGIMessage:
        return {"type": "websocket.connect"}

    async def send(frame: ASGIMessage) -> None:
        sent.append(frame["type"])
        if frame["type"] == "websocket.accept":
            raise OSError("ASGI transport failed")

    socket = WebSocket({"type": "websocket", "headers": []}, receive, send)
    with pytest.raises(OSError, match="ASGI transport failed"):
        await isolated_manager.connect(socket)

    assert sent == ["websocket.accept", "websocket.close"]
    assert isolated_manager.get_connection_count() == 0
    assert events == ["connect:first:start", "connect:second:first", "disconnect:first", "disconnect:second"]


