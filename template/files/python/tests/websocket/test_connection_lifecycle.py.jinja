"""Tests for WebSocket connection lifecycle management."""

import asyncio
import sys
from types import SimpleNamespace

import pytest
from fastapi import WebSocket
from starlette.types import Message as ASGIMessage
from starlette.types import Scope

from {{ package_name }}.websocket import ConnectionManager, utils
from {{ package_name }}.websocket.middleware import MetricsMiddleware
from {{ package_name }}.websocket.models import ConnectionState


@pytest.mark.asyncio
async def test_connection_creation(manager):
    """Test creating a WebSocket connection."""
    # Connection should start in CONNECTING state
    # This is a unit test for the connection model
    from {{ package_name }}.websocket.models import WebSocketConnectionModel

    conn_model = WebSocketConnectionModel()
    assert conn_model.state == ConnectionState.CONNECTING
    assert conn_model.messages_sent == 0
    assert conn_model.messages_received == 0


@pytest.mark.asyncio
async def test_connection_state_transitions(manager):
    """Test connection state transitions."""
    from {{ package_name }}.websocket.models import WebSocketConnectionModel

    # Test valid state progression
    conn_model = WebSocketConnectionModel()

    # CONNECTING -> CONNECTED
    conn_model.state = ConnectionState.CONNECTED
    assert conn_model.state == ConnectionState.CONNECTED

    # CONNECTED -> CLOSING
    conn_model.state = ConnectionState.CLOSING
    assert conn_model.state == ConnectionState.CLOSING

    # CLOSING -> CLOSED
    conn_model.state = ConnectionState.CLOSED
    assert conn_model.state == ConnectionState.CLOSED


def test_manager_singleton(monkeypatch: pytest.MonkeyPatch) -> None:
    """Repeated access keeps the singleton's active configuration."""
    manager1 = ConnectionManager()
    config = manager1.config.model_copy()
    monkeypatch.setattr(manager1, "config", config)
    manager2 = ConnectionManager()

    assert manager1 is manager2
    assert manager2.config is config


@pytest.mark.asyncio
async def test_cancelled_close_unregisters_connection(
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    """ASGI cancellation releases the registry and connection capacity."""
    monkeypatch.setattr(ConnectionManager, "_instance", None)
    manager = ConnectionManager()
    monkeypatch.setattr(manager.config, "environment", "development")
    monkeypatch.setattr(manager.config, "enable_heartbeat", False)
    monkeypatch.setattr(manager.config, "enable_idle_timeout", False)
    monkeypatch.setattr(manager.config, "max_connections_per_ip", 1)

    async def receive() -> ASGIMessage:
        return {"type": "websocket.connect"}

    async def send(message: ASGIMessage) -> None:
        if message["type"] == "websocket.close":
            raise asyncio.CancelledError

    scope: Scope = {"type": "websocket", "headers": [], "client": ("127.0.0.1", 1234)}
    connection_id = await manager.connect(WebSocket(scope, receive, send), user_id="user")
    await manager.join_room(connection_id, "room")
    with pytest.raises(asyncio.CancelledError):
        await manager.disconnect(connection_id)

    assert manager.get_connection_count() == 0
    assert manager.get_connections_by_user("user") == []
    assert manager.get_connections_by_room("room") == []

    # The same IP can connect again despite the per-IP limit of one.
    new_id = await manager.connect(WebSocket(scope, receive, send), user_id="user")
    with pytest.raises(asyncio.CancelledError):
        await manager.disconnect(new_id)


