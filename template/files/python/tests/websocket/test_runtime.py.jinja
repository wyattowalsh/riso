def test_real_room_protocol_broadcasts_then_cleans_up(isolated_manager: ConnectionManager) -> None:
    """Two generated routes join, broadcast with exclusion, leave, and release the room."""
    isolated_manager.config.max_connections_per_ip = 2
    app = FastAPI()
    setup_websocket_routes(app)
    room = {"room_id": "chat"}
    with (
        TestClient(app) as client,
        client.websocket_connect("/ws") as first,
        client.websocket_connect("/ws") as second,
    ):
        first_id = first.receive_json()["payload"]["connection_id"]
        second_id = second.receive_json()["payload"]["connection_id"]
        first.send_json({"type": "room.join", "payload": room})
        assert first.receive_json()["payload"]["member_count"] == 1
        second.send_json({"type": "room.join", "payload": room})
        assert second.receive_json()["payload"]["member_count"] == 2
        assert first.receive_json()["payload"]["connection_id"] == second_id

        first.send_json({
            "type": "room.broadcast",
            "payload": {**room, "exclude_sender": True, "message": {"type": "message.text", "payload": {"text": "hello"}}},
        })
        assert second.receive_json()["sender_id"] == first_id
        first.send_json({"type": "room.leave", "payload": room})
        assert first.receive_json()["payload"]["member_count"] == 1
        second.send_json({"type": "room.leave", "payload": room})
        assert second.receive_json()["payload"]["member_count"] == 0
        second.send_json({"type": "room.broadcast", "payload": {**room, "message": {}}})
        assert second.receive_json()["payload"]["code"] == "ROOM_NOT_FOUND"

    assert isolated_manager.get_connection_count() == 0


def test_real_json_route_enforces_size_and_reports_retry_after(
    isolated_manager: ConnectionManager, monkeypatch: pytest.MonkeyPatch,
) -> None:
    """Invalid and oversized frames never reach the handler or consume its rate budget."""
    isolated_manager.config.max_message_size = 1024
    isolated_manager.config.rate_limit_messages = 1
    # A newly started app takes its rate window from its boot configuration.
    monkeypatch.setattr(ConnectionManager, "_instance", None)
    app = FastAPI()
    setup_websocket_routes(app)
    with TestClient(app) as client, client.websocket_connect("/ws") as websocket:
        websocket.receive_json()
        websocket.send_text("{broken json")
        assert websocket.receive_json()["payload"]["code"] == "INVALID_FORMAT"
        websocket.send_json({"type": "message.text", "payload": {"text": "é" * 513}})
        assert websocket.receive_json()["payload"]["code"] == "MESSAGE_TOO_LARGE"
        message = {"type": "message.text", "payload": {"text": "valid"}}
        websocket.send_json(message)
        assert websocket.receive_json()["payload"]["text"] == "Echo: valid"
        websocket.send_json(message)
        rejected = websocket.receive_json()["payload"]
        assert rejected["code"] == "RATE_LIMIT"
        assert rejected["retry_after"] > 0


def test_real_text_route_closes_oversized_frames(isolated_manager: ConnectionManager) -> None:
    """The raw text route sends 1009 for oversized UTF-8 input."""
    isolated_manager.config.max_message_size = 1024
    app = FastAPI()
    setup_websocket_routes(app)
    with TestClient(app) as client, client.websocket_connect("/ws/echo") as websocket:
        websocket.send_text("é" * 513)
        with pytest.raises(WebSocketDisconnect) as closed:
            websocket.receive_text()
        assert closed.value.code == 1009
    assert isolated_manager.get_connection_count() == 0


@pytest.mark.asyncio
async def test_real_pong_clears_only_the_matching_heartbeat_deadline(
    isolated_manager: ConnectionManager, monkeypatch: pytest.MonkeyPatch,
) -> None:
    """A matching pong keeps the route alive; a stale one cannot defer cleanup."""
    manager = isolated_manager
    manager.config.enable_heartbeat = True
    manager.config.heartbeat_interval = 1
    manager.config.heartbeat_timeout = 2
    clock = TickClock(monkeypatch)
    app = FastAPI()
    setup_websocket_routes(app)
    socket = SocketProbe()
    task = asyncio.create_task(app(socket.scope, socket.incoming.get, socket.send))
    try:
        assert (await socket.frame())["type"] == "websocket.accept"
        assert json.loads((await socket.frame())["text"])["type"] == "connection.connect"
        clock.steps.put_nowait(1)
        first_ping = json.loads((await socket.frame())["text"])
        assert first_ping["type"] == "heartbeat.ping"
        pong = {"type": "heartbeat.pong", "payload": {"ping_message_id": first_ping["message_id"]}}
        socket.send_json(pong)
        socket.send_json({"type": "message.text", "payload": {"text": "alive"}})
        assert json.loads((await socket.frame())["text"])["payload"]["text"] == "Echo: alive"

        clock.steps.put_nowait(1)
        second_ping = json.loads((await socket.frame())["text"])
        assert second_ping["message_id"] != first_ping["message_id"]
        socket.send_json(pong)
        socket.send_json({"type": "message.text", "payload": {"text": "stale"}})
        assert json.loads((await socket.frame())["text"])["payload"]["text"] == "Echo: stale"
        clock.steps.put_nowait(1)
        clock.steps.put_nowait(1)
        assert (await socket.frame())["reason"] == "Heartbeat timeout"
        assert manager.get_connection_count() == 0
    finally:
        socket.incoming.put_nowait({"type": "websocket.disconnect", "code": 1000})
        await asyncio.wait_for(task, timeout=2)
