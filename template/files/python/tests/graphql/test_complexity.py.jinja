@pytest.mark.asyncio
async def test_graphql_rejects_depth_hidden_in_named_fragments():
    """The operation limit applies after fragment expansion."""
    fragments = [
        f"fragment Nested{index} on __Type {{ ofType {{ ...Nested{index + 1} }} }}"
        for index in range(16)
    ]
    fragments.append("fragment Nested16 on __Type { kind }")
    result = await schema.execute('query { __type(name: "User") { ...Nested0 } } ' + " ".join(fragments))

    assert result.errors
    assert any("Query depth" in error.message for error in result.errors)


@pytest.mark.asyncio
async def test_graphql_bounds_variable_page_size_cost():
    """Child selections count once per potential item in a parameterized page."""
    aliases = " ".join(f"field{index}: edges {{ node {{ id }} }}" for index in range(20))
    query = (
        "query List($size: Int!) { users(first: $size) { ...Selections } } "
        f"fragment Selections on UserConnection {{ {aliases} }}"
    )
    result = await schema.execute(query, variable_values={"size": 100})

    assert result.errors
    assert any("Query complexity" in error.message for error in result.errors)


@pytest.mark.asyncio
async def test_graphql_rejects_cyclic_fragments():
    """The limits check must terminate while the normal validation rejects cycles."""
    result = await schema.execute(
        'query { user(id: "1") { ...Cycle } } fragment Cycle on User { ...Cycle }'
    )

    assert result.errors
    assert any("Cannot spread fragment" in error.message for error in result.errors)
