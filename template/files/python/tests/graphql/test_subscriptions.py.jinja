"""Exercise the generated subscription against the actual schema."""

import asyncio
from contextlib import aclosing

import pytest

from {{ package_name }}.graphql_api.schema import schema


@pytest.mark.asyncio
async def test_user_created_subscription_delivers_selected_fields():
    stream = await schema.subscribe("subscription { userCreated { id name } }")
    async with aclosing(stream):
        event = await asyncio.wait_for(anext(stream), timeout=5)

    assert event.errors is None
    assert event.data == {"userCreated": {"id": "new-user-id", "name": "New User"}}
