"""Test client-facing GraphQL errors without exposing internal failures."""

import pytest
from fastapi.testclient import TestClient

from {{ package_name }}.api.main import app as integrated_app
from {{ package_name }}.graphql_api.errors import (
    AuthError,
    SystemError,
    ValidationError,
)
from {{ package_name }}.graphql_api.main import app as standalone_app
from {{ package_name }}.graphql_api.queries import user_queries
from {{ package_name }}.graphql_api.schema import schema


class TestErrorHandling:
    """Test error handling and error messages."""

    def test_query_syntax_error(self):
        """Test that syntax errors return clear messages."""
        query = """
            query {
                user(id: "1") {
                    id
                    name
                }
        """

        result = schema.execute_sync(query)

        assert result.errors is not None

    def test_invalid_field_error(self):
        """Test that invalid field requests return clear errors."""
        query = """
            query {
                user(id: "1") {
                    id
                    invalidField
                }
            }
        """

        result = schema.execute_sync(query)

        assert result.errors is not None
        assert any("invalidField" in str(error) for error in result.errors)

    def test_validation_error_format(self):
        """Test ValidationError formatting."""
        error = ValidationError(
            message="Email format is invalid",
            field="email",
        )

        assert error.message == "Email format is invalid"
        assert error.extensions["field"] == "email"
        assert error.code == "VALIDATION_ERROR"

    def test_auth_error_format(self):
        """Test AuthError formatting."""
        error = AuthError(
            message="Authentication required",
        )

        assert error.message == "Authentication required"
        assert error.code == "AUTH_ERROR"

    def test_system_error_format(self):
        """Test SystemError formatting."""
        error = SystemError(
            message="Database connection failed",
        )

        assert error.message == "Database connection failed"
        assert error.code == "SYSTEM_ERROR"


@pytest.mark.parametrize("app", [integrated_app, standalone_app], ids=["integrated", "standalone"])
@pytest.mark.parametrize("error_type", [RuntimeError, SystemError])
def test_graphql_internal_failures_are_redacted(app, error_type, monkeypatch):
    """Both routers preserve failure locations while keeping system details private."""
    def fail(*_args, **_kwargs):
        raise error_type("fixture internal database detail")

    monkeypatch.setattr(user_queries, "create_connection", fail)
    with TestClient(app) as client:
        response = client.post("/graphql", json={"query": "{ users { totalCount } }"})

    assert response.status_code == 200
    assert response.json() == {
        "data": None,
        "errors": [{
            "message": "An internal error occurred",
            "locations": [{"line": 1, "column": 3}],
            "path": ["users"],
            "extensions": {"code": "SYSTEM_ERROR"},
        }],
    }
