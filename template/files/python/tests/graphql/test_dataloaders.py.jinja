"""Test per-request batching and caching with the actual DataLoader."""

from datetime import timedelta

import pytest

from {{ package_name }}.graphql_api.dataloaders import DataLoaderContainer, UserDataLoader


@pytest.mark.asyncio
async def test_user_loader_batches_in_order_and_caches_per_context(monkeypatch):
    calls = []
    original = UserDataLoader.batch_load_users

    async def record_batch(loader, ids):
        calls.append(list(ids))
        return await original(loader, ids)

    monkeypatch.setattr(UserDataLoader, "batch_load_users", record_batch)
    first = DataLoaderContainer().user_loader
    users = await first.load_many(["2", "1", "2", "missing"])
    assert [str(user.id) if user else None for user in users] == ["2", "1", "2", None]
    assert calls == [["2", "1", "missing"]]

    another = DataLoaderContainer().user_loader
    assert (await another.load("2")).id == "2"
    assert calls == [["2", "1", "missing"], ["2"]]


@pytest.mark.asyncio
async def test_posts_loader_preserves_author_order_and_utc_dates():
    """Post batches retain empty author slots and serialize unambiguous timestamps."""
    loader = DataLoaderContainer().posts_by_author_loader
    batches = await loader.load_many(["2", "missing", "1", "2"])

    assert [[str(post.id) for post in posts] for posts in batches] == [
        ["p3"], [], ["p1", "p2"], ["p3"]
    ]
    assert all(
        post.created_at is not None and post.created_at.utcoffset() == timedelta(0)
        for posts in batches
        for post in posts
    )
