def test_prompt_validates_input_and_passes_password_option() -> None:
    """Provided values skip prompting and missing values honor prompt validation."""
    with patch.object(Prompt, "ask", side_effect=["blue", "not-a-number", "sample"]) as ask:
        assert prompt_if_missing("provided", "Name") == "provided"
        ask.assert_not_called()
        assert prompt_if_missing(None, "Color", validator=validate_choice(["blue"])) == "blue"
        with pytest.raises(ValidationError, match="Invalid value for Count"):
            prompt_if_missing(None, "Count", validator=validate_positive_int)
        assert prompt_if_missing(
            None, "Label", password=True, validator=validate_not_empty
        ) == "sample"
        ask.assert_called_with("Label", password=True, default=None)
    assert validate_positive_int("2")
    assert not validate_not_empty("  ")


class TestKeyboardInterrupt:
    """Tests for graceful keyboard interrupt handling."""

    def test_main_exits_130_on_keyboard_interrupt(self) -> None:
        """main() exits with code 130 on KeyboardInterrupt."""
        from {{ package_name }}.cli.__main__ import main

        with (
            patch.object(sys, "argv", ["{{ project_slug }}"]),
            patch(
                "{{ package_name }}.cli.__main__.app",
                side_effect=KeyboardInterrupt,
            ),
            pytest.raises(SystemExit) as exc_info,
        ):
            main()
        assert exc_info.value.code == 130
