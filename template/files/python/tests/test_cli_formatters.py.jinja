class TestYAMLFormatting:
    """Tests for YAML output formatting."""

    def test_format_yaml_with_dict(
        self, formatter: OutputFormatter, output_buffer: StringIO
    ) -> None:
        """Test YAML formatting with dictionary."""
        pytest.importorskip("yaml")
        data = {"name": "Alice", "active": True}

        formatter.format(data, format=OutputFormat.YAML)
        output = output_buffer.getvalue()

        assert "name:" in output
        assert "Alice" in output

    def test_format_yaml_rejects_unportable_python_objects(
        self, formatter: OutputFormatter, output_buffer: StringIO
    ) -> None:
        """Machine YAML does not encode Python-specific objects."""
        with pytest.raises(ValidationError, match="Cannot serialize data to YAML"):
            formatter.format({"item": object()}, format=OutputFormat.YAML)
        assert output_buffer.getvalue() == ""

    def test_format_yaml_reports_missing_dependency(
        self,
        formatter: OutputFormatter,
        output_buffer: StringIO,
        monkeypatch: pytest.MonkeyPatch,
    ) -> None:
        """An unavailable YAML writer is a formatting failure."""
        monkeypatch.setitem(sys.modules, "yaml", None)
        with pytest.raises(ValidationError, match="YAML support not available"):
            formatter.format({"item": "sample"}, format=OutputFormat.YAML)
        assert output_buffer.getvalue() == ""


