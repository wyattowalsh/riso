"""Tests for output formatting functionality."""

from __future__ import annotations

import json
import sys
from io import StringIO

import pytest
from rich.console import Console

from {{ package_name }}.cli.core import ValidationError
from {{ package_name }}.cli.core.formatter import OutputFormat, OutputFormatter


@pytest.fixture(name="output_buffer")
def _output_buffer() -> StringIO:
    """Capture the formatter's rendered output."""
    return StringIO()


@pytest.fixture
def formatter(output_buffer: StringIO) -> OutputFormatter:
    """Create a formatter that writes to the test buffer."""
    console = Console(
        file=output_buffer,
        force_terminal=False,
        no_color=True,
        highlight=False,
    )
    return OutputFormatter(console=console)


class TestTableFormatting:
    """Tests for table output formatting."""

    def test_format_table_with_list_of_dicts(
        self, formatter: OutputFormatter, output_buffer: StringIO
    ) -> None:
        """Test table formatting with list of dictionaries."""
        data = [
            {"name": "Alice", "age": 30},
            {"name": "Bob", "age": 25},
        ]

        formatter.format(data, format=OutputFormat.TABLE)
        output = output_buffer.getvalue()

        assert "Alice" in output
        assert "Bob" in output
        assert "30" in output
        assert "25" in output

    def test_format_table_with_single_dict(
        self, formatter: OutputFormatter, output_buffer: StringIO
    ) -> None:
        """Test table formatting with single dictionary."""
        data = {"name": "Alice", "age": 30}

        formatter.format(data, format=OutputFormat.TABLE)
        output = output_buffer.getvalue()

        assert "Alice" in output
        assert "30" in output

    def test_format_table_with_empty_data(
        self, formatter: OutputFormatter, output_buffer: StringIO
    ) -> None:
        """Test table formatting with empty data."""
        formatter.format([], format=OutputFormat.TABLE)
        output = output_buffer.getvalue()

        assert "no data" in output.lower()

    def test_format_table_with_title(
        self, formatter: OutputFormatter, output_buffer: StringIO
    ) -> None:
        """Test table formatting with custom title."""
        data = [{"name": "Alice"}]

        formatter.format(data, format=OutputFormat.TABLE, title="Users")
        output = output_buffer.getvalue()

        assert "Users" in output

    @pytest.mark.parametrize("data", ["item", ["item"]])
    def test_format_table_with_scalar_values(
        self, formatter: OutputFormatter, output_buffer: StringIO, data: str | list[str]
    ) -> None:
        """A scalar or list of scalars can be shown in an explicitly named column."""
        formatter.format(data, format=OutputFormat.TABLE, columns=["value"])
        output = output_buffer.getvalue()
        assert "Value" in output
        assert "item" in output


class TestJSONFormatting:
    """Tests for JSON output formatting."""

    def test_format_json_with_dict(
        self, formatter: OutputFormatter, output_buffer: StringIO
    ) -> None:
        """Test JSON formatting with dictionary."""
        data = {"name": "Alice", "age": 30}

        formatter.format(data, format=OutputFormat.JSON)
        output = output_buffer.getvalue()

        # Should be valid JSON
        parsed = json.loads(output.strip())
        assert parsed["name"] == "Alice"
        assert parsed["age"] == 30

    def test_format_json_with_list(
        self, formatter: OutputFormatter, output_buffer: StringIO
    ) -> None:
        """Test JSON formatting with list."""
        data = [{"name": "Alice"}, {"name": "Bob"}]

        formatter.format(data, format=OutputFormat.JSON)
        output = output_buffer.getvalue()

        parsed = json.loads(output.strip())
        assert len(parsed) == 2
        assert parsed[0]["name"] == "Alice"

    def test_format_json_with_indent(
        self, formatter: OutputFormatter, output_buffer: StringIO
    ) -> None:
        """Test JSON formatting with custom indent."""
        data = {"name": "Alice"}

        formatter.format(data, format=OutputFormat.JSON, indent=4)
        output = output_buffer.getvalue()

        # Should have indentation
        assert "    " in output

    def test_format_json_rejects_circular_data(
        self, formatter: OutputFormatter, output_buffer: StringIO
    ) -> None:
        """A circular object fails without emitting a partial JSON document."""
        items: list[object] = []
        items.append(items)
        with pytest.raises(ValidationError, match="Cannot serialize data to JSON"):
            formatter.format(items, format=OutputFormat.JSON)
        assert output_buffer.getvalue() == ""


class TestTextFormatting:
