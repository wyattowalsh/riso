def test_plugin_manager_refreshes_real_entry_points(monkeypatch: pytest.MonkeyPatch) -> None:
    """Module commands, declared commands, and cache refresh work together."""
    manager = PluginManager(entry_point_group="riso_cli_test_plugins")
    module_name = "riso_cli_test_plugin_module"
    module = ModuleType(module_name)

    @command()
    def probe_command() -> str:
        """Return a marker from the discovered command."""
        return "ready"

    declared = SimpleNamespace(commands=[probe_command])
    module.__dict__.update(
        probe=probe_command, _private=probe_command, declared=declared
    )
    monkeypatch.setitem(sys.modules, module_name, module)
    entries = [
        EntryPoint("module", module_name, manager.entry_point_group),
        EntryPoint("declared", f"{module_name}:declared", manager.entry_point_group),
    ]
    with patch(
        "{{ package_name }}.cli.core.plugin_manager.entry_points", return_value=entries
    ) as discover:
        assert [item["loaded"] for item in manager.list_plugins()] == [False, False]
        commands = manager.get_plugin_commands("module")
        assert commands == [probe_command]
        assert commands[0]() == "ready"
        assert manager.load_all_plugins() == {"module": module, "declared": declared}
        assert manager.get_plugin_commands("declared") == [probe_command]

        manager.clear_cache()
        assert not manager.is_loaded("module")
        assert manager.load_all_plugins() == {"module": module, "declared": declared}
        assert discover.call_count == 2
