def test_plugin_list_and_info_follow_loading_state(
    cli_runner: CliRunner, installed_plugins: PluginManager
) -> None:
    """Listing metadata stays lazy until the plugin is validated."""
    initial = cli_runner.invoke(app, ["plugin", "list"])
    details = cli_runner.invoke(app, ["plugin", "list", "--verbose"])
    info = cli_runner.invoke(app, ["plugin", "info", "demo"])
    assert initial.exit_code == details.exit_code == info.exit_code == 0
    assert "○ demo" in initial.stdout
    assert "Installed Plugins" in details.stdout
    assert "Loaded: No" in info.stdout
    assert not installed_plugins.is_loaded("demo")

    checked = cli_runner.invoke(app, ["plugin", "validate", "demo"])
    loaded_info = cli_runner.invoke(app, ["plugin", "info", "demo"])
    assert checked.exit_code == loaded_info.exit_code == 0
    assert "Loaded: Yes" in loaded_info.stdout
    assert "Commands: 1" in loaded_info.stdout
    assert "demo: Demonstration plugin command" in loaded_info.stdout
    assert installed_plugins.is_loaded("demo")
    assert not installed_plugins.is_loaded("broken")


def test_plugin_validation_reports_failures_and_keeps_working_plugins(
    cli_runner: CliRunner, installed_plugins: PluginManager
) -> None:
    """A broken entry point yields a failing summary and keeps other plugins usable."""
    result = cli_runner.invoke(app, ["plugin", "validate"])
    assert result.exit_code == 1
    assert "broken: Failed" in result.stdout
    assert "demo: Valid" in result.stdout
    assert "1/2 plugin(s) validated successfully" in result.stdout
    assert installed_plugins.is_loaded("demo")

    listed = cli_runner.invoke(app, ["plugin", "list"])
    assert listed.exit_code == 0
    assert "✓ demo" in listed.stdout and "○ broken" in listed.stdout


