_Result = TypeVar("_Result")


def _in_session(check: Callable[[Client], Awaitable[_Result]]) -> _Result:
    """Exercise the real MCP server in memory under a deadline."""

    async def run() -> _Result:
        async with asyncio.timeout(10), Client(mcp) as client:
            return await check(client)

    return asyncio.run(run())


def test_mcp_package_exports_server() -> None:
    """The project's package exposes the server, runner, and version."""
    assert isinstance(mcp, FastMCP)
    assert callable(run_server)
    assert __version__


@pytest.mark.parametrize(
    ("error", "payload"),
    [
        (MCPError("Unexpected failure"), {"code": -32603, "message": "Unexpected failure"}),
        (
            OperationError("fetch", "request refused"),
            {
                "code": -32001,
                "message": "fetch failed: request refused",
                "data": {"operation": "fetch", "details": "request refused"},
            },
        ),
        (
            ValidationError(["name is required"]),
            {
                "code": -32002,
                "message": "Validation failed with 1 error(s)",
                "data": {"errors": ["name is required"]},
            },
        ),
        (
            NotFoundError("Document", "doc-1"),
            {
                "code": -32003,
                "message": "Document not found: doc-1",
                "data": {"resource": "Document", "identifier": "doc-1"},
            },
        ),
    ],
)
def test_mcp_error_payloads(error: MCPError, payload: dict[str, object]) -> None:
    """The generated error helpers expose stable codes and structured details."""
    assert str(error) == payload["message"]
    assert error.to_dict() == payload


def test_mcp_session_lists_selected_tools() -> None:
    """Start the real server in memory with no network or external tools."""

    async def list_names(client: Client) -> set[str]:
        return {tool.name for tool in await client.list_tools()}

    names = _in_session(list_names)
