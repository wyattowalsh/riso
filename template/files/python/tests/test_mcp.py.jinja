@pytest.mark.parametrize(
    ("transport", "sdk_transport"),
    [("stdio", None), ("sse", "sse"), ("http", "streamable-http")],
)
def test_mcp_module_launch(
    monkeypatch: pytest.MonkeyPatch, transport: str, sdk_transport: str | None
) -> None:
    """The installed module passes its CLI selection to the SDK launcher."""
    launches = []
    monkeypatch.setattr(mcp, "run", lambda **options: launches.append(options))
    monkeypatch.setattr(
        sys, "argv", ["mcp", "--transport", transport, "--host", "127.0.0.1", "--port", "8093"]
    )
    runpy.run_module("{{ package_name }}.mcp", run_name="__main__")
    if sdk_transport is None:
        assert launches == [{}]
    else:
        assert launches == [{"transport": sdk_transport, "host": "127.0.0.1", "port": 8093}]


def test_mcp_runner_rejects_unknown_transport(monkeypatch: pytest.MonkeyPatch) -> None:
    """An invalid programmatic launch cannot silently select an SDK transport."""
    launches = []
    monkeypatch.setattr(mcp, "run", lambda **options: launches.append(options))

    with pytest.raises(ValueError, match="Unknown transport: fixture-transport"):
        run_server(transport="fixture-transport")

    assert not launches


def test_mcp_unknown_tool_returns_protocol_error() -> None:
    """The client receives a tool error and can continue using the same session."""
    async def check(client: Client) -> None:
        available = {tool.name for tool in await client.list_tools()}
        with pytest.raises(ToolError, match="Unknown tool.*fixture_missing"):
            await client.call_tool("fixture_missing")
        assert {tool.name for tool in await client.list_tools()} == available

    _in_session(check)

