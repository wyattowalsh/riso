"""HTTP mock wiring tests for the generated Python test extra (respx)."""

from __future__ import annotations

import pytest

httpx = pytest.importorskip(
    "httpx",
    reason="httpx is pulled in by respx in the generated test extra",
)
respx = pytest.importorskip(
    "respx",
    reason="respx is provided by the generated test extra",
)

EXAMPLE_URL = "https://example.test/health"


@respx.mock
def test_respx_mocks_httpx_get() -> None:
    """respx intercepts httpx so tests never touch the network."""
    route = respx.get(EXAMPLE_URL).mock(
        return_value=httpx.Response(200, json={"status": "healthy"})
    )

    response = httpx.get(EXAMPLE_URL)

    assert response.status_code == 200
    assert response.json() == {"status": "healthy"}
    assert route.called
    assert route.call_count == 1
