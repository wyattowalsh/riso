class TestConfigListCommand:
    """Tests for config list command."""

    def test_config_list_shows_all_keys(self, cli_runner: CliRunner, temp_config: Path) -> None:
        """Test that config list shows all configuration keys."""
        result = cli_runner.invoke(
            app,
            ["config", "list", "--config", str(temp_config)]
        )

        assert result.exit_code == 0
        assert "app.name" in result.stdout
        assert "database.host" in result.stdout

    @pytest.mark.parametrize("format_name", ["json", "yaml"])
    def test_config_list_round_trips_machine_formats(
        self,
        cli_runner: CliRunner,
        temp_config: Path,
        monkeypatch: pytest.MonkeyPatch,
        format_name: str,
    ) -> None:
        """JSON and YAML retain literal markup and long values."""
        monkeypatch.delenv("{{ package_name | upper }}_APP_NAME", raising=False)
        value = "[bold]" + "literal-" * 20 + "[/bold]"
        temp_config.write_text(f'[app]\nname = "{value}"\n', encoding="utf-8")
        result = cli_runner.invoke(
            app,
            ["config", "list", "--config", str(temp_config), "--format", format_name]
        )
        assert result.exit_code == 0
        parse = json.loads if format_name == "json" else yaml.safe_load
        by_key = {item["key"]: item for item in parse(result.stdout)}
        assert by_key["app.name"]["value"] == value
        assert by_key["app.name"]["source"].startswith("file:")

    def test_config_list_rejects_unknown_format(
        self, cli_runner: CliRunner, temp_config: Path
    ) -> None:
        """An invalid format returns a nonzero status and an actionable error."""
        result = cli_runner.invoke(
            app, ["config", "list", "--config", str(temp_config), "--format", "binary"]
        )
        assert result.exit_code == 1
        assert "Unsupported output format: binary" in result.stdout


