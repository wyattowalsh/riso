class TestConfigManager:
    """Tests for ConfigManager core functionality."""

    def test_config_manager_loads_toml(self, temp_config: Path) -> None:
        """Test that ConfigManager loads TOML files."""
        config = ConfigManager(config_file=temp_config)
        config.load()

        assert config.get("app.name") == "test-app"
        assert config.get("database.host") == "localhost"

    def test_config_manager_respects_precedence(self, temp_config: Path, monkeypatch: pytest.MonkeyPatch) -> None:
        """Test configuration precedence: CLI > env > file > defaults."""
        # Set environment variable
        monkeypatch.setenv("TESTAPP_DATABASE_HOST", "env-host")

        config = ConfigManager(config_file=temp_config, env_prefix="TESTAPP_")
        config.load()

        # Env var should override file
        assert config.get("database.host") == "env-host"

        # CLI override should win
        assert config.get("database.host", cli_override="cli-host") == "cli-host"

    def test_config_manager_handles_nested_keys(self, temp_config: Path) -> None:
        """Test dot-notation nested key access."""
        config = ConfigManager(config_file=temp_config)
        config.load()

        assert config.get("database.port") == 5432

    def test_config_manager_auto_detects_config(self, tmp_path: Path) -> None:
        """Test auto-detection of config.toml."""
        # Create config in current directory
        config_file = tmp_path / "config.toml"
        config_file.write_text("[app]\nname = 'auto'")

        # Change to temp directory
        original_dir = Path.cwd()
        try:
            os.chdir(tmp_path)

            config = ConfigManager()
            config.load()

            assert config.get("app.name") == "auto"
        finally:
            os.chdir(original_dir)


def test_config_reloads_application_file(
    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
) -> None:
    """A forced reload discovers an app file and drops stale data on parse failure."""
    monkeypatch.chdir(tmp_path)
    manager = ConfigManager(
        env_prefix="RISO_TEST_CONFIG_",
        defaults={"app": {"name": "fallback", "enabled": True}},
    )
    assert manager.list_all()["app.name"] == ("fallback", "default")

    config_file = tmp_path / ".example.toml"
    config_file.write_text('[app]\nname = "from-file"\n', encoding="utf-8")
    manager.load("example")
    assert manager.get("app.name") == "fallback"
    manager.load("example", force=True)
    assert manager.list_all()["app.name"] == ("from-file", "file:.example.toml")
    assert manager.list_all()["app.enabled"] == (True, "default")

    config_file.write_text("[broken", encoding="utf-8")
    manager.load(force=True)
    assert manager.get("app.name") == "fallback"


@pytest.mark.parametrize(
    ("raw", "expected"),
    [("TRUE", True), ("off", False), ("42", 42), ("2.5", 2.5), ("test-host", "test-host")],
)
def test_config_decodes_environment_values(
    monkeypatch: pytest.MonkeyPatch, raw: str, expected: object
) -> None:
    """Environment overrides retain their parsed value and provenance."""
    key = "RISO_TEST_CONFIG_APP_VALUE"
    monkeypatch.setenv(key, raw)
    manager = ConfigManager(env_prefix="RISO_TEST_CONFIG_")
    actual, source = manager.list_all()["app.value"]
    assert actual == expected and type(actual) is type(expected)
    assert source == f"env:{key}"


def test_config_does_not_log_raw_environment_strings(monkeypatch: pytest.MonkeyPatch) -> None:
    """Regular string settings do not enter warning logs."""
    value = "sample-config-value"
    monkeypatch.setenv("RISO_TEST_CONFIG_APP_LABEL", value)
    messages: list[str] = []
    sink = logger.add(messages.append, level="WARNING")
    try:
        assert ConfigManager(env_prefix="RISO_TEST_CONFIG_").get("app.label") == value
    finally:
        logger.remove(sink)
    assert all(value not in message for message in messages)


def test_config_save_requires_a_target() -> None:
    """Saving without a destination produces a configuration error."""
    with pytest.raises(ConfigError, match="No config file path"):
        ConfigManager().save()


def test_config_save_preserves_valid_file_on_serialization_error(temp_config: Path) -> None:
    """An unsupported value does not overwrite the existing TOML."""
    before = temp_config.read_bytes()
    manager = ConfigManager(config_file=temp_config)
    manager.set("app.name", None)
    with pytest.raises(ConfigError, match="Failed to save config"):
        manager.save()
    assert temp_config.read_bytes() == before


class TestConfigSetCommand:
    """Tests for config set command."""

    def test_config_set_creates_and_updates(self, cli_runner: CliRunner, tmp_path: Path) -> None:
        """Test that config set creates and updates values."""
        config_file = tmp_path / "set_test.toml"

        result = cli_runner.invoke(
            app,
            ["config", "set", "test.key", "test-value", "--config", str(config_file)]
        )

        assert result.exit_code == 0
        assert "test.key" in result.stdout
        assert config_file.exists()

    def test_config_set_handles_nested_keys(self, cli_runner: CliRunner, tmp_path: Path) -> None:
        """Test setting nested configuration keys."""
        config_file = tmp_path / "nested_test.toml"

        result = cli_runner.invoke(
            app,
            ["config", "set", "database.connection.timeout", "30", "--config", str(config_file)]
        )

        assert result.exit_code == 0

    def test_config_set_preserves_malformed_file(self, cli_runner: CliRunner, tmp_path: Path) -> None:
        """A write must stop if the existing config cannot be loaded."""
        config_file = tmp_path / "invalid.toml"
        contents = b'[app\nname = "preserve me"\n'
        config_file.write_bytes(contents)
        result = cli_runner.invoke(
            app, ["config", "set", "app.name", "replacement", "--config", str(config_file)]
        )
        assert result.exit_code == 2
        assert "Failed to parse config file" in result.stdout
        assert config_file.read_bytes() == contents


