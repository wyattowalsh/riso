{%- set _has_root = (cli_module == 'enabled' and 'go' in cli_languages)
                 or (api_module == 'enabled' and 'go' in api_languages)
                 or (mcp_module == 'enabled' and 'go' in mcp_languages) -%}
{%- set _has_mcp = mcp_module == 'enabled' and 'go' in mcp_languages -%}
{% if _has_root %}
go {{ go_version | default('1.24') }}

# Root track is a single module (go.mod at track root) for CLI/API + internal/*.
# MCP-only still gets a workspace parent so `use ( . ; ./mcp )` is valid.
# Do not list ./cli or ./api — those directories are packages, not modules.
use (
	.
{%- if _has_mcp %}
	./mcp
{%- endif %}
)
{% endif %}
