## Adding Custom Tools

1. Create a new file in `internal/tools/`:

```go
package tools

import (
    "context"
    "log/slog"

    "github.com/modelcontextprotocol/go-sdk/mcp"
)

type MyToolInput struct {
    Name string `json:"name" jsonschema:"user's name"`
}

type MyToolOutput struct {
    Greeting string `json:"greeting"`
}

func RegisterMyTools(srv *mcp.Server, logger *slog.Logger) {
    mcp.AddTool(srv, &mcp.Tool{
        Name:        "greet",
        Description: "Greet a user by name",
    }, func(ctx context.Context, req *mcp.CallToolRequest, input MyToolInput) (*mcp.CallToolResult, MyToolOutput, error) {
        return nil, MyToolOutput{
            Greeting: "Hello, " + input.Name + "!",
        }, nil
    })
}
```

2. Register in `internal/mcp/server.go`:

```go
func (s *Server) registerTools() {
    tools.RegisterMyTools(s.mcp, s.logger)
}
```

## Adding Custom Resources

1. Create a new file in `internal/resources/`:

```go
package resources

import (
    "context"
    "encoding/json"
    "log/slog"

    "github.com/modelcontextprotocol/go-sdk/mcp"
)

func RegisterConfigResource(srv *mcp.Server, logger *slog.Logger) {
    srv.AddResource(&mcp.Resource{
        URI:         "config://app",
        Name:        "Application Config",
        Description: "Get application configuration",
        MIMEType:    "application/json",
    }, func(ctx context.Context, req *mcp.ReadResourceRequest) (*mcp.ReadResourceResult, error) {
        config := map[string]any{
            "version": "1.0.0",
            "env":     "development",
        }
        data, _ := json.MarshalIndent(config, "", "  ")
        return &mcp.ReadResourceResult{
            Contents: []*mcp.ResourceContents{
                {
                    URI:      req.Params.URI,
                    MIMEType: "application/json",
                    Text:     string(data),
                },
            },
        }, nil
    })
}
```

