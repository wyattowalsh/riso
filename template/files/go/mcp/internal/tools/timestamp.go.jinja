{%- if mcp_module == 'enabled' and 'go' in mcp_languages and mcp_example_tools -%}
package tools

import (
	"context"
	"fmt"
	"log/slog"
	"strconv"
	"time"

	"github.com/modelcontextprotocol/go-sdk/mcp"
)

// GetCurrentTimeInput represents the input for get_current_time.
type GetCurrentTimeInput struct {
	Format       string `json:"format,omitempty" jsonschema:"output format: iso, unix, rfc2822, or human (default: iso)"`
	TimezoneName string `json:"timezone_name,omitempty" jsonschema:"timezone name (only UTC supported currently, default: UTC)"`
}

// GetCurrentTimeOutput represents the output from get_current_time.
type GetCurrentTimeOutput struct {
	Timestamp  string            `json:"timestamp" jsonschema:"the formatted timestamp"`
	Format     string            `json:"format" jsonschema:"the format used"`
	Timezone   string            `json:"timezone" jsonschema:"the timezone used"`
	AllFormats map[string]string `json:"all_formats" jsonschema:"timestamp in all available formats"`
}

// ParseTimestampInput represents the input for parse_timestamp.
type ParseTimestampInput struct {
	Timestamp   string `json:"timestamp" jsonschema:"the timestamp string to parse"`
	InputFormat string `json:"input_format,omitempty" jsonschema:"format of the input: iso, unix (default: iso)"`
}

// ParseTimestampOutput represents the output from parse_timestamp.
type ParseTimestampOutput struct {
	Success bool   `json:"success" jsonschema:"whether parsing was successful"`
	Year    int    `json:"year,omitempty" jsonschema:"year component"`
	Month   int    `json:"month,omitempty" jsonschema:"month component (1-12)"`
	Day     int    `json:"day,omitempty" jsonschema:"day component (1-31)"`
	Hour    int    `json:"hour,omitempty" jsonschema:"hour component (0-23)"`
	Minute  int    `json:"minute,omitempty" jsonschema:"minute component (0-59)"`
	Second  int    `json:"second,omitempty" jsonschema:"second component (0-59)"`
	Weekday string `json:"weekday,omitempty" jsonschema:"day of the week"`
	ISO     string `json:"iso,omitempty" jsonschema:"ISO format representation"`
	Error   string `json:"error,omitempty" jsonschema:"error message if parsing failed"`
}

// TimeDifferenceInput represents the input for time_difference.
type TimeDifferenceInput struct {
	Start string `json:"start" jsonschema:"start timestamp (ISO format)"`
	End   string `json:"end,omitempty" jsonschema:"end timestamp (ISO format), defaults to now"`
}

// TimeDifferenceOutput represents the output from time_difference.
type TimeDifferenceOutput struct {
	Success bool   `json:"success" jsonschema:"whether calculation was successful"`
	Seconds int64  `json:"seconds,omitempty" jsonschema:"total seconds difference"`
	Minutes int64  `json:"minutes,omitempty" jsonschema:"total minutes difference"`
	Hours   int64  `json:"hours,omitempty" jsonschema:"total hours difference"`
	Days    int64  `json:"days,omitempty" jsonschema:"total days difference"`
	Human   string `json:"human,omitempty" jsonschema:"human-readable duration"`
	Error   string `json:"error,omitempty" jsonschema:"error message if calculation failed"`
}

// RegisterTimestampTools registers all timestamp-related tools with the MCP server.
func RegisterTimestampTools(srv *mcp.Server, logger *slog.Logger) {
	mcp.AddTool(srv, &mcp.Tool{
		Name:        "get_current_time",
		Description: "Get the current time in various formats. Returns the current date and time with formatting options.",
	}, func(ctx context.Context, _ *mcp.CallToolRequest, input GetCurrentTimeInput) (*mcp.CallToolResult, GetCurrentTimeOutput, error) {
		if input.Format == "" {
			input.Format = "iso"
		}
		if input.TimezoneName == "" {
			input.TimezoneName = "UTC"
		}

		now := time.Now().UTC()
		formats := map[string]string{
			"iso":     now.Format(time.RFC3339),
			"unix":    strconv.FormatInt(now.Unix(), 10),
			"rfc2822": now.Format(time.RFC1123Z),
			"human":   now.Format("January 02, 2006 at 03:04 PM UTC"),
		}

		timestamp := formats[input.Format]
		if timestamp == "" {
			timestamp = formats["iso"]
		}

		logger.Debug("executing get_current_time tool", "format", input.Format)
		return nil, GetCurrentTimeOutput{
			Timestamp:  timestamp,
			Format:     input.Format,
			Timezone:   input.TimezoneName,
			AllFormats: formats,
		}, nil
	})

	mcp.AddTool(srv, &mcp.Tool{
		Name:        "parse_timestamp",
		Description: "Parse a timestamp string into components. Converts a timestamp string into structured date/time components.",
	}, func(ctx context.Context, _ *mcp.CallToolRequest, input ParseTimestampInput) (*mcp.CallToolResult, ParseTimestampOutput, error) {
		if input.InputFormat == "" {
			input.InputFormat = "iso"
		}

		var t time.Time
		switch input.InputFormat {
		case "unix":
			unix, err := strconv.ParseInt(input.Timestamp, 10, 64)
			if err != nil {
				return nil, ParseTimestampOutput{
					Success: false,
					Error:   fmt.Sprintf("invalid unix timestamp: %v", err),
				}, nil
			}
			t = time.Unix(unix, 0).UTC()
		default:
			parsed, err := time.Parse(time.RFC3339, input.Timestamp)
			if err != nil {
				parsed, err = time.Parse("2006-01-02T15:04:05Z", input.Timestamp)
				if err != nil {
					return nil, ParseTimestampOutput{
						Success: false,
						Error:   fmt.Sprintf("failed to parse timestamp: %v", err),
					}, nil
				}
			}
			t = parsed
		}

		logger.Debug("executing parse_timestamp tool", "input", input.Timestamp)
		return nil, ParseTimestampOutput{
			Success: true,
			Year:    t.Year(),
			Month:   int(t.Month()),
			Day:     t.Day(),
			Hour:    t.Hour(),
			Minute:  t.Minute(),
			Second:  t.Second(),
			Weekday: t.Weekday().String(),
			ISO:     t.Format(time.RFC3339),
		}, nil
	})

	mcp.AddTool(srv, &mcp.Tool{
		Name:        "time_difference",
		Description: "Calculate the difference between two timestamps. If end is not provided, calculates difference from start to now.",
	}, func(ctx context.Context, _ *mcp.CallToolRequest, input TimeDifferenceInput) (*mcp.CallToolResult, TimeDifferenceOutput, error) {
		startTime, err := time.Parse(time.RFC3339, input.Start)
		if err != nil {
			return nil, TimeDifferenceOutput{
				Success: false,
				Error:   fmt.Sprintf("failed to parse start time: %v", err),
			}, nil
		}

		var endTime time.Time
		if input.End != "" {
			endTime, err = time.Parse(time.RFC3339, input.End)
			if err != nil {
				return nil, TimeDifferenceOutput{
					Success: false,
					Error:   fmt.Sprintf("failed to parse end time: %v", err),
				}, nil
			}
		} else {
			endTime = time.Now().UTC()
		}

		delta := endTime.Sub(startTime)
		totalSeconds := int64(delta.Seconds())

		logger.Debug("executing time_difference tool", "start", input.Start, "end", input.End)
		return nil, TimeDifferenceOutput{
			Success: true,
			Seconds: totalSeconds,
			Minutes: totalSeconds / 60,
			Hours:   totalSeconds / 3600,
			Days:    totalSeconds / 86400,
			Human:   delta.String(),
		}, nil
	})

	logger.Debug("registered timestamp tools")
}
{%- endif %}
