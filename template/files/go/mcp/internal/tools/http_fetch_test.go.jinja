func TestHTTPFetchPublicAddresses(t *testing.T) {
	for _, blocked := range []string{
		"0.0.0.0", "10.0.0.1", "100.100.100.200", "127.0.0.1", "168.63.129.16", "169.254.169.254",
		"172.19.0.1", "172.31.255.255", "192.0.0.9", "192.0.2.1", "192.31.196.1", "192.52.193.1",
		"192.88.99.1", "192.168.0.1", "192.175.48.1", "198.18.0.1", "198.51.100.1", "203.0.113.1",
		"224.0.0.1", "240.0.0.1", "::", "::1", "::ffff:172.19.0.1", "::ffff:a9fe:a9fe", "fc00::1",
		"fe80::1%eth0", "ff02::1", "64:ff9b::7f00:1", "2001::1", "2001:db8::1", "2002:7f00:1::",
		"2620:4f:8000::1", "3ffe::1", "3fff::1",
	} {
		if isPublicHTTPFetchIP(netip.MustParseAddr(blocked)) {
			t.Errorf("allowed special address %s", blocked)
		}
	}
	for _, allowed := range []string{"93.184.216.34", "::ffff:93.184.216.34", "2606:4700:4700::1111"} {
		if !isPublicHTTPFetchIP(netip.MustParseAddr(allowed)) {
			t.Errorf("rejected public address %s", allowed)
		}
	}
}

func TestHTTPFetchURLPolicy(t *testing.T) {
	for _, blocked := range []string{
		"", "http://public.example", "https:/public.example", "https:public.example", "//public.example",
		"https://public.example@172.31.0.1/", "https://user:fixture@public.example/", "https://[fc00::1]/",
		"https://[::ffff:ac13:1]/", "https://[fe80::1%25eth0]/", "https://LOCALHOST./", "https://service.local/",
		"https://metadata.google.internal./", "https://metadata/", "https://node.home.arpa/", "https://host.test/",
		"https://2130706433/", "https://127.1/", "https://0177.0.0.1/", "https://0x7f000001/", "https://0x7f.1/",
		"https://bad_host.example/", "https://public.example../",
	} {
		if _, err := parseHTTPFetchURL(blocked); err == nil {
			t.Errorf("allowed unsafe URL %q", blocked)
		}
	}
	for _, allowed := range []string{
		"https://notlocalhost.example/path/172.19.0.1?value=metadata.google.internal",
		"https://localhost.example:8443", "https://[2606:4700:4700::1111]/", "https://93.184.216.34/",
	} {
		if _, err := parseHTTPFetchURL(allowed); err != nil {
			t.Errorf("rejected public URL %q: %v", allowed, err)
		}
	}
}

func TestHTTPFetchRejectsHostOverrideAndInvalidTimeout(t *testing.T) {
	zero, negative, tooLong := 0, -1, 121
	for _, input := range []HTTPFetchInput{
		{Headers: map[string]string{"hOsT": "localhost"}},
		{Timeout: &zero}, {Timeout: &negative}, {Timeout: &tooLong},
	} {
		input.URL = "https://public.example"
		out := executeHTTPFetch(t.Context(), slog.Default(), input, func(context.Context) *http.Client {
			t.Fatal("invalid request created an HTTP client")
			return nil
		})
		if out.Success || out.Error == "" {
			t.Errorf("invalid request did not fail: %+v", out)
		}
	}
}

func TestHTTPFetchRejectsUnvettedDNSAnswersBeforeDial(t *testing.T) {
	public := netip.MustParseAddr("93.184.216.34")
	for _, test := range []struct {
		name      string
		addresses []netip.Addr
		lookupErr error
	}{
		{name: "mixed", addresses: []netip.Addr{public, netip.MustParseAddr("172.19.0.1")}},
		{name: "mapped", addresses: []netip.Addr{netip.MustParseAddr("::ffff:a9fe:a9fe")}},
		{name: "private IPv6", addresses: []netip.Addr{netip.MustParseAddr("fd00::1")}},
		{name: "empty"},
		{name: "resolver failure", lookupErr: errors.New("fixture DNS failure")},
	} {
		t.Run(test.name, func(t *testing.T) {
			var lookups, dials atomic.Int32
			network := httpFetchNetwork{
				lookupIP: func(context.Context, string) ([]netip.Addr, error) {
					lookups.Add(1)
					return test.addresses, test.lookupErr
				},
				dialContext: func(context.Context, string, string) (net.Conn, error) {
					dials.Add(1)
					return nil, errors.New("fixture rejected unexpected dial")
				},
			}
			input := HTTPFetchInput{URL: "https://public.example"}
			out := executeHTTPFetch(t.Context(), slog.Default(), input, func(ctx context.Context) *http.Client {
				return newHTTPFetchClient(ctx, network)
			})
			if out.Success || out.Error == "" || lookups.Load() != 1 || dials.Load() != 0 {
				t.Fatalf("DNS did not fail before dial: %+v, lookups=%d, dials=%d", out, lookups.Load(), dials.Load())
			}
		})
	}
}

func httpFetchTestTLS(t *testing.T) (*tls.Config, *x509.CertPool) {
	t.Helper()
	public, private, err := ed25519.GenerateKey(rand.Reader)
	if err != nil {
		t.Fatal(err)
	}
	now := time.Now()
	leaf := &x509.Certificate{
		SerialNumber: big.NewInt(1), DNSNames: []string{"public.example"},
		NotBefore: now.Add(-time.Minute), NotAfter: now.Add(time.Minute),
		KeyUsage: x509.KeyUsageDigitalSignature, ExtKeyUsage: []x509.ExtKeyUsage{x509.ExtKeyUsageServerAuth},
	}
	der, err := x509.CreateCertificate(rand.Reader, leaf, leaf, public, private)
	if err != nil {
		t.Fatal(err)
	}
	cert, err := x509.ParseCertificate(der)
	if err != nil {
		t.Fatal(err)
	}
	roots := x509.NewCertPool()
	roots.AddCert(cert)
	keyPair := tls.Certificate{Certificate: [][]byte{der}, PrivateKey: private}
	return &tls.Config{Certificates: []tls.Certificate{keyPair}}, roots
}

func httpFetchTestClient(ctx context.Context, network httpFetchNetwork, roots *x509.CertPool) *http.Client {
	client := newHTTPFetchClient(ctx, network)
	client.Transport.(*http.Transport).TLSClientConfig = &tls.Config{RootCAs: roots}
	return client
}

func httpFetchTestSession(
	t *testing.T, ctx context.Context, newClient func(context.Context) *http.Client,
) *mcp.ClientSession {
	t.Helper()
	srv := mcp.NewServer(&mcp.Implementation{Name: "fixture-server", Version: "1"}, nil)
	registerHTTPTools(srv, slog.Default(), newClient)
	serverTransport, clientTransport := mcp.NewInMemoryTransports()
	serverSession, err := srv.Connect(ctx, serverTransport, nil)
	if err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() { _ = serverSession.Close() })
	client := mcp.NewClient(&mcp.Implementation{Name: "fixture-client", Version: "1"}, nil)
	session, err := client.Connect(ctx, clientTransport, nil)
	if err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() { _ = session.Close() })
	return session
}

func httpFetchTestCall(
	t *testing.T, ctx context.Context, session *mcp.ClientSession, args map[string]any,
) HTTPFetchOutput {
	t.Helper()
	result, err := session.CallTool(ctx, &mcp.CallToolParams{Name: "http_fetch", Arguments: args})
	if err != nil || result == nil || result.IsError {
		t.Fatalf("SDK call failed: result=%+v err=%v", result, err)
	}
	body, err := json.Marshal(result.StructuredContent)
	if err != nil {
		t.Fatal(err)
	}
	var out HTTPFetchOutput
	if err := json.Unmarshal(body, &out); err != nil {
		t.Fatal(err)
	}
	return out
}

func TestHTTPFetchSDKPinsDNSAndKeepsTLSIdentity(t *testing.T) {
	t.Setenv("HTTPS_PROXY", "http://proxy.invalid:3128")
	t.Setenv("NO_PROXY", "")
	ctx, cancel := context.WithTimeout(t.Context(), 5*time.Second)
	defer cancel()
	serverTLS, roots := httpFetchTestTLS(t)
	served := make(chan error, 1)
	var lookups, dials atomic.Int32
	network := httpFetchNetwork{
		lookupIP: func(_ context.Context, host string) ([]netip.Addr, error) {
			if host != "public.example" {
				return nil, fmt.Errorf("unexpected resolver host %q", host)
			}
			if lookups.Add(1) > 1 {
				return []netip.Addr{netip.MustParseAddr("172.19.0.1")}, nil
			}
			return []netip.Addr{netip.MustParseAddr("93.184.216.34")}, nil
		},
		dialContext: func(_ context.Context, proto, target string) (net.Conn, error) {
			if dials.Add(1) != 1 || proto != "tcp" || target != "93.184.216.34:443" {
				return nil, fmt.Errorf("dial was not pinned to the first validated answer: %s %s", proto, target)
			}
			client, server := net.Pipe()
			go func() {
				defer server.Close()
				peer := tls.Server(server, serverTLS)
				req, err := http.ReadRequest(bufio.NewReader(peer))
				if err != nil {
					served <- err
					return
				}
				defer req.Body.Close()
				body, err := io.ReadAll(req.Body)
				if err != nil || req.Host != "public.example" || req.Method != http.MethodPost ||
					req.Header.Get("X-Fixture") != "kept" || string(body) != "fixture request" ||
					peer.ConnectionState().ServerName != "public.example" {
					served <- fmt.Errorf("unexpected request over pinned TLS connection: %s %s: %v", req.Method, req.Host, err)
					return
				}
				_, err = io.WriteString(peer, "HTTP/1.1 302 Found\r\nLocation: https://other.example/\r\n"+
					"X-Fixture: first\r\nX-Fixture: second\r\nContent-Length: 8\r\nConnection: close\r\n\r\nredirect")
				served <- err
			}()
			return client, nil
		},
	}
	session := httpFetchTestSession(t, ctx, func(ctx context.Context) *http.Client {
		return httpFetchTestClient(ctx, network, roots)
	})
	const publicURL = "https://public.example/localhost?target=172.19.0.1"
	nullTimeout, err := session.CallTool(ctx, &mcp.CallToolParams{
		Name: "http_fetch", Arguments: map[string]any{"url": publicURL, "timeout": nil},
	})
	if err != nil || nullTimeout == nil || !nullTimeout.IsError || lookups.Load() != 0 {
		t.Fatalf("SDK accepted null for an optional integer timeout: result=%+v err=%v", nullTimeout, err)
	}
	invalid := httpFetchTestCall(t, ctx, session, map[string]any{"url": publicURL, "timeout": 0})
	if invalid.Success || !strings.Contains(invalid.Error, "timeout") || lookups.Load() != 0 {
		t.Fatalf("explicit zero timeout passed SDK validation and guard: %+v", invalid)
	}
	out := httpFetchTestCall(t, ctx, session, map[string]any{
		"url": publicURL, "method": http.MethodPost, "body": "fixture request",
		"headers": map[string]string{"X-Fixture": "kept"},
	})
	if !out.Success || out.Error != "" || out.StatusCode != 302 || out.Body != "redirect" || out.BodyLength != 8 ||
		out.Truncated || out.Headers["X-Fixture"] != "first" || lookups.Load() != 1 || dials.Load() != 1 {
		t.Fatalf("unexpected result with omitted timeout: %+v, lookups=%d, dials=%d", out, lookups.Load(), dials.Load())
	}
	select {
	case err := <-served:
		if err != nil {
			t.Fatal(err)
		}
	case <-ctx.Done():
		t.Fatal("in-memory TLS server did not finish")
	}
}

func TestHTTPFetchDeadlineCoversDNS(t *testing.T) {
	t.Parallel()
	ctx, cancel := context.WithTimeout(t.Context(), 4*time.Second)
	defer cancel()
	seconds := 1
	observed := make(chan error, 1)
	var dials atomic.Int32
	out := executeHTTPFetch(ctx, slog.Default(), HTTPFetchInput{URL: "https://public.example", Timeout: &seconds},
		func(requestCtx context.Context) *http.Client {
			want, _ := requestCtx.Deadline()
			return newHTTPFetchClient(requestCtx, httpFetchNetwork{
				lookupIP: func(dialCtx context.Context, _ string) ([]netip.Addr, error) {
					got, ok := dialCtx.Deadline()
					if !ok || !got.Equal(want) {
						err := errors.New("DNS did not inherit the request deadline")
						observed <- err
						return nil, err
					}
					<-dialCtx.Done()
					observed <- dialCtx.Err()
					return nil, dialCtx.Err()
				},
				dialContext: func(context.Context, string, string) (net.Conn, error) {
					dials.Add(1)
					return nil, errors.New("fixture rejected unexpected dial")
				},
			})
		})
	if out.Success || out.Error == "" || dials.Load() != 0 {
		t.Fatalf("stalled DNS did not fail closed: %+v", out)
	}
	select {
	case err := <-observed:
		if !errors.Is(err, context.DeadlineExceeded) {
			t.Fatalf("unexpected resolver cancellation: %v", err)
		}
	case <-ctx.Done():
		t.Fatal("resolver outlived the request deadline")
	}
}

type httpFetchTestCloseNotify struct {
	net.Conn
	closed chan struct{}
}

func (conn *httpFetchTestCloseNotify) Close() error {
	err := conn.Conn.Close()
	select {
	case conn.closed <- struct{}{}:
	default:
	}
	return err
}

func TestHTTPFetchDeadlineClosesStalledTLS(t *testing.T) {
	t.Parallel()
	ctx, cancel := context.WithTimeout(t.Context(), 4*time.Second)
	defer cancel()
	seconds := 1
	client, peer := net.Pipe()
	defer client.Close()
	defer peer.Close() // Do not read or answer the TLS handshake.
	closed := make(chan struct{}, 1)
	network := httpFetchNetwork{
		dialContext: func(context.Context, string, string) (net.Conn, error) {
			return &httpFetchTestCloseNotify{Conn: client, closed: closed}, nil
		},
	}
	out := executeHTTPFetch(ctx, slog.Default(), HTTPFetchInput{URL: "https://93.184.216.34", Timeout: &seconds},
		func(ctx context.Context) *http.Client { return newHTTPFetchClient(ctx, network) })
	if out.Success || !strings.Contains(out.Error, "request failed") || ctx.Err() != nil {
		t.Fatalf("stalled TLS did not fail under the request's deadline: %+v", out)
	}
	select {
	case <-closed:
	case <-ctx.Done():
		t.Fatal("request deadline left the TLS connection open")
	}
}

func TestHTTPFetchDeadlineCoversBody(t *testing.T) {
	t.Parallel()
	serverTLS, roots := httpFetchTestTLS(t)
	seconds := 1
	release := make(chan struct{})
	defer close(release)
	network := httpFetchNetwork{
		lookupIP: func(context.Context, string) ([]netip.Addr, error) {
			return []netip.Addr{netip.MustParseAddr("93.184.216.34")}, nil
		},
		dialContext: func(context.Context, string, string) (net.Conn, error) {
			client, server := net.Pipe()
			go func() {
				defer server.Close()
				peer := tls.Server(server, serverTLS)
				req, err := http.ReadRequest(bufio.NewReader(peer))
				if err != nil {
					return
				}
				_ = req.Body.Close()
				if _, err := io.WriteString(peer, "HTTP/1.1 200 OK\r\nContent-Length: 4\r\n\r\n"); err == nil {
					<-release // Keep the response open without sending any body bytes.
				}
			}()
			return client, nil
		},
	}
	ctx, cancel := context.WithTimeout(t.Context(), 4*time.Second)
	defer cancel()
	out := executeHTTPFetch(ctx, slog.Default(), HTTPFetchInput{URL: "https://public.example", Timeout: &seconds},
		func(ctx context.Context) *http.Client { return httpFetchTestClient(ctx, network, roots) })
	if !out.Success || out.StatusCode != 200 || out.Status != "200 OK" || out.Body != "" || out.BodyLength != 0 ||
		out.Truncated || !strings.Contains(out.Error, "failed to read body") {
		t.Fatalf("body deadline lost the established response/error contract: %+v", out)
	}
}

type httpFetchTestRoundTripper func(*http.Request) (*http.Response, error)

func (fn httpFetchTestRoundTripper) RoundTrip(req *http.Request) (*http.Response, error) {
	return fn(req)
}

func TestHTTPFetchReadsOnlyLimitAndSentinel(t *testing.T) {
	for _, test := range []struct {
		name, body, want string
		truncated        bool
	}{
		{"exact limit", strings.Repeat("a", maxBodySize), strings.Repeat("a", maxBodySize), false},
		{"over limit", strings.Repeat("a", maxBodySize+5), strings.Repeat("a", maxBodySize), true},
		{"cut after one UTF-8 byte", strings.Repeat("a", maxBodySize-1) + "😀rest", strings.Repeat("a", maxBodySize-1), true},
		{"cut after three UTF-8 bytes", strings.Repeat("a", maxBodySize-3) + "😀rest", strings.Repeat("a", maxBodySize-3), true},
		{"invalid byte retained", "\xff" + strings.Repeat("a", maxBodySize-2) + "érest",
			"\xff" + strings.Repeat("a", maxBodySize-2) + "\xc3", true},
	} {
		t.Run(test.name, func(t *testing.T) {
			body := strings.NewReader(test.body)
			input := HTTPFetchInput{URL: "https://public.example"}
			out := executeHTTPFetch(t.Context(), slog.Default(), input, func(context.Context) *http.Client {
				return &http.Client{Transport: httpFetchTestRoundTripper(func(*http.Request) (*http.Response, error) {
					return &http.Response{Status: "200 OK", StatusCode: 200, Body: io.NopCloser(body)}, nil
				})}
			})
			read := len(test.body) - body.Len()
			if !out.Success || out.Body != test.want || out.BodyLength != len(test.want) ||
				out.Truncated != test.truncated || read != min(len(test.body), maxBodySize+1) {
				t.Fatalf("body contract changed: length=%d truncated=%t bytes_read=%d error=%q", out.BodyLength, out.Truncated, read, out.Error)
			}
		})
	}
}
