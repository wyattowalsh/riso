{%- if mcp_module == 'enabled' and 'go' in mcp_languages and mcp_example_tools -%}
package tools

import (
	"context"
	"fmt"
	"io"
	"log/slog"
	"net/http"
	"strings"
	"time"

	"github.com/modelcontextprotocol/go-sdk/mcp"
)

// HTTPFetchInput represents the input for http_fetch.
type HTTPFetchInput struct {
	URL     string            `json:"url" jsonschema:"URL to fetch"`
	Method  string            `json:"method,omitempty" jsonschema:"HTTP method (GET, POST, etc.). Default: GET"`
	Headers map[string]string `json:"headers,omitempty" jsonschema:"optional HTTP headers"`
	Body    string            `json:"body,omitempty" jsonschema:"optional request body"`
	Timeout int               `json:"timeout,omitempty" jsonschema:"request timeout in seconds (default: 30)"`
}

// HTTPFetchOutput represents the output from http_fetch.
type HTTPFetchOutput struct {
	Success    bool              `json:"success" jsonschema:"whether the fetch was successful"`
	StatusCode int               `json:"status_code,omitempty" jsonschema:"HTTP status code"`
	Status     string            `json:"status,omitempty" jsonschema:"HTTP status text"`
	Headers    map[string]string `json:"headers,omitempty" jsonschema:"response headers"`
	Body       string            `json:"body,omitempty" jsonschema:"response body (truncated if > 10KB)"`
	BodyLength int               `json:"body_length,omitempty" jsonschema:"total body length in bytes"`
	Truncated  bool              `json:"truncated,omitempty" jsonschema:"whether the body was truncated"`
	Error      string            `json:"error,omitempty" jsonschema:"error message if fetch failed"`
}

const maxBodySize = 10 * 1024 // 10KB

// RegisterHTTPTools registers all HTTP-related tools with the MCP server.
func RegisterHTTPTools(srv *mcp.Server, logger *slog.Logger) {
	mcp.AddTool(srv, &mcp.Tool{
		Name:        "http_fetch",
		Description: "Fetch content from a URL. Supports GET, POST, and other HTTP methods with custom headers.",
	}, func(ctx context.Context, _ *mcp.CallToolRequest, input HTTPFetchInput) (*mcp.CallToolResult, HTTPFetchOutput, error) {
		if input.URL == "" {
			return nil, HTTPFetchOutput{Success: false, Error: "URL is required"}, nil
		}
		if !strings.HasPrefix(strings.ToLower(input.URL), "https://") {
			return nil, HTTPFetchOutput{Success: false, Error: "only https:// URLs are allowed"}, nil
		}
		lower := strings.ToLower(input.URL)
		for _, blocked := range []string{
			"localhost", "127.0.0.1", "0.0.0.0", "::1",
			"169.254.169.254", "metadata.google", "[::1]",
			"10.", "192.168.", "172.16.", "172.17.", "172.18.",
		} {
			if strings.Contains(lower, blocked) {
				return nil, HTTPFetchOutput{
					Success: false,
					Error:   "URL host is not allowed (SSRF protection)",
				}, nil
			}
		}

		if input.Method == "" {
			input.Method = "GET"
		}
		if input.Timeout == 0 {
			input.Timeout = 30
		}

		client := &http.Client{
			Timeout: time.Duration(input.Timeout) * time.Second,
			CheckRedirect: func(req *http.Request, via []*http.Request) error {
				return http.ErrUseLastResponse
			},
		}

		var bodyReader io.Reader
		if input.Body != "" {
			bodyReader = strings.NewReader(input.Body)
		}

		req, err := http.NewRequestWithContext(ctx, input.Method, input.URL, bodyReader)
		if err != nil {
			return nil, HTTPFetchOutput{
				Success: false,
				Error:   fmt.Sprintf("failed to create request: %v", err),
			}, nil
		}

		for key, value := range input.Headers {
			req.Header.Set(key, value)
		}
		if req.Header.Get("User-Agent") == "" {
			req.Header.Set("User-Agent", "{{ package_name }}-mcp/1.0")
		}

		logger.Debug("executing http_fetch tool", "url", input.URL, "method", input.Method)

		resp, err := client.Do(req)
		if err != nil {
			return nil, HTTPFetchOutput{
				Success: false,
				Error:   fmt.Sprintf("request failed: %v", err),
			}, nil
		}
		defer resp.Body.Close()

		body, err := io.ReadAll(io.LimitReader(resp.Body, maxBodySize+1))
		if err != nil {
			return nil, HTTPFetchOutput{
				Success:    true,
				StatusCode: resp.StatusCode,
				Status:     resp.Status,
				Error:      fmt.Sprintf("failed to read body: %v", err),
			}, nil
		}

		truncated := len(body) > maxBodySize
		if truncated {
			body = body[:maxBodySize]
		}

		responseHeaders := make(map[string]string)
		for key := range resp.Header {
			responseHeaders[key] = resp.Header.Get(key)
		}

		return nil, HTTPFetchOutput{
			Success:    true,
			StatusCode: resp.StatusCode,
			Status:     resp.Status,
			Headers:    responseHeaders,
			Body:       string(body),
			BodyLength: len(body),
			Truncated:  truncated,
		}, nil
	})

	logger.Debug("registered HTTP tools")
}
{%- endif %}
