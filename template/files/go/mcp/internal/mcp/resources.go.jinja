// RegisterDynamicResource registers a resource template for dynamic URIs.
func RegisterDynamicResource(
	srv *mcp.Server,
	logger *slog.Logger,
	uriTemplate string,
	description string,
	handler func(ctx context.Context, uri string) (string, error),
) {
	srv.AddResourceTemplate(&mcp.ResourceTemplate{
		URITemplate: uriTemplate,
		Name:        uriTemplate,
		Description: description,
		MIMEType:    "application/json",
	}, func(ctx context.Context, req *mcp.ReadResourceRequest) (*mcp.ReadResourceResult, error) {
		uri := req.Params.URI
		logger.Debug("reading dynamic resource", "uri", uri)

		content, err := handler(ctx, uri)
		if err != nil {
			logger.Error("failed to read dynamic resource",
				"uri", uri,
				"error", err,
			)
			return nil, err
		}

		logger.Debug("dynamic resource read successfully", "uri", uri)
		return &mcp.ReadResourceResult{
			Contents: []*mcp.ResourceContents{
				{
					URI:      uri,
					MIMEType: "application/json",
					Text:     content,
				},
			},
		}, nil
	})
}
