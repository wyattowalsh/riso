{%- set _has_cli_or_api = (cli_module == 'enabled' and 'go' in cli_languages)
                      or (api_module == 'enabled' and 'go' in api_languages) -%}
{%- set _has_mcp = mcp_module == 'enabled' and 'go' in mcp_languages -%}
{%- set _framework = go_framework | default('gin') -%}
{% if _has_cli_or_api or _has_mcp %}
module {{ project_slug }}

go {{ go_version | default('1.27') }}.0
{% if _has_cli_or_api %}

require (
{% if cli_module == 'enabled' and 'go' in cli_languages %}
	github.com/spf13/cobra v1.10.2
{% endif %}
{% if api_module == 'enabled' and 'go' in api_languages %}
{% if _framework == 'gin' %}
	github.com/gin-gonic/gin v1.12.0
{% elif _framework == 'fiber' %}
	github.com/gofiber/fiber/v2 v2.52.16
{% elif _framework == 'echo' %}
	github.com/labstack/echo/v4 v4.16.3
{% elif _framework == 'chi' %}
	github.com/go-chi/chi/v5 v5.5.0
	github.com/go-chi/cors v1.2.2
{% endif %}
{% endif %}
	github.com/knadh/koanf/v2 v2.4.1
	github.com/knadh/koanf/providers/env v1.1.0
	github.com/knadh/koanf/providers/file v1.2.1
	github.com/knadh/koanf/parsers/yaml v1.1.1
{% if api_module == 'enabled' and 'go' in api_languages %}
{# Minimum versions that replace advisory-bearing transitive selections. #}
{% if _framework == 'gin' %}
	github.com/quic-go/quic-go v0.65.0 // indirect
{% elif _framework == 'fiber' %}
	github.com/klauspost/compress v1.20.3 // indirect
	github.com/valyala/fasthttp v1.77.0 // indirect
{% endif %}
{% if _framework in ['gin', 'echo'] %}
	golang.org/x/crypto v0.58.0 // indirect
	golang.org/x/net v0.62.0 // indirect
	golang.org/x/text v0.43.0 // indirect
{% endif %}
{% endif %}
	golang.org/x/sys v0.49.0 // indirect
)
{% endif %}
{% endif %}
