# pnpm workspace configuration
packages:
  - "node/apps/*"
  - "node/docs/*"
  - "node/mcp"
  - "node/saas"
  - "node/packages/*"
{%- if desktop_module == "enabled" and desktop_framework == "electron-vite" %}
  - "electron"
{%- endif %}
{%- if desktop_module == "enabled" and desktop_framework == "tauri" %}
  - "tauri"
{%- endif %}
