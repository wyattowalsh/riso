{% if desktop_module == "enabled" and desktop_framework == "electron-vite" %}
{
  "name": "{{ project_slug }}-electron",
  "version": "0.1.0",
  "description": "{{ project_name }} - Native desktop application",
  "main": "./out/main/index.js",
  "homepage": "https://github.com/{{ github_username | default('your-username') }}/{{ project_slug }}",
  "author": {
    "name": "{{ author_name | default(project_name) }}"
  },
  "license": "MIT",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron .",
    "postinstall": "electron-builder install-app-deps",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "pnpm typecheck:node && pnpm typecheck:web",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,html}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"{% if 'mac' in desktop_platforms %},
    "build:mac": "electron-builder --mac"{% endif %}{% if 'windows' in desktop_platforms %},
    "build:win": "electron-builder --win"{% endif %}{% if 'linux' in desktop_platforms %},
    "build:linux": "electron-builder --linux"{% endif %},
    "build:all": "electron-builder{% if 'mac' in desktop_platforms %} --mac{% endif %}{% if 'windows' in desktop_platforms %} --win{% endif %}{% if 'linux' in desktop_platforms %} --linux{% endif %}"{% if 'auto_updater' in desktop_features %},
    "publish": "electron-builder --publish always"{% endif %}
  },
  "dependencies": {
    {% if 'auto_updater' in desktop_features %}
    "electron-updater": "^6.3.9",
    {% endif %}
    "electron-log": "^5.2.4",
    "electron-store": "^10.0.0",
    "ipaddr.js": "^2.5.0",
    "zustand": "^5.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@eslint/js": "^10.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@types/node": "^24.9.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "autoprefixer": "^10.4.20",
    "electron": "^45.2.3",
    "electron-builder": "^26.0.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "postcss": "^8.5.1",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "5.1.0"
  }
}
{% endif %}
