{% if desktop_module == "enabled" and desktop_framework == "electron-vite" %}
/**
 * Main Application Component
 *
 * Root React component for the desktop application.
 */

import { useEffect } from 'react';
import { useAppStore{% if 'auto_updater' in desktop_features %}, useUpdateState{% endif %} } from './store';
{% if 'custom_titlebar' in desktop_features %}
import TitleBar from './components/TitleBar';
{% endif %}

function App(): JSX.Element {
  const {
    appInfo,
    theme,
    setAppInfo,
    setTheme,
    incrementCounter,
    counter,
    {% if 'auto_updater' in desktop_features %}
    setUpdateAvailable,
    setUpdateProgress,
    setUpdateDownloaded,
    setUpdateError,
    {% endif %}
  } = useAppStore();
  {% if 'auto_updater' in desktop_features %}
  const update = useUpdateState();
  {% endif %}

  useEffect(() => {
    const init = async (): Promise<void> => {
      const info = await window.api.getAppInfo();
      setAppInfo(info);

      const themeInfo = await window.api.getTheme();
      setTheme(themeInfo.source);

      document.documentElement.classList.toggle(
        'dark',
        themeInfo.shouldUseDarkColors
      );
    };

    void init();

    const unsubscribe = window.api.onThemeChanged((themeInfo) => {
      setTheme(themeInfo.source);
      document.documentElement.classList.toggle(
        'dark',
        themeInfo.shouldUseDarkColors
      );
    });

    return () => {
      unsubscribe();
    };
  }, [setAppInfo, setTheme]);

  useEffect(() => {
    const unsubscribe = window.api.onOpenSettings(() => {
      console.log('Open settings requested');
    });

    return () => {
      unsubscribe();
    };
  }, []);

  useEffect(() => {
    const unsubscribe = window.api.onShowAbout(() => {
      void window.api.showMessageBox({
        type: 'info',
        title: 'About {{ project_name }}',
        message: '{{ project_name }}',
        detail: `Version: ${appInfo?.version || 'unknown'}\nElectron: ${appInfo?.electron || 'unknown'}\nChrome: ${appInfo?.chrome || 'unknown'}\nNode: ${appInfo?.node || 'unknown'}`,
        buttons: ['OK'],
      });
    });

    return () => {
      unsubscribe();
    };
  }, [appInfo]);

  {% if 'auto_updater' in desktop_features %}
  useEffect(() => {
    const unsubAvailable = window.api.onUpdateAvailable((info) => {
      setUpdateAvailable(true, info.version);
    });
    const unsubProgress = window.api.onUpdateProgress((progress) => {
      setUpdateProgress(progress.percent);
    });
    const unsubDownloaded = window.api.onUpdateDownloaded((info) => {
      setUpdateDownloaded(true, info.version);
    });
    const unsubError = window.api.onUpdateError((err) => {
      setUpdateError(err.message);
    });
    const unsubCheck = window.api.onCheckForUpdates(() => {
      void window.api.checkForUpdates();
    });

    return () => {
      unsubAvailable();
      unsubProgress();
      unsubDownloaded();
      unsubError();
      unsubCheck();
    };
  }, [setUpdateAvailable, setUpdateProgress, setUpdateDownloaded, setUpdateError]);
  {% endif %}

  const handleThemeToggle = async (): Promise<void> => {
    const newTheme = theme === 'dark' ? 'light' : theme === 'light' ? 'system' : 'dark';
    await window.api.setTheme(newTheme);
  };

  const handleOpenExternal = async (): Promise<void> => {
    await window.api.openExternal(
      'https://github.com/{{ github_username | default("your-username") }}/{{ project_slug }}'
    );
  };

  return (
    <div className="flex h-screen flex-col bg-surface text-ink">
      {% if 'custom_titlebar' in desktop_features %}
      <TitleBar />
      {% endif %}

      <main className="flex-1 overflow-auto">
        <div className="container mx-auto max-w-4xl px-6 py-8">
          <div className="mb-12 text-center">
            <h1 className="mb-4 bg-gradient-to-r from-accent-400 to-accent-600 bg-clip-text text-4xl font-bold text-transparent">
              {{ project_name }}
            </h1>
            <p className="text-lg text-muted">
              Native desktop application built with Electron + React
            </p>
            {appInfo && (
              <p className="mt-2 text-sm text-muted">
                v{appInfo.version} | Electron {appInfo.electron} | {appInfo.platform}
              </p>
            )}
          </div>

          {% if 'auto_updater' in desktop_features %}
          {(update.available || update.error || update.progress > 0) && (
            <div className="card mb-8 p-4">
              {update.error && (
                <p className="text-sm text-red-600 dark:text-red-400" role="alert">
                  Update error: {update.error}
                </p>
              )}
              {update.available && !update.downloaded && (
                <div role="status" aria-live="polite">
                  <p className="font-medium text-accent-700 dark:text-accent-300">
                    Update {update.version ?? ''} is available
                    {update.progress > 0 ? ` — downloading ${update.progress}%` : ''}
                  </p>
                </div>
              )}
              {update.downloaded && (
                <div className="flex flex-wrap items-center justify-between gap-3" role="status" aria-live="polite">
                  <p className="font-medium text-accent-700 dark:text-accent-300">
                    Version {update.version ?? ''} is ready to install
                  </p>
                  <button
                    type="button"
                    className="btn btn-primary"
                    onClick={() => {
                      void window.api.quitAndInstall();
                    }}
                  >
                    Restart and install
                  </button>
                </div>
              )}
            </div>
          )}
          {% endif %}

          <div className="mb-8 grid grid-cols-1 gap-6 md:grid-cols-2">
            <div className="card p-6">
              <h2 className="mb-4 text-xl font-semibold">State Management</h2>
              <p className="mb-4 text-muted">
                Using Zustand for simple, scalable state management.
              </p>
              <div className="flex items-center gap-4">
                <button type="button" onClick={incrementCounter} className="btn btn-primary">
                  Count: {counter}
                </button>
              </div>
            </div>

            <div className="card p-6">
              <h2 className="mb-4 text-xl font-semibold">Theme</h2>
              <p className="mb-4 text-muted">
                Current theme: <span className="font-mono">{theme}</span>
              </p>
              <button type="button" onClick={() => void handleThemeToggle()} className="btn btn-secondary">
                Toggle Theme
              </button>
            </div>

            <div className="card p-6">
              <h2 className="mb-4 text-xl font-semibold">IPC Communication</h2>
              <p className="mb-4 text-muted">
                Securely communicate with the main process.
              </p>
              <button
                type="button"
                onClick={() => {
                  void window.api
                    .showMessageBox({
                      type: 'info',
                      title: 'IPC Demo',
                      message: 'This dialog was opened via IPC!',
                      buttons: ['OK'],
                    })
                    .then((result) => {
                      console.log('Dialog result:', result);
                    });
                }}
                className="btn btn-primary"
              >
                Show Dialog
              </button>
            </div>

            <div className="card p-6">
              <h2 className="mb-4 text-xl font-semibold">External Links</h2>
              <p className="mb-4 text-muted">
                Open links safely in the default browser.
              </p>
              <button type="button" onClick={() => void handleOpenExternal()} className="btn btn-primary">
                Open GitHub
              </button>
            </div>
          </div>

          <div className="text-center text-sm text-muted">
            <p>
              Edit{' '}
              <code className="rounded bg-surface-muted px-2 py-1 font-mono text-accent-600 dark:text-accent-400">
                src/renderer/App.tsx
              </code>{' '}
              and save to see changes
            </p>
          </div>
        </div>
      </main>
    </div>
  );
}

export default App;
{% endif %}
