{% if project_language == 'rust' or 'rust' in cli_languages or 'rust' in api_languages or 'rust' in mcp_languages %}
{%- set _has_cli = cli_module == 'enabled' and 'rust' in cli_languages -%}
{%- set _has_api = api_module == 'enabled' and 'rust' in api_languages -%}
{%- set _has_mcp = mcp_module == 'enabled' and 'rust' in mcp_languages -%}
{%- set _has_bins = _has_cli or _has_api -%}
[package]
name = "{{ package_name }}"
version = "0.1.0"
edition = "2021"
description = "{{ project_description }}"
authors = ["{{ author_name|default('Riso Maintainer', true) }}"]
license = "MIT"
rust-version = "1.81"
{% if _has_bins %}
# Explicit [[bin]] entries below; do not auto-discover src/main.rs
autobins = false
{% endif %}

{% if _has_mcp %}
# Only list crates that have their own Cargo.toml. CLI/API are root [[bin]]
# paths (cli/main.rs, api/main.rs), not workspace members.
[workspace]
members = ["mcp"]
resolver = "2"
{% endif %}

[dependencies]
# Core dependencies
tokio = { version = "1.40", features = ["full"] }
anyhow = "1.0"
serde = { version = "1.0", features = ["derive"] }
serde_json = "1.0"

# Logging
tracing = "0.1"
tracing-subscriber = { version = "0.3", features = ["env-filter"] }

{% if _has_cli %}
# CLI dependencies
clap = { version = "4.5", features = ["derive", "env"] }
colored = "2.1"
{% endif %}

{% if _has_api %}
# API dependencies (Actix-web + Tokio)
actix-web = "4.9"
actix-cors = "0.7"
chrono = { version = "0.4", features = ["serde"] }
{% endif %}

[dev-dependencies]
tokio-test = "0.4"
pretty_assertions = "1.4"
{% if _has_api %}
# actix-web provides #[actix_web::test] and actix_web::test helpers
{% endif %}

{% if _has_cli %}
[[bin]]
name = "{{ package_name }}"
path = "cli/main.rs"
{% endif %}

{% if _has_api %}
[[bin]]
name = "{{ package_name }}-api"
path = "api/main.rs"
{% endif %}

[profile.release]
strip = true
lto = true
codegen-units = 1

# Optimize for size in release builds
[profile.release.package."*"]
opt-level = "z"
{% endif %}
