{% if project_language == 'rust' or 'rust' in cli_languages or 'rust' in api_languages or 'rust' in mcp_languages %}
{%- set _has_mcp = mcp_module == 'enabled' and 'rust' in mcp_languages -%}
# {{ project_name }} Makefile
# Rust project — generated by Riso template

.PHONY: build test quality fmt fmt-check clippy clippy-all release clean update outdated audit help
{% if cli_module == 'enabled' and 'rust' in cli_languages %}
.PHONY: run-cli build-cli
{% endif %}
{% if api_module == 'enabled' and 'rust' in api_languages %}
.PHONY: run-api build-api run-api-dev
{% endif %}
{% if _has_mcp %}
.PHONY: run-mcp build-mcp
{% endif %}

build:
{% if _has_mcp %}
	cargo build --workspace
{% else %}
	cargo build
{% endif %}

{% if cli_module == 'enabled' and 'rust' in cli_languages %}
run-cli:
	cargo run --bin {{ package_name }} -- $(ARGS)

build-cli:
	cargo build --release --bin {{ package_name }}
{% endif %}

{% if api_module == 'enabled' and 'rust' in api_languages %}
run-api:
	cargo run --bin {{ package_name }}-api

build-api:
	cargo build --release --bin {{ package_name }}-api

run-api-dev:
	RUST_LOG=debug HOST=127.0.0.1 PORT=8080 cargo run --bin {{ package_name }}-api
{% endif %}

{% if _has_mcp %}
run-mcp:
	cargo run --manifest-path mcp/Cargo.toml -- --transport stdio

build-mcp:
	cargo build --release --manifest-path mcp/Cargo.toml
{% endif %}

test:
{% if _has_mcp %}
	cargo test --workspace
{% else %}
	cargo test
{% endif %}

test-verbose:
{% if _has_mcp %}
	cargo test --workspace -- --nocapture
{% else %}
	cargo test -- --nocapture
{% endif %}

quality: fmt-check clippy test

fmt:
{% if _has_mcp %}
	cargo fmt --all
{% else %}
	cargo fmt
{% endif %}

fmt-check:
{% if _has_mcp %}
	cargo fmt --all -- --check
{% else %}
	cargo fmt -- --check
{% endif %}

clippy:
{% if _has_mcp %}
	cargo clippy --workspace -- -D warnings
{% else %}
	cargo clippy -- -D warnings
{% endif %}

clippy-all:
{% if _has_mcp %}
	cargo clippy --workspace --all-features -- -D warnings
{% else %}
	cargo clippy --all-features -- -D warnings
{% endif %}

release:
{% if _has_mcp %}
	cargo build --workspace --release
{% else %}
	cargo build --release
{% endif %}

clean:
	cargo clean

update:
	cargo update

outdated:
	cargo outdated

audit:
	cargo audit

help:
	@echo "Available targets:"
	@echo "  build, test, quality, fmt, clippy, release, clean"
{% if cli_module == 'enabled' and 'rust' in cli_languages %}
	@echo "  run-cli, build-cli"
{% endif %}
{% if api_module == 'enabled' and 'rust' in api_languages %}
	@echo "  run-api, build-api, run-api-dev"
{% endif %}
{% if _has_mcp %}
	@echo "  run-mcp, build-mcp"
{% endif %}
{% endif %}
