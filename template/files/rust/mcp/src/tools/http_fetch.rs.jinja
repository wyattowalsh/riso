//! HTTP fetch tool helpers (https-only).

use rmcp::schemars;
use serde::{Deserialize, Serialize};
use std::collections::HashMap;
use std::time::Duration;

#[derive(Debug, Deserialize, schemars::JsonSchema)]
pub struct HttpGetParams {
    pub url: String,
    #[serde(default)]
    pub headers: HashMap<String, String>,
    #[serde(default = "default_timeout")]
    pub timeout: u64,
}

fn default_timeout() -> u64 {
    30
}

#[derive(Debug, Serialize)]
pub struct HttpResult {
    pub success: bool,
    pub status_code: Option<u16>,
    pub headers: Option<HashMap<String, String>>,
    pub content: Option<String>,
    pub content_length: Option<usize>,
    pub error: Option<String>,
}

fn deny_url(url: &str) -> Option<&'static str> {
    let lower = url.to_ascii_lowercase();
    if !lower.starts_with("https://") {
        return Some("only https:// URLs are allowed");
    }
    for blocked in [
        "localhost",
        "127.0.0.1",
        "0.0.0.0",
        "::1",
        "169.254.169.254",
        "metadata.google",
        "[::1]",
    ] {
        if lower.contains(blocked) {
            return Some("URL host is not allowed (SSRF protection)");
        }
    }
    None
}

pub async fn http_get(params: HttpGetParams) -> Result<HttpResult, String> {
    if let Some(err) = deny_url(&params.url) {
        return Ok(HttpResult {
            success: false,
            status_code: None,
            headers: None,
            content: None,
            content_length: None,
            error: Some(err.to_string()),
        });
    }

    let client = reqwest::Client::builder()
        .timeout(Duration::from_secs(params.timeout))
        .redirect(reqwest::redirect::Policy::none())
        .build()
        .map_err(|e| e.to_string())?;

    let mut request = client.get(&params.url);
    for (key, value) in params.headers {
        request = request.header(&key, &value);
    }

    match request.send().await {
        Ok(response) => {
            let status = response.status().as_u16();
            let headers: HashMap<String, String> = response
                .headers()
                .iter()
                .map(|(k, v)| (k.to_string(), v.to_str().unwrap_or("").to_string()))
                .collect();

            match response.text().await {
                Ok(content) => {
                    let len = content.len();
                    let truncated = if len > 10000 {
                        content[..10000].to_string()
                    } else {
                        content
                    };
                    Ok(HttpResult {
                        success: true,
                        status_code: Some(status),
                        headers: Some(headers),
                        content: Some(truncated),
                        content_length: Some(len),
                        error: None,
                    })
                }
                Err(e) => Ok(HttpResult {
                    success: false,
                    status_code: Some(status),
                    headers: Some(headers),
                    content: None,
                    content_length: None,
                    error: Some(e.to_string()),
                }),
            }
        }
        Err(e) => Ok(HttpResult {
            success: false,
            status_code: None,
            headers: None,
            content: None,
            content_length: None,
            error: Some(if e.is_timeout() {
                "Request timed out".to_string()
            } else {
                e.to_string()
            }),
        }),
    }
}

#[derive(Debug, Deserialize, schemars::JsonSchema)]
pub struct HttpHeadParams {
    pub url: String,
    #[serde(default)]
    pub headers: HashMap<String, String>,
    #[serde(default = "default_timeout")]
    pub timeout: u64,
}

#[derive(Debug, Serialize)]
pub struct HttpHeadResult {
    pub success: bool,
    pub status_code: Option<u16>,
    pub headers: Option<HashMap<String, String>>,
    pub content_type: Option<String>,
    pub content_length: Option<String>,
    pub error: Option<String>,
}

pub async fn http_head(params: HttpHeadParams) -> Result<HttpHeadResult, String> {
    if let Some(err) = deny_url(&params.url) {
        return Ok(HttpHeadResult {
            success: false,
            status_code: None,
            headers: None,
            content_type: None,
            content_length: None,
            error: Some(err.to_string()),
        });
    }

    let client = reqwest::Client::builder()
        .timeout(Duration::from_secs(params.timeout))
        .redirect(reqwest::redirect::Policy::none())
        .build()
        .map_err(|e| e.to_string())?;

    let mut request = client.head(&params.url);
    for (key, value) in params.headers {
        request = request.header(&key, &value);
    }

    match request.send().await {
        Ok(response) => {
            let status = response.status().as_u16();
            let headers: HashMap<String, String> = response
                .headers()
                .iter()
                .map(|(k, v)| (k.to_string(), v.to_str().unwrap_or("").to_string()))
                .collect();
            let content_type = headers.get("content-type").cloned();
            let content_length = headers.get("content-length").cloned();
            Ok(HttpHeadResult {
                success: true,
                status_code: Some(status),
                headers: Some(headers),
                content_type,
                content_length,
                error: None,
            })
        }
        Err(e) => Ok(HttpHeadResult {
            success: false,
            status_code: None,
            headers: None,
            content_type: None,
            content_length: None,
            error: Some(e.to_string()),
        }),
    }
}
{%- endif %}
