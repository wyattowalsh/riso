//! Timestamp tool helpers.

use chrono::{DateTime, Datelike, TimeZone, Timelike, Utc};
use rmcp::schemars;
use serde::{Deserialize, Serialize};

#[derive(Debug, Deserialize, schemars::JsonSchema)]
pub struct GetTimeParams {
    #[serde(default = "default_format")]
    pub format: String,
}

fn default_format() -> String {
    "iso".to_string()
}

#[derive(Debug, Serialize)]
pub struct TimeResult {
    pub timestamp: String,
    pub format: String,
    pub unix: i64,
}

pub fn get_current_time(params: &GetTimeParams) -> TimeResult {
    let now = Utc::now();
    let timestamp = match params.format.as_str() {
        "iso" => now.to_rfc3339(),
        "unix" => now.timestamp().to_string(),
        "rfc2822" => now.to_rfc2822(),
        "human" => now.format("%B %d, %Y at %I:%M %p UTC").to_string(),
        _ => now.to_rfc3339(),
    };

    TimeResult {
        timestamp,
        format: params.format.clone(),
        unix: now.timestamp(),
    }
}

#[derive(Debug, Deserialize, schemars::JsonSchema)]
pub struct ParseParams {
    pub timestamp: String,
    #[serde(default = "default_format")]
    pub input_format: String,
}

#[derive(Debug, Serialize)]
pub struct ParseResult {
    pub success: bool,
    pub year: Option<i32>,
    pub month: Option<u32>,
    pub day: Option<u32>,
    pub hour: Option<u32>,
    pub minute: Option<u32>,
    pub second: Option<u32>,
    pub iso: Option<String>,
    pub error: Option<String>,
}

pub fn parse_timestamp(params: &ParseParams) -> ParseResult {
    let result = if params.input_format == "unix" {
        params
            .timestamp
            .parse::<i64>()
            .ok()
            .and_then(|ts| Utc.timestamp_opt(ts, 0).single())
    } else {
        DateTime::parse_from_rfc3339(&params.timestamp)
            .ok()
            .map(|dt| dt.with_timezone(&Utc))
    };

    match result {
        Some(dt) => ParseResult {
            success: true,
            year: Some(dt.year()),
            month: Some(dt.month()),
            day: Some(dt.day()),
            hour: Some(dt.hour()),
            minute: Some(dt.minute()),
            second: Some(dt.second()),
            iso: Some(dt.to_rfc3339()),
            error: None,
        },
        None => ParseResult {
            success: false,
            year: None,
            month: None,
            day: None,
            hour: None,
            minute: None,
            second: None,
            iso: None,
            error: Some("Failed to parse timestamp".to_string()),
        },
    }
}
{%- endif %}
