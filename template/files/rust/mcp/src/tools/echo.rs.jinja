{%- if mcp_module == 'enabled' and 'rust' in mcp_languages and mcp_example_tools -%}
//! Echo tool helpers.

use rmcp::schemars;
use serde::{Deserialize, Serialize};

#[derive(Debug, Deserialize, schemars::JsonSchema)]
pub struct EchoParams {
    /// The message to echo back
    pub message: String,
}

#[derive(Debug, Serialize)]
pub struct EchoResult {
    pub message: String,
}

pub fn echo(params: &EchoParams) -> EchoResult {
    EchoResult {
        message: params.message.clone(),
    }
}

pub fn echo_reverse(params: &EchoParams) -> EchoResult {
    EchoResult {
        message: params.message.chars().rev().collect(),
    }
}

pub fn echo_uppercase(params: &EchoParams) -> EchoResult {
    EchoResult {
        message: params.message.to_uppercase(),
    }
}
{%- endif %}
