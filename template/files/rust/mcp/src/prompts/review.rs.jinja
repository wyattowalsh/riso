{%- if mcp_module == 'enabled' and 'rust' in mcp_languages and mcp_example_tools -%}
//! Review prompt helpers.

use rmcp::{model::*, schemars};
use serde::Deserialize;

#[derive(Debug, Deserialize, schemars::JsonSchema)]
pub struct ReviewParams {
    pub code: String,
    pub language: Option<String>,
}

pub fn review_code(params: &ReviewParams) -> GetPromptResult {
    let language = params.language.clone().unwrap_or_else(|| "rust".to_string());
    let text = format!(
        "Please review the following {} code for:\n\
        1. Bugs and potential runtime errors\n\
        2. Security vulnerabilities\n\
        3. Performance optimization opportunities\n\
        4. Code style and best practices conformance\n\
        \n\
        Code to review:\n\
        ```{}\n\
        {}\n\
        ```",
        language, language, params.code
    );

    GetPromptResult {
        description: Some(format!("Code review prompt for {language}")),
        messages: vec![PromptMessage::new_text(PromptMessageRole::User, text)],
    }
}
{%- endif %}
