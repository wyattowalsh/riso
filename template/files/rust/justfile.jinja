{% if project_language == 'rust' or 'rust' in cli_languages or 'rust' in api_languages or 'rust' in mcp_languages %}
{%- set _has_mcp = mcp_module == 'enabled' and 'rust' in mcp_languages -%}
set shell := ["bash", "-eu", "-o", "pipefail", "-c"]

# Build the project
build:
{% if _has_mcp %}
    cargo build --workspace
{% else %}
    cargo build
{% endif %}

{% if cli_module == 'enabled' and 'rust' in cli_languages %}
# Run the CLI
run-cli *ARGS:
    cargo run --bin {{ package_name }} -- {% raw %}{{ARGS}}{% endraw %}

# Build CLI for release
build-cli:
    cargo build --release --bin {{ package_name }}
{% endif %}

{% if api_module == 'enabled' and 'rust' in api_languages %}
# Run the API server
run-api:
    cargo run --bin {{ package_name }}-api

# Build API for release
build-api:
    cargo build --release --bin {{ package_name }}-api

# Run API with environment variables
run-api-dev:
    RUST_LOG=debug HOST=127.0.0.1 PORT=8080 cargo run --bin {{ package_name }}-api
{% endif %}

{% if _has_mcp %}
# Run MCP server (stdio)
run-mcp:
    cargo run --manifest-path mcp/Cargo.toml -- --transport stdio

# Build MCP for release
build-mcp:
    cargo build --release --manifest-path mcp/Cargo.toml
{% endif %}

# Run tests
test:
{% if _has_mcp %}
    cargo test --workspace
{% else %}
    cargo test
{% endif %}

# Run tests with output
test-verbose:
{% if _has_mcp %}
    cargo test --workspace -- --nocapture
{% else %}
    cargo test -- --nocapture
{% endif %}

# Check code quality (fmt + clippy + test)
quality: fmt-check clippy test

# Format code
fmt:
{% if _has_mcp %}
    cargo fmt --all
{% else %}
    cargo fmt
{% endif %}

# Check formatting
fmt-check:
{% if _has_mcp %}
    cargo fmt --all -- --check
{% else %}
    cargo fmt -- --check
{% endif %}

# Run clippy
clippy:
{% if _has_mcp %}
    cargo clippy --workspace -- -D warnings
{% else %}
    cargo clippy -- -D warnings
{% endif %}

# Run clippy with all features
clippy-all:
{% if _has_mcp %}
    cargo clippy --workspace --all-features -- -D warnings
{% else %}
    cargo clippy --all-features -- -D warnings
{% endif %}

# Build for release
release:
{% if _has_mcp %}
    cargo build --workspace --release
{% else %}
    cargo build --release
{% endif %}

# Clean build artifacts
clean:
    cargo clean

# Update dependencies
update:
    cargo update

# Check for outdated dependencies
outdated:
    cargo outdated

# Security audit
audit:
    cargo audit
{% endif %}
