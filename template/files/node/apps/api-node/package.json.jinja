{%- if api_module == 'enabled' and 'node' in api_languages -%}
{%- set _entry = 'dist/apps/api-node/src/main.js' if shared_logic | lower == 'enabled' else 'dist/main.js' -%}
{
  "name": "api-node",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "{{ project_name }} Node.js API",
  "main": "{{ _entry }}",
  "files": ["dist"],
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node {{ _entry }}",
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "fastify": "^5.12.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.8",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.17"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  }
}
{%- endif -%}
