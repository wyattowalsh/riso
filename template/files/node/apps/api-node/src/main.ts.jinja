{%- if api_module != 'enabled' or 'node' not in api_languages %}
export async function buildServer() {
  throw new Error("Node API track disabled for this render.");
}
{%- else %}
import path from "node:path";
import { fileURLToPath } from "node:url";

import Fastify from "fastify";

import type { ApiNodeConfig } from "./config";
import { loadConfig } from "./config";
import { registerHealthRoutes } from "./health";
{%- if shared_logic | lower == "enabled" %}
import { sharedLogicEnabled, summarizeStatus } from "../../../shared-config/logic";
{%- endif %}

function createServer(config: ApiNodeConfig) {
  const server = Fastify({
    logger: true,
  });

  // Register container health check endpoint
  registerHealthRoutes(server);
{%- if shared_logic | lower == "enabled" %}
  if (sharedLogicEnabled()) {
    server.log.info(
      summarizeStatus({ status: "healthy", service: config.serviceName })
    );
  }
{%- endif %}

  return server;
}

export async function buildServer() {
  const config = loadConfig();
  const server = createServer(config);
  return server;
}

export async function start() {
  const config = loadConfig();
  const server = createServer(config);
  await server.listen({ host: config.host, port: config.port });
  return server;
}

if (
  process.argv[1] &&
  path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)
) {
  start().catch((error: unknown) => {
    console.error(error);
    process.exit(1);
  });
}
{%- endif %}
