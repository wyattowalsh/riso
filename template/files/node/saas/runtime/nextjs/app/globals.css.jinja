{% if saas_infra_module == "enabled" and saas_runtime == "nextjs-16" %}
{% if saas_ui_framework == "shadcn-ui" %}
@import 'tailwindcss';
@import 'tw-animate-css';

@source '../../../components/**/*.{ts,tsx}';
@source '../../../integrations/**/*.{ts,tsx}';
@source '../**/*.{ts,tsx}';

@custom-variant dark (&:is(.dark *));

/* DESIGN.md tokens — teal accent, not zinc/infima blue. HSL channels for hsl(var(--*)). */
:root {
  color-scheme: light;
  --background: 210 40% 98%;
  --foreground: 226 59% 11%;
  --card: 0 0% 100%;
  --card-foreground: 226 59% 11%;
  --popover: 0 0% 100%;
  --popover-foreground: 226 59% 11%;
  --primary: 173 80% 40%;
  --primary-foreground: 0 0% 98%;
  --secondary: 210 40% 96%;
  --secondary-foreground: 226 59% 11%;
  --muted: 210 40% 96%;
  --muted-foreground: 215 16% 37%;
  --accent: 173 80% 40%;
  --accent-foreground: 0 0% 98%;
  --destructive: 0 84% 50%;
  --destructive-foreground: 0 0% 98%;
  --border: 214 32% 84%;
  --input: 214 32% 84%;
  --ring: 173 80% 32%;
  --radius: 0.5rem;
  --sidebar: 0 0% 100%;
  --sidebar-foreground: 226 59% 11%;
  --sidebar-primary: 173 80% 40%;
  --sidebar-primary-foreground: 0 0% 98%;
  --sidebar-accent: 210 40% 96%;
  --sidebar-accent-foreground: 226 59% 11%;
  --sidebar-border: 214 32% 84%;
  --sidebar-ring: 173 80% 32%;
  --focus-ring: #14b8a6;
  --motion-color: 150ms ease-out;
  --motion-layout: 250ms ease-out;
  --font-sans: Inter, ui-sans-serif, system-ui, sans-serif;
  --font-mono: 'JetBrains Mono', ui-monospace, monospace;
}

.dark {
  color-scheme: dark;
  --background: 222 47% 4%;
  --foreground: 214 32% 91%;
  --card: 222 47% 11%;
  --card-foreground: 214 32% 91%;
  --popover: 222 47% 11%;
  --popover-foreground: 214 32% 91%;
  --primary: 173 80% 40%;
  --primary-foreground: 222 47% 6%;
  --secondary: 217 33% 17%;
  --secondary-foreground: 214 32% 91%;
  --muted: 217 33% 17%;
  --muted-foreground: 215 16% 65%;
  --accent: 173 80% 40%;
  --accent-foreground: 222 47% 6%;
  --destructive: 0 63% 45%;
  --destructive-foreground: 0 0% 98%;
  --border: 217 33% 22%;
  --input: 217 33% 22%;
  --ring: 173 70% 50%;
  --sidebar: 222 47% 11%;
  --sidebar-foreground: 214 32% 91%;
  --sidebar-primary: 173 80% 40%;
  --sidebar-primary-foreground: 222 47% 6%;
  --sidebar-accent: 217 33% 17%;
  --sidebar-accent-foreground: 214 32% 91%;
  --sidebar-border: 217 33% 22%;
  --sidebar-ring: 173 70% 50%;
}

@theme inline {
  --color-background: hsl(var(--background));
  --color-foreground: hsl(var(--foreground));
  --color-card: hsl(var(--card));
  --color-card-foreground: hsl(var(--card-foreground));
  --color-popover: hsl(var(--popover));
  --color-popover-foreground: hsl(var(--popover-foreground));
  --color-primary: hsl(var(--primary));
  --color-primary-foreground: hsl(var(--primary-foreground));
  --color-secondary: hsl(var(--secondary));
  --color-secondary-foreground: hsl(var(--secondary-foreground));
  --color-muted: hsl(var(--muted));
  --color-muted-foreground: hsl(var(--muted-foreground));
  --color-accent: hsl(var(--accent));
  --color-accent-foreground: hsl(var(--accent-foreground));
  --color-destructive: hsl(var(--destructive));
  --color-destructive-foreground: hsl(var(--destructive-foreground));
  --color-border: hsl(var(--border));
  --color-input: hsl(var(--input));
  --color-ring: hsl(var(--ring));
  --color-sidebar: hsl(var(--sidebar));
  --color-sidebar-foreground: hsl(var(--sidebar-foreground));
  --color-sidebar-primary: hsl(var(--sidebar-primary));
  --color-sidebar-primary-foreground: hsl(var(--sidebar-primary-foreground));
  --color-sidebar-accent: hsl(var(--sidebar-accent));
  --color-sidebar-accent-foreground: hsl(var(--sidebar-accent-foreground));
  --color-sidebar-border: hsl(var(--sidebar-border));
  --color-sidebar-ring: hsl(var(--sidebar-ring));
  --radius-sm: calc(var(--radius) - 4px);
  --radius-md: calc(var(--radius) - 2px);
  --radius-lg: var(--radius);
  --radius-xl: calc(var(--radius) + 4px);
}

@layer base {
  * {
    @apply border-border;
  }
  html {
    scroll-behavior: smooth;
  }
  body {
    @apply bg-background text-foreground;
    font-family: var(--font-sans);
  }
  :focus-visible {
    outline: 2px solid var(--focus-ring);
    outline-offset: 2px;
  }
  .skip-link {
    position: absolute;
    left: 0.75rem;
    top: 0.75rem;
    z-index: 100;
    transform: translateY(-220%);
    border-radius: var(--radius);
    background: hsl(var(--primary));
    color: hsl(var(--primary-foreground));
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
    font-weight: 600;
  }
  .skip-link:focus {
    transform: translateY(0);
  }
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}
{% else %}
@tailwind base;
@tailwind components;
@tailwind utilities;

:root {
  color-scheme: light;
  --paper: #f8fafc;
  --surface: #ffffff;
  --text: #0b132b;
  --text-muted: #334155;
  --border: #cbd5e1;
  --accent: #14b8a6;
  --accent-text: #0f766e;
  --focus-ring: #14b8a6;
}

@media (prefers-color-scheme: dark) {
  :root {
    color-scheme: dark;
    --paper: #020617;
    --surface: #0f172a;
    --text: #e2e8f0;
    --text-muted: #94a3b8;
    --border: #334155;
    --accent: #14b8a6;
    --accent-text: #5eead4;
  }
}

body {
  color: var(--text);
  background: var(--paper);
}

:focus-visible {
  outline: 2px solid var(--focus-ring);
  outline-offset: 2px;
}

.skip-link {
  position: absolute;
  left: 0.75rem;
  top: 0.75rem;
  z-index: 100;
  transform: translateY(-220%);
  border-radius: 0.5rem;
  background: var(--accent);
  color: #f8fafc;
  padding: 0.5rem 0.75rem;
  font-size: 0.875rem;
  font-weight: 600;
}

.skip-link:focus {
  transform: translateY(0);
}

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}

@layer utilities {
  .text-balance {
    text-wrap: balance;
  }
}
{% endif %}
{% endif %}
