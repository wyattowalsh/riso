{% if saas_infra_module == "enabled" and saas_runtime == "nextjs-16" %}
import type { Metadata } from 'next';
import { Inter, JetBrains_Mono } from 'next/font/google';
import './globals.css';
{% if saas_auth_provider == 'clerk' %}
import { ClerkProvider } from '@clerk/nextjs';
{% elif saas_auth_provider == 'authjs' %}
import { SessionProvider } from 'next-auth/react';
{% endif %}
{% if saas_analytics == 'posthog' %}
import { PostHogProvider } from '@/lib/analytics/posthog-provider';
{% elif saas_analytics == 'amplitude' %}
import { AmplitudeProvider } from '@/lib/analytics/amplitude-provider';
{% endif %}

const inter = Inter({ subsets: ['latin'], variable: '--font-sans' });
const jetbrainsMono = JetBrains_Mono({
  subsets: ['latin'],
  variable: '--font-mono',
});

export const metadata: Metadata = {
  title: '{{ project_name }}',
  description: 'Production-ready SaaS application',
};

export default function RootLayout({
  children,
}: {
  children: React.ReactNode;
}) {
  const bodyClass = `${inter.variable} ${jetbrainsMono.variable} ${inter.className}`;
  return (
    {% if saas_auth_provider == 'clerk' %}
    <ClerkProvider>
      <html lang="en">
        <body className={bodyClass}>
          <a href="#main-content" className="skip-link">
            Skip to content
          </a>
          <div id="main-content" tabIndex={-1}>
          {% if saas_analytics == 'posthog' %}
          <PostHogProvider>
            {children}
          </PostHogProvider>
          {% elif saas_analytics == 'amplitude' %}
          <AmplitudeProvider>
            {children}
          </AmplitudeProvider>
          {% else %}
          {children}
          {% endif %}
          </div>
        </body>
      </html>
    </ClerkProvider>
    {% elif saas_auth_provider == 'authjs' %}
    <html lang="en">
      <body className={bodyClass}>
        <a href="#main-content" className="skip-link">
          Skip to content
        </a>
        <div id="main-content" tabIndex={-1}>
        <SessionProvider>
          {% if saas_analytics == 'posthog' %}
          <PostHogProvider>
            {children}
          </PostHogProvider>
          {% elif saas_analytics == 'amplitude' %}
          <AmplitudeProvider>
            {children}
          </AmplitudeProvider>
          {% else %}
          {children}
          {% endif %}
        </SessionProvider>
        </div>
      </body>
    </html>
    {% else %}
    <html lang="en">
      <body className={bodyClass}>
        <a href="#main-content" className="skip-link">
          Skip to content
        </a>
        <div id="main-content" tabIndex={-1}>
        {% if saas_analytics == 'posthog' %}
        <PostHogProvider>
          {children}
        </PostHogProvider>
        {% elif saas_analytics == 'amplitude' %}
        <AmplitudeProvider>
          {children}
        </AmplitudeProvider>
        {% else %}
        {children}
        {% endif %}
        </div>
      </body>
    </html>
    {% endif %}
  );
}
{% endif %}
