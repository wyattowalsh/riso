{% if saas_infra_module == "enabled" and saas_ui_framework == "shadcn-ui" %}
{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "new-york",
  "rsc": {% if saas_runtime == "nextjs-16" %}true{% else %}false{% endif %},
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "{% if saas_runtime == 'nextjs-16' %}runtime/nextjs/app/globals.css{% else %}runtime/remix/app/styles/globals.css{% endif %}",
    "baseColor": "zinc",
    "cssVariables": true,
    "prefix": ""
  },
  "aliases": {
    "components": "@/components",
    "utils": "@/lib/utils",
    "ui": "@/components/ui",
    "lib": "@/lib",
    "hooks": "@/hooks"
  },
  "iconLibrary": "lucide"
}
{% endif %}