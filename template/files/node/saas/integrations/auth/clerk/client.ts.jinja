{% if saas_infra_module == "enabled" and saas_auth_module == "enabled" and saas_auth_provider == "clerk" %}
/**
 * Clerk Authentication Client — runtime-aware (Next.js 16 / Remix 2)
 */

{% if saas_runtime == "nextjs-16" %}
import { auth, currentUser, clerkClient } from '@clerk/nextjs/server';
import type { WebhookEvent } from '@clerk/nextjs/server';
import { Webhook } from 'svix';

export async function requireAuth() {
  const session = await auth();
  if (!session.userId) throw new Error('Unauthorized');
  return session;
}

export async function getCurrentUser() {
  const user = await currentUser();
  if (!user) throw new Error('Unauthorized');
  return user;
}

export async function getCurrentOrganization() {
  const { orgId } = await auth();
  if (!orgId) return null;
  return await clerkClient().organizations.getOrganization({ organizationId: orgId });
}

export async function hasOrganizationRole(allowedRoles: string[]) {
  const { orgRole } = await auth();
  return !!orgRole && allowedRoles.includes(orgRole);
}

export async function createOrganization(params: {
  name: string;
  slug?: string;
  publicMetadata?: Record<string, unknown>;
}) {
  return await clerkClient().organizations.createOrganization(params);
}

export async function inviteToOrganization(params: {
  organizationId: string;
  emailAddress: string;
  role: 'admin' | 'basic_member' | 'org:admin' | 'org:member';
}) {
  return await clerkClient().organizations.createOrganizationInvitation(params);
}

export async function removeFromOrganization(params: {
  organizationId: string;
  userId: string;
}) {
  return await clerkClient().organizations.deleteOrganizationMembership(params);
}

export async function getUserById(userId: string) {
  return await clerkClient().users.getUser(userId);
}

export async function updateUserMetadata(
  userId: string,
  metadata: {
    publicMetadata?: Record<string, unknown>;
    privateMetadata?: Record<string, unknown>;
    unsafeMetadata?: Record<string, unknown>;
  }
) {
  return await clerkClient().users.updateUser(userId, metadata);
}

export async function deleteUser(userId: string) {
  return await clerkClient().users.deleteUser(userId);
}

export async function verifyWebhook(
  payload: string,
  headers: {
    'svix-id': string;
    'svix-timestamp': string;
    'svix-signature': string;
  }
): Promise<WebhookEvent> {
  const webhookSecret = process.env.CLERK_WEBHOOK_SECRET;
  if (!webhookSecret) throw new Error('CLERK_WEBHOOK_SECRET is not set');
  return new Webhook(webhookSecret).verify(payload, headers) as WebhookEvent;
}

export type { User, Organization, OrganizationMembership, Session } from '@clerk/nextjs/server';

{% else %}
import type { LoaderFunctionArgs, ActionFunctionArgs } from '@remix-run/node';
import { getAuth } from '@clerk/remix/ssr.server';
import { createClerkClient } from '@clerk/backend';
import { Webhook } from 'svix';

type ClerkArgs = LoaderFunctionArgs | ActionFunctionArgs;

export const clerkClient = createClerkClient({
  secretKey: process.env.CLERK_SECRET_KEY!,
});

export async function requireAuth(args: ClerkArgs) {
  const session = await getAuth(args);
  if (!session.userId) throw new Error('Unauthorized');
  return session;
}

export async function getCurrentUser(args: ClerkArgs) {
  const { userId } = await getAuth(args);
  if (!userId) throw new Error('Unauthorized');
