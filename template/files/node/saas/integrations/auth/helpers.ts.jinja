{% if saas_infra_module == "enabled" and saas_auth_module == "enabled" %}
/**
 * Authentication Helper Functions
 *
 * Unified authentication utilities that work across auth providers.
 * Runtime-aware Clerk wiring for Next.js 16 and Remix 2.
 */

{% if saas_auth_provider == "clerk" and saas_runtime == "nextjs-16" %}
import { auth, currentUser } from '@clerk/nextjs/server';

export async function getSession() {
  const session = await auth();
  return session.userId ? { userId: session.userId } : null;
}

export async function getUser() {
  return await currentUser();
}

export async function getUserId() {
  const { userId } = await auth();
  return userId;
}

export async function requireUser() {
  const user = await currentUser();
  if (!user) {
    throw new Error('Unauthorized: No user session');
  }
  return user;
}

export async function requireUserId() {
  const { userId } = await auth();
  if (!userId) {
    throw new Error('Unauthorized: No user session');
  }
  return userId;
}

export async function getOrganizationId() {
  const { orgId } = await auth();
  return orgId;
}

export async function requireOrganizationId() {
  const { orgId } = await auth();
  if (!orgId) {
    throw new Error('Organization context required');
  }
  return orgId;
}

export async function hasPermission(permission: string) {
  const { has } = await auth();
  return has({ permission });
}

export async function hasRole(role: 'org:admin' | 'admin' | 'org:member') {
  const { has } = await auth();
  return has({ role });
}

export async function requireAdminRole(): Promise<void> {
  const allowed = (await hasRole('org:admin')) || (await hasRole('admin'));
  if (!allowed) {
    throw new ForbiddenError('Admin role required');
  }
}

export async function isAuthenticated() {
  const { userId } = await auth();
  return !!userId;
}

export async function getUserEmail() {
  const user = await currentUser();
  return user?.emailAddresses[0]?.emailAddress ?? null;
}

export async function getUserDisplayName() {
  const user = await currentUser();
  return user?.firstName
    ? `${user.firstName} ${user.lastName || ''}`.trim()
    : user?.emailAddresses[0]?.emailAddress ?? 'User';
}

{% elif saas_auth_provider == "clerk" and saas_runtime == "remix-2" %}
import type { LoaderFunctionArgs, ActionFunctionArgs } from '@remix-run/node';
import { getAuth } from '@clerk/remix/ssr.server';
import { createClerkClient } from '@clerk/backend';

type ClerkArgs = LoaderFunctionArgs | ActionFunctionArgs;

export const clerkClient = createClerkClient({
  secretKey: process.env.CLERK_SECRET_KEY!,
});

export async function getSession(args: ClerkArgs) {
  const session = await getAuth(args);
  return session.userId ? { userId: session.userId } : null;
}

export async function getUser(args: ClerkArgs) {
  const { userId } = await getAuth(args);
  if (!userId) return null;
  return await clerkClient.users.getUser(userId);
}

export async function getUserId(args: ClerkArgs) {
  const { userId } = await getAuth(args);
  return userId;
}

export async function requireUser(args: ClerkArgs) {
  const user = await getUser(args);
  if (!user) {
    throw new Error('Unauthorized: No user session');
  }
  return user;
}

export async function requireUserId(args: ClerkArgs) {
  const userId = await getUserId(args);
  if (!userId) {
    throw new Error('Unauthorized: No user session');
  }
  return userId;
}

export async function getOrganizationId(args: ClerkArgs) {
  const { orgId } = await getAuth(args);
  return orgId;
}

export async function requireOrganizationId(args: ClerkArgs) {
  const { orgId } = await getAuth(args);
  if (!orgId) {
    throw new Error('Organization context required');
  }
  return orgId;
}

export async function hasRole(args: ClerkArgs, role: string) {
  const { orgRole } = await getAuth(args);
  return orgRole === role;
}

export async function requireAdminRole(args: ClerkArgs): Promise<void> {
  const allowed =
    (await hasRole(args, 'org:admin')) || (await hasRole(args, 'admin'));
  if (!allowed) {
    throw new ForbiddenError('Admin role required');
  }
}

export async function isAuthenticated(args: ClerkArgs) {
  const { userId } = await getAuth(args);
  return !!userId;
}

export async function getUserEmail(args: ClerkArgs) {
  const user = await getUser(args);
  return user?.emailAddresses[0]?.emailAddress ?? null;
}

export async function getUserDisplayName(args: ClerkArgs) {
  const user = await getUser(args);
  return user?.firstName
    ? `${user.firstName} ${user.lastName || ''}`.trim()
    : user?.emailAddresses[0]?.emailAddress ?? 'User';
}

{% elif saas_auth_provider == "authjs" %}
import { auth } from '@/integrations/auth/authjs/auth.config';

export async function getSession() {
  return await auth();
}

export async function getUser() {
  const session = await auth();
  return session?.user ?? null;
}

export async function getUserId() {
  const session = await auth();
  return session?.user?.id ?? null;
}

export async function requireUser() {
  const session = await auth();
  if (!session?.user) {
    throw new Error('Unauthorized: No user session');
  }
  return session.user;
}

export async function requireUserId() {
  const userId = await getUserId();
  if (!userId) {
    throw new Error('Unauthorized: No user session');
  }
  return userId;
}

export async function isAuthenticated() {
  const session = await auth();
  return !!session?.user;
}

export async function getUserEmail() {
  const session = await auth();
  return session?.user?.email ?? null;
}

export async function getUserDisplayName() {
  const session = await auth();
  return session?.user?.name ?? session?.user?.email ?? 'User';
}

export async function hasRole(role: string) {
  const session = await auth();
  const userRole = (session?.user as { role?: string } | undefined)?.role;
  return userRole === role;
}

export async function requireAdminRole(): Promise<void> {
  const allowed = await hasRole('admin');
  if (!allowed) {
    throw new ForbiddenError('Admin role required');
  }
}
{% endif %}

export class AuthError extends Error {
  constructor(message: string) {
    super(message);
    this.name = 'AuthError';
  }
}

export class UnauthorizedError extends AuthError {
  constructor(message = 'Unauthorized') {
    super(message);
    this.name = 'UnauthorizedError';
  }
}

export class ForbiddenError extends AuthError {
  constructor(message = 'Forbidden: Insufficient permissions') {
    super(message);
    this.name = 'ForbiddenError';
  }
}
{% endif %}
