{% if saas_infra_module == "enabled" %}
/**
 * Dashboard layout with collapsible sidebar, header, and mobile nav.
 */

{% if saas_runtime == 'nextjs-16' %}
'use client';
{% endif %}

import * as React from 'react';
{% if saas_runtime == 'nextjs-16' %}
import Link from 'next/link';
import { usePathname } from 'next/navigation';
{% elif saas_runtime == 'remix-2' %}
import { Link, useLocation } from '@remix-run/react';
{% endif %}
{% if saas_ui_framework == 'shadcn-ui' %}
import { Button } from '@/components/ui/button';
import {
  DropdownMenu,
  DropdownMenuContent,
  DropdownMenuItem,
  DropdownMenuLabel,
  DropdownMenuSeparator,
  DropdownMenuTrigger,
} from '@/components/ui/dropdown-menu';
import { Avatar, AvatarFallback, AvatarImage } from '@/components/ui/avatar';
import { ThemeToggle } from '@/components/theme-toggle';
{% endif %}

export interface NavItem {
  title: string;
  href: string;
  icon?: React.ReactNode;
  badge?: string | number;
  children?: NavItem[];
}

export interface User {
  name: string;
  email: string;
  avatar?: string;
}

export interface DashboardLayoutProps {
  children: React.ReactNode;
  user?: User;
  navigation?: NavItem[];
  {% if saas_tenancy_model == 'b2b-teams' %}
  organizationName?: string;
  organizationLogo?: string;
  {% endif %}
}

function AppLink({
  href,
  children,
  ...props
}: React.ComponentProps<'a'> & { href: string }) {
  {% if saas_runtime == 'remix-2' %}
  return (
    <Link to={href} {...props}>
      {children}
    </Link>
  );
  {% else %}
  return (
    <Link href={href} {...props}>
      {children}
    </Link>
  );
  {% endif %}
}

const defaultNavigation: NavItem[] = [
  {
    title: 'Dashboard',
    href: '/dashboard',
    icon: (
      <svg className="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
      </svg>
    ),
  },
  {% if saas_tenancy_model == 'b2b-teams' %}
  {
    title: 'Team',
    href: '/dashboard/team',
    icon: (
      <svg className="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />
      </svg>
    ),
  },
  {% endif %}
  {% if saas_billing_module == 'enabled' %}
  {
    title: 'Billing',
    href: '/dashboard/billing',
    icon: (
      <svg className="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z" />
      </svg>
    ),
  },
  {% endif %}
  {
    title: 'Settings',
    href: '/dashboard/settings',
    icon: (
      <svg className="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
        <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
      </svg>
    ),
  },
];

interface SidebarProps {
  navigation: NavItem[];
  collapsed: boolean;
  onCollapse: (collapsed: boolean) => void;
  {% if saas_tenancy_model == 'b2b-teams' %}
  organizationName?: string;
  organizationLogo?: string;
  {% endif %}
}

function Sidebar({
  navigation,
  collapsed,
  onCollapse,
  {% if saas_tenancy_model == 'b2b-teams' %}
  organizationName,
  organizationLogo,
  {% endif %}
}: SidebarProps) {
  {% if saas_runtime == 'nextjs-16' %}
  const pathname = usePathname();
  {% elif saas_runtime == 'remix-2' %}
  const { pathname } = useLocation();
  {% endif %}

  return (
    <aside
      className={`fixed inset-y-0 left-0 z-50 flex flex-col bg-sidebar text-sidebar-foreground transition-all duration-300 ${
        collapsed ? 'w-16' : 'w-64'
      }`}
    >
      <div className="flex h-16 items-center justify-between px-4">
        {% if saas_tenancy_model == 'b2b-teams' %}
        {!collapsed && (
          <div className="flex items-center gap-2">
            {organizationLogo ? (
              <img src={organizationLogo} alt="" className="h-8 w-8 rounded" />
            ) : (
              <div className="flex h-8 w-8 items-center justify-center rounded bg-primary text-sm font-bold text-primary-foreground">
                {organizationName?.charAt(0) || 'O'}
              </div>
            )}
            <span className="truncate font-semibold">
              {organizationName || '{{ project_name }}'}
            </span>
          </div>
        )}
        {% else %}
        {!collapsed && (
          <span className="font-semibold">{{ project_name }}</span>
        )}
        {% endif %}
        <button
          type="button"
          onClick={() => onCollapse(!collapsed)}
          aria-label={collapsed ? 'Expand sidebar' : 'Collapse sidebar'}
          aria-expanded={!collapsed}
          className="rounded-md p-1 text-sidebar-foreground/70 hover:bg-sidebar-accent hover:text-sidebar-accent-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
        >
          <svg
            className={`h-5 w-5 transition-transform ${collapsed ? 'rotate-180' : ''}`}
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            aria-hidden="true"
          >
            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M11 19l-7-7 7-7m8 14l-7-7 7-7" />
          </svg>
        </button>
      </div>

      <nav className="flex-1 space-y-1 px-2 py-4" aria-label="Dashboard">
        {navigation.map((item) => {
          const isActive = pathname === item.href || pathname.startsWith(item.href + '/');

          return (
            <AppLink
              key={item.href}
              href={item.href}
              className={`group flex items-center gap-3 rounded-md px-2 py-2 text-sm font-medium transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring ${
                isActive
                  ? 'bg-sidebar-accent text-sidebar-accent-foreground'
                  : 'text-sidebar-foreground/80 hover:bg-sidebar-accent hover:text-sidebar-accent-foreground'
              }`}
              title={collapsed ? item.title : undefined}
              aria-current={isActive ? 'page' : undefined}
            >
              {item.icon}
              {!collapsed && (
                <>
                  <span className="flex-1">{item.title}</span>
                  {item.badge && (
                    <span className="rounded-full bg-primary px-2 py-0.5 text-xs text-primary-foreground">
                      {item.badge}
                    </span>
                  )}
                </>
              )}
            </AppLink>
          );
        })}
      </nav>
    </aside>
  );
}

interface HeaderProps {
  user?: User;
  sidebarCollapsed: boolean;
}

function Header({ user, sidebarCollapsed }: HeaderProps) {
  return (
    <header
      className={`fixed top-0 right-0 z-40 hidden h-16 items-center justify-between border-b border-border bg-background px-4 transition-all duration-300 lg:flex ${
        sidebarCollapsed ? 'left-16' : 'left-64'
      }`}
    >
      <div className="flex-1" />
      <div className="flex items-center gap-2">
        {% if saas_ui_framework == 'shadcn-ui' %}
        <ThemeToggle />
        {% endif %}
        {user && (
          {% if saas_ui_framework == 'shadcn-ui' %}
          <DropdownMenu>
            <DropdownMenuTrigger asChild>
              <Button variant="ghost" className="relative h-8 w-8 rounded-full" aria-label="Open user menu">
                <Avatar className="h-8 w-8">
                  <AvatarImage src={user.avatar} alt={user.name} />
                  <AvatarFallback>{user.name.charAt(0)}</AvatarFallback>
                </Avatar>
              </Button>
            </DropdownMenuTrigger>
            <DropdownMenuContent className="w-56" align="end" forceMount>
              <DropdownMenuLabel className="font-normal">
                <div className="flex flex-col space-y-1">
                  <p className="text-sm font-medium leading-none">{user.name}</p>
                  <p className="text-xs leading-none text-muted-foreground">{user.email}</p>
                </div>
              </DropdownMenuLabel>
              <DropdownMenuSeparator />
              <DropdownMenuItem asChild>
                <AppLink href="/dashboard/settings">Settings</AppLink>
              </DropdownMenuItem>
              {% if saas_billing_module == 'enabled' %}
              <DropdownMenuItem asChild>
                <AppLink href="/dashboard/billing">Billing</AppLink>
              </DropdownMenuItem>
              {% endif %}
              <DropdownMenuSeparator />
              <DropdownMenuItem className="text-destructive">
                Sign out
              </DropdownMenuItem>
            </DropdownMenuContent>
          </DropdownMenu>
          {% else %}
          <div className="relative">
            <button
              type="button"
              className="flex items-center gap-2 rounded-full bg-muted p-1 pr-3 hover:bg-muted/80 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
              aria-label="Open user menu"
            >
              <div className="flex h-8 w-8 items-center justify-center rounded-full bg-primary text-primary-foreground">
                {user.avatar ? (
                  <img src={user.avatar} alt="" className="h-8 w-8 rounded-full" />
                ) : (
                  user.name.charAt(0)
                )}
              </div>
              <span className="text-sm font-medium">{user.name}</span>
            </button>
          </div>
          {% endif %}
        )}
      </div>
    </header>
  );
}

interface MobileMenuProps {
  navigation: NavItem[];
  isOpen: boolean;
  onClose: () => void;
}

function MobileMenu({ navigation, isOpen, onClose }: MobileMenuProps) {
  {% if saas_runtime == 'nextjs-16' %}
  const pathname = usePathname();
  {% elif saas_runtime == 'remix-2' %}
  const { pathname } = useLocation();
  {% endif %}

  React.useEffect(() => {
    if (!isOpen) return;
    const onKeyDown = (event: KeyboardEvent) => {
      if (event.key === 'Escape') onClose();
    };
    window.addEventListener('keydown', onKeyDown);
    return () => window.removeEventListener('keydown', onKeyDown);
  }, [isOpen, onClose]);

  if (!isOpen) return null;

  return (
    <div className="fixed inset-0 z-50 lg:hidden">
      <button
        type="button"
        className="fixed inset-0 bg-foreground/50"
        aria-label="Close navigation menu"
        onClick={onClose}
      />

      <div className="fixed inset-y-0 left-0 flex w-full max-w-xs flex-col bg-sidebar text-sidebar-foreground" role="dialog" aria-modal="true" aria-label="Mobile navigation">
        <div className="flex h-16 items-center justify-between px-4">
          <span className="font-semibold">{{ project_name }}</span>
          <button
            type="button"
            onClick={onClose}
            className="rounded-md p-1 text-sidebar-foreground/70 hover:text-sidebar-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
            aria-label="Close navigation menu"
          >
            <svg className="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>

        <nav className="flex-1 space-y-1 px-2 py-4" aria-label="Dashboard">
          {navigation.map((item) => {
            const isActive = pathname === item.href;
            return (
              <AppLink
                key={item.href}
                href={item.href}
                onClick={onClose}
                className={`flex items-center gap-3 rounded-md px-2 py-2 text-sm font-medium focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring ${
                  isActive
                    ? 'bg-sidebar-accent text-sidebar-accent-foreground'
                    : 'text-sidebar-foreground/80 hover:bg-sidebar-accent'
                }`}
                aria-current={isActive ? 'page' : undefined}
              >
                {item.icon}
                <span>{item.title}</span>
              </AppLink>
            );
          })}
        </nav>
      </div>
    </div>
  );
}

export function DashboardLayout({
  children,
  user,
  navigation = defaultNavigation,
  {% if saas_tenancy_model == 'b2b-teams' %}
  organizationName,
  organizationLogo,
  {% endif %}
}: DashboardLayoutProps) {
  const [sidebarCollapsed, setSidebarCollapsed] = React.useState(false);
  const [mobileMenuOpen, setMobileMenuOpen] = React.useState(false);

  return (
    <div className="min-h-screen bg-background text-foreground">
      <div className="hidden lg:block">
        <Sidebar
          navigation={navigation}
          collapsed={sidebarCollapsed}
          onCollapse={setSidebarCollapsed}
          {% if saas_tenancy_model == 'b2b-teams' %}
          organizationName={organizationName}
          organizationLogo={organizationLogo}
          {% endif %}
        />
      </div>

      <MobileMenu
        navigation={navigation}
        isOpen={mobileMenuOpen}
        onClose={() => setMobileMenuOpen(false)}
      />

      <Header user={user} sidebarCollapsed={sidebarCollapsed} />

      <div className="fixed top-0 right-0 left-0 z-40 flex h-16 items-center justify-between border-b border-border bg-background px-4 lg:hidden">
        <button
          type="button"
          onClick={() => setMobileMenuOpen(true)}
          className="rounded-md p-1 text-muted-foreground hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring"
          aria-label="Open navigation menu"
        >
          <svg className="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2} d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
        <span className="font-semibold">{{ project_name }}</span>
        <div className="w-6" />
      </div>

      <main
        className={`pt-16 transition-all duration-300 ${
          sidebarCollapsed ? 'lg:pl-16' : 'lg:pl-64'
        }`}
      >
        <div className="p-4 sm:p-6 lg:p-8">{children}</div>
      </main>
    </div>
  );
}

export interface PageHeaderProps {
  title: string;
  description?: string;
  actions?: React.ReactNode;
}

export function PageHeader({ title, description, actions }: PageHeaderProps) {
  return (
    <div className="mb-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h1 className="text-2xl font-bold tracking-tight text-foreground">{title}</h1>
        {description && (
          <p className="mt-1 text-sm text-muted-foreground">{description}</p>
        )}
      </div>
      {actions && <div className="flex gap-2">{actions}</div>}
    </div>
  );
}
{% endif %}
