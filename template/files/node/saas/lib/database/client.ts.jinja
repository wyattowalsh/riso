{% if saas_infra_module == "enabled" %}
{% if saas_orm == "prisma" %}
import { PrismaClient } from '@prisma/client';

if (!process.env.DATABASE_URL) {
  throw new Error('DATABASE_URL is required');
}

let prisma: PrismaClient;

if (process.env.NODE_ENV === 'production') {
  prisma = new PrismaClient();
} else {
  // Reuse across Next.js / Remix hot reloads in development.
  const globalForPrisma = globalThis as typeof globalThis & {
    prisma?: PrismaClient;
  };
  if (!globalForPrisma.prisma) {
    globalForPrisma.prisma = new PrismaClient();
  }
  prisma = globalForPrisma.prisma;
}

export { prisma };
export const db = prisma;
{% elif saas_orm == "drizzle" %}
{% if saas_database == 'neon' %}
import { neon } from '@neondatabase/serverless';
import { drizzle } from 'drizzle-orm/neon-http';
{% else %}
import postgres from 'postgres';
import { drizzle } from 'drizzle-orm/postgres-js';
{% endif %}
import * as schema from '@/integrations/orm/drizzle/schema';

const databaseUrl = process.env.DATABASE_URL;
if (!databaseUrl) {
  throw new Error('DATABASE_URL is required');
}

{% if saas_database == 'neon' %}
export const db = drizzle(neon(databaseUrl), { schema });
{% else %}
export const db = drizzle(postgres(databaseUrl), { schema });
{% endif %}
{% endif %}
{% endif %}
