/**
 * Multi-Tenancy Data Isolation
 *
 * Provides row-level security (RLS) patterns and helpers for tenant data isolation.
 * Supports both Prisma and Drizzle ORMs with automatic tenant filtering.
 */

import { AsyncLocalStorage } from 'node:async_hooks';
import type {
  TenantConfig,
  TenantIsolationConfig,
  TenantQueryBuilder,
} from './types';

const DEFAULT_ISOLATION_CONFIG: TenantIsolationConfig = {
  enableRLS: true,
  autoInject: true,
  tenantIdField: 'tenantId',
  excludedTables: ['Tenant', 'User'],
  strictMode: true,
};

function assertTenantIdentity(tenant: TenantConfig | null | undefined): asserts tenant is TenantConfig {
  if (!tenant || typeof tenant.id !== 'string' || tenant.id.trim().length === 0) {
    throw new Error('Tenant context requires a non-empty tenant ID');
  }
}

/**
 * Tenant isolation context for database queries
 */
class TenantIsolationContext {
  private static instance: TenantIsolationContext;
  private readonly tenantStorage = new AsyncLocalStorage<TenantConfig | null>();
  private config: TenantIsolationConfig;

  private constructor(config: Partial<TenantIsolationConfig> = {}) {
    this.config = { ...DEFAULT_ISOLATION_CONFIG, ...config };
  }

  static getInstance(config?: Partial<TenantIsolationConfig>): TenantIsolationContext {
    if (!TenantIsolationContext.instance) {
      TenantIsolationContext.instance = new TenantIsolationContext(config);
    }
    return TenantIsolationContext.instance;
  }

  setTenant(tenant: TenantConfig | null): void {
    if (this.tenantStorage.getStore() === undefined) {
      throw new Error('Use withTenant to establish a request-scoped tenant context');
    }
    if (tenant !== null) assertTenantIdentity(tenant);
    this.tenantStorage.enterWith(tenant);
  }

  getTenant(): TenantConfig | null {
    return this.tenantStorage.getStore() ?? null;
  }

  run<T>(tenant: TenantConfig, fn: () => T): T {
    assertTenantIdentity(tenant);
    return this.tenantStorage.run(tenant, fn);
  }

  getConfig(): TenantIsolationConfig {
    return this.config;
  }

  requireTenant(): TenantConfig {
    const tenant = this.getTenant();
    if (!tenant) {
      throw new Error('Tenant context is required but not set');
    }
    assertTenantIdentity(tenant);
    return tenant;
  }
}

/**
 * Initialize tenant isolation
 */
export function initTenantIsolation(
  config: Partial<TenantIsolationConfig> = {}
): TenantIsolationContext {
  return TenantIsolationContext.getInstance(config);
}

/**
 * Get current tenant isolation context
 */
export function getTenantContext(): TenantIsolationContext {
  return TenantIsolationContext.getInstance();
}

/**
 * Set the tenant inside an existing withTenant scope.
 * Establishing request scopes must use withTenant, never ambient process state.
 */
export function setCurrentTenant(tenant: TenantConfig | null): void {
  getTenantContext().setTenant(tenant);
}

/**
 * Get current tenant
 */
export function getCurrentTenant(): TenantConfig | null {
  return getTenantContext().getTenant();
}

/**
 * Require tenant to be set
 */
export function requireTenant(): TenantConfig {
  return getTenantContext().requireTenant();
}

/**
 * Execute function with tenant context
 */
export async function withTenant<T>(
  tenant: TenantConfig,
  fn: () => Promise<T> | T
): Promise<T> {
  return getTenantContext().run(tenant, fn);
}

/**
 * Prisma Extension for automatic tenant filtering
 *
 * Usage:
 * ```typescript
 * import { createPrismaExtension } from '@/lib/multi-tenant/isolation';
 * import { PrismaClient } from '@prisma/client';
 *
 * const prisma = createPrismaExtension(new PrismaClient());
 * ```
 */
export function createPrismaExtension(prisma: any) {
  const context = getTenantContext();
  const config = context.getConfig();

  return prisma.$extends({
    name: 'tenant-isolation',
    query: {
      $allModels: {
        async $allOperations({ model, operation, args = {}, query }: any) {
          if (config.excludedTables?.includes(model)) {
            return query(args);
          }

          const tenant = config.strictMode ? context.requireTenant() : context.getTenant();
          if (!tenant) {
            return query(args);
          }

          const tenantFilter = { [config.tenantIdField]: tenant.id };
          const scopedWhere = { ...args.where, ...tenantFilter };
          switch (operation) {
            case 'findMany':
            case 'findFirst':
            case 'findFirstOrThrow':
            case 'findUnique':
            case 'findUniqueOrThrow':
            case 'count':
            case 'aggregate':
            case 'groupBy':
            case 'delete':
            case 'deleteMany':
              return query({ ...args, where: scopedWhere });
            case 'create':
              return query({ ...args, data: { ...args.data, ...tenantFilter } });
            case 'createMany':
            case 'createManyAndReturn':
              return query({
                ...args,
                data: Array.isArray(args.data)
                  ? args.data.map((item: any) => ({ ...item, ...tenantFilter }))
                  : { ...args.data, ...tenantFilter },
              });
            case 'update':
            case 'updateMany':
            case 'updateManyAndReturn':
              return query({
                ...args,
                where: scopedWhere,
                data: { ...args.data, ...tenantFilter },
              });
            case 'upsert':
              return query({
                ...args,
                where: scopedWhere,
                create: { ...args.create, ...tenantFilter },
                update: { ...args.update, ...tenantFilter },
              });
            default:
              throw new Error(`Unsupported tenant-scoped Prisma operation: ${operation}`);
          }
        },
      },
    },
  });
}

/**
 * Drizzle helper for tenant-scoped queries
 */
export function createDrizzleHelper<T extends Record<string, any>>(
  db: any,
  table: any
) {
  const context = getTenantContext();
  const config = context.getConfig();

  return {
    /**
     * Select with automatic tenant filtering
     */
    select(): TenantQueryBuilder<T> {
      const tenant = context.requireTenant();
      const tenantField = config.tenantIdField as keyof T;

      const query = db.select().from(table).where({ [tenantField]: tenant.id });
      const builder: TenantQueryBuilder<T> = {
        where(_conditions: Partial<T>): TenantQueryBuilder<T> {
          throw new Error('Tenant-scoped Drizzle filters require an application query implementation');
        },

        orderBy(_field: keyof T, _direction: 'asc' | 'desc'): TenantQueryBuilder<T> {
          throw new Error('Tenant-scoped Drizzle ordering requires an application query implementation');
        },

        limit(_count: number): TenantQueryBuilder<T> {
          throw new Error('Tenant-scoped Drizzle pagination requires an application query implementation');
        },

        offset(_count: number): TenantQueryBuilder<T> {
          throw new Error('Tenant-scoped Drizzle pagination requires an application query implementation');
        },

        async execute(): Promise<T[]> {
          // Build and execute query with Drizzle
          // This is a simplified version - adapt to your Drizzle setup
          return query;
        },

        async first(): Promise<T | null> {
          const results = await builder.execute();
          return results[0] || null;
        },

        async count(): Promise<number> {
          throw new Error('Tenant-scoped Drizzle count requires an application query implementation');
        },
      };

      return builder;
    },

    /**
     * Insert with automatic tenant ID
     */
    async insert(data: Omit<T, 'tenantId' | 'id'>): Promise<T> {
      const tenant = context.requireTenant();
      const tenantField = config.tenantIdField as keyof T;

      return db.insert(table).values({
        ...data,
        [tenantField]: tenant.id,
      });
    },

    /**
     * Update with tenant filtering
     */
    async update(id: string, data: Partial<T>): Promise<T> {
      const tenant = context.requireTenant();
      const tenantField = config.tenantIdField as keyof T;

      return db
        .update(table)
        .set({ ...data, [tenantField]: tenant.id })
        .where({ id, [tenantField]: tenant.id });
    },

    /**
     * Delete with tenant filtering
     */
    async delete(id: string): Promise<void> {
      const tenant = context.requireTenant();
      const tenantField = config.tenantIdField as keyof T;

      await db.delete(table).where({ id, [tenantField]: tenant.id });
    },
  };
}

export interface TenantSqlQuery {
  sql: string;
  params: unknown[];
}

/**
 * Scope a single PostgreSQL SELECT using positional parameters.
 * Pass caller-owned SQL and its existing $1, $2, ... values; never user SQL.
 * The SELECT must project tenantIdField so the outer query can enforce it.
 */
export function buildTenantQuery(
  baseQuery: string,
  tenantIdField: string = 'tenant_id',
  params: readonly unknown[] = []
): TenantSqlQuery {
  const tenant = requireTenant();
  if (!/^[A-Za-z_][A-Za-z0-9_]*$/.test(tenantIdField)) {
    throw new Error('Invalid tenant SQL column identifier');
  }

  const select = baseQuery.trim().replace(/;$/, '').trim();
  if (!/^SELECT\b/i.test(select) || select.includes(';')) {
    throw new Error('Tenant SQL helper supports one SELECT statement only');
  }

  return {
    sql: `SELECT * FROM (${select}) AS tenant_data WHERE tenant_data."${tenantIdField}" = $${params.length + 1}`,
    params: [...params, tenant.id],
  };
}

/**
 * Validate tenant access to resource
 */
export function validateTenantAccess(
  resourceTenantId: string,
  strictMode: boolean = true
): boolean {
  const tenant = getCurrentTenant();

  if (!tenant) {
    if (strictMode) {
      throw new Error('Tenant context not set');
    }
    return false;
  }

  if (resourceTenantId !== tenant.id) {
    if (strictMode) {
      throw new Error('Access denied: Resource belongs to different tenant');
    }
    return false;
  }

  return true;
}

/**
 * Higher-order function for tenant-scoped API handlers
 */
export function withTenantIsolation<TArgs extends any[], TReturn>(
  fn: (...args: TArgs) => Promise<TReturn>
) {
  return async (...args: TArgs): Promise<TReturn> => {
    requireTenant();
    return fn(...args);
  };
}
