{%- if mcp_module == 'enabled' and 'typescript' in mcp_languages -%}
import { describe, expect, it } from "vitest";
import type { Config } from "../src/config.js";
import { parseArgs, transportOptions } from "../src/transport.js";

const config: Config = {
  name: "test-mcp",
  transport: "stdio",
  host: "127.0.0.1",
  port: 3000,
  logLevel: "info",
};

describe("transport arguments", () => {
  it.each(["stdio", "sse", "http"])("accepts the advertised %s choice", (transport) => {
    const parsed = parseArgs(config, ["--transport", transport, "--host", "0.0.0.0", "-p", "4000"]);
    expect(parsed).toEqual({ transport, host: "0.0.0.0", port: 4000 });
  });

  it("uses configured defaults without overrides", () => {
    expect(parseArgs(config, [])).toEqual({ transport: "stdio", host: "127.0.0.1", port: 3000 });
  });

  it("rejects unrecognized transports before starting the server", () => {
    expect(() => parseArgs(config, ["-t", "udp"])).toThrow("Unknown transport: udp");
  });

  it("uses the supported stdio API", () => {
    expect(transportOptions("stdio", config.host, config.port)).toEqual({ transportType: "stdio" });
  });

  it.each(["sse", "http"] as const)("keeps %s separate from the legacy SSE route", (transport) => {
    expect(transportOptions(transport, config.host, config.port)).toEqual({
      transportType: "httpStream",
      httpStream: { host: "127.0.0.1", port: 3000, endpoint: "/mcp" },
    });
  });
});
{%- endif %}
