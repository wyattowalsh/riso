{%- if mcp_module == 'enabled' and 'typescript' in mcp_languages -%}
/**
 * {{ project_name }} MCP Server
 *
 * Exposes {{ project_name }} functionality as MCP tools, resources, and prompts.
 */

import { FastMCP } from "fastmcp";
import { getConfig } from "./config.js";
import { registerPrompts } from "./prompts/index.js";
import { registerResources } from "./resources/index.js";
import { registerTools } from "./tools/index.js";
import { parseArgs, transportOptions } from "./transport.js";

const VERSION = "1.0.0";
const SERVER_NAME = "{{ package_name }}-mcp";

// Load configuration
const config = getConfig();

// Create MCP server
const mcp = new FastMCP({
  name: config.name,
  version: VERSION,
});

// Register all tools
registerTools(mcp);
registerResources(mcp);
registerPrompts(mcp);

// Main entry point
async function main() {
  const { transport, host, port } = parseArgs(config);

  console.error(`Starting ${SERVER_NAME} v${VERSION} with ${transport} transport`);

  await mcp.start(transportOptions(transport, host, port));
  if (transport !== "stdio") {
    const endpoint = transport === "sse" ? "/sse" : "/mcp";
    console.error(
      `MCP server listening on http://${host}:${port}${endpoint} (HTTP at /mcp; SSE at /sse)`,
    );
  }
}

main().catch((error) => {
  console.error("Failed to start MCP server:", error);
  process.exit(1);
});

export { mcp, VERSION, SERVER_NAME };
{%- endif %}
