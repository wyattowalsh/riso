{%- if docs_module == 'enabled' and docs_framework == 'fumadocs' and fumadocs_ai_search == 'enabled' -%}
export const dynamic = 'force-static';
export const revalidate = false;

// Extra-only: Vercel AI SDK chat is a request-body POST. This dest
// always uses `output: 'export'`, which cannot prerender POST.
export async function GET() {
  return new Response(
    JSON.stringify({
      error: 'AI chat is not available on the statically exported docs site.',
    }),
    {
      headers: {
        'Content-Type': 'application/json; charset=utf-8',
      },
    },
  );
}
{%- endif -%}
