{%- if docs_module == 'enabled' and docs_framework == 'fumadocs' and fumadocs_search_provider == 'orama' -%}
import { source } from '@/lib/source';
import { createFromSource } from 'fumadocs-core/search/server';

export const dynamic = 'force-static';
export const revalidate = false;

const { staticGET } = createFromSource(source, {
  // Add tag support for filtering
  // tag: (page) => page.data.tags ?? [],
});

// Named GET() with no Request param so Next static export does not
// treat the handler as using request.url (search.GET does).
export async function GET() {
  return staticGET();
}
