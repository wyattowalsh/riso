{%- if docs_module == 'enabled' and docs_framework == 'fumadocs' and fumadocs_banner == 'enabled' -%}
'use client';

import { useSyncExternalStore, type ReactNode } from 'react';

const dismissalListeners = new Set<() => void>();

function subscribeToDismissals(onStoreChange: () => void) {
  dismissalListeners.add(onStoreChange);
  return () => {
    dismissalListeners.delete(onStoreChange);
  };
}

interface BannerProps {
  id?: string;
  children: ReactNode;
  variant?: 'info' | 'warning' | 'success';
  dismissible?: boolean;
}

export function Banner({
  id = 'announcement',
  children,
  variant = 'info',
  dismissible = true,
}: BannerProps) {
  const dismissed = useSyncExternalStore(
    subscribeToDismissals,
    () => localStorage.getItem(`banner-${id}`) === 'dismissed',
    // Keep the initial server and hydration output hidden until storage is read.
    () => true,
  );

  const handleDismiss = () => {
    localStorage.setItem(`banner-${id}`, 'dismissed');
    for (const notify of dismissalListeners) notify();
  };

  if (dismissed) return null;

  const variantStyles = {
    info: 'bg-fd-primary text-fd-primary-foreground',
    warning: 'bg-yellow-500 text-yellow-950',
    success: 'bg-green-500 text-green-950',
  };

  return (
    <div className={`relative px-4 py-2 text-center text-sm ${variantStyles[variant]}`}>
      {children}
      {dismissible && (
        <button
          onClick={handleDismiss}
          className="absolute right-2 top-1/2 -translate-y-1/2 rounded p-1 hover:bg-black/10 transition-colors"
          aria-label="Dismiss banner"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            strokeWidth="2"
            strokeLinecap="round"
            strokeLinejoin="round"
          >
            <path d="M18 6 6 18" />
            <path d="m6 6 12 12" />
          </svg>
        </button>
      )}
    </div>
  );
}
{%- endif -%}
