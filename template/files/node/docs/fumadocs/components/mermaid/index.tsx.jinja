{%- if docs_module == 'enabled' and docs_framework == 'fumadocs' and fumadocs_mermaid == 'enabled' -%}
'use client';

import { useEffect, useRef, useState } from 'react';
import mermaid from 'mermaid';
import { mermaidOptions, prefersDark } from './theme';

interface MermaidProps {
  chart: string;
}

// Mermaid ids cannot contain colons (React useId) or rely on Math.random.
let mermaidSeq = 0;
function nextMermaidId(): string {
  mermaidSeq += 1;
  return `mermaid-${mermaidSeq}`;
}

function toChartSource(chart: string): string {
  return String(chart ?? '').replace(/\r\n/g, '\n').trim();
}

export default function Mermaid({ chart }: MermaidProps) {
  const hostRef = useRef<HTMLDivElement>(null);
  const [svg, setSvg] = useState('');
  const [error, setError] = useState('');
  const source = toChartSource(chart);

  useEffect(() => {
    let cancelled = false;
    let lastDark = prefersDark();

    const draw = async () => {
      mermaid.initialize(mermaidOptions(lastDark));
      try {
        const id = nextMermaidId();
        // strict + mermaid.render runs the SVG through DOMPurify.
        // Do not call bindFunctions (re-enables clicks).
        const rendered = await mermaid.render(id, source);
        if (!cancelled) {
          setSvg(rendered.svg);
          setError('');
        }
      } catch (err) {
        if (!cancelled) {
          setError(err instanceof Error ? err.message : 'Failed to render diagram');
          setSvg('');
        }
      }
    };

    void draw();

    const root = document.documentElement;
    const observer = new MutationObserver(() => {
      const next = prefersDark();
      if (next !== lastDark) {
        lastDark = next;
        void draw();
      }
    });
    observer.observe(root, { attributes: true, attributeFilter: ['class', 'data-theme'] });

    const media = window.matchMedia('(prefers-color-scheme: dark)');
    const onMedia = () => {
      const next = prefersDark();
      if (next !== lastDark) {
        lastDark = next;
        void draw();
      }
    };
    media.addEventListener('change', onMedia);

    return () => {
      cancelled = true;
      observer.disconnect();
      media.removeEventListener('change', onMedia);
    };
  }, [source]);

  if (error) {
    return (
      <div
        role="alert"
        className="my-4 rounded-lg border border-fd-border bg-fd-card p-4 text-sm text-fd-foreground"
      >
        <strong>Mermaid error:</strong> {error}
      </div>
    );
  }

  if (!svg) {
    return (
      <div
        ref={hostRef}
        role="status"
        aria-live="polite"
        className="my-4 flex justify-center overflow-x-auto rounded-lg bg-fd-card p-4 text-sm text-fd-muted-foreground"
      >
        Rendering diagram…
      </div>
    );
  }

  return (
    <div
      ref={hostRef}
      role="img"
      aria-label="Mermaid diagram"
      className="my-4 flex justify-center overflow-x-auto rounded-lg bg-fd-card p-4 [&_svg]:bg-transparent"
      dangerouslySetInnerHTML={{ '{{' }} __html: svg {{ '}}' }}
    />
  );
}
{%- endif -%}
