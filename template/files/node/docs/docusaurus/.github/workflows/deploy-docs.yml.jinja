{%- if docs_module == 'enabled' and docs_framework == 'docusaurus' and ci_platform == 'github-actions' -%}
# Docusaurus Documentation Deployment
# Builds and deploys docs to GitHub Pages on push to main

name: Deploy Docs

on:
  push:
    branches: [main]
    paths:
      - 'docs/**'
      - 'blog/**'
      - 'src/**'
      - 'static/**'
      - 'docusaurus.config.ts'
      - 'sidebars.ts'
      - 'package.json'
  workflow_dispatch:

permissions:
  contents: read
  pages: write
  id-token: write

concurrency:
  group: pages
  cancel-in-progress: true

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@df4cb1c069e1874edd31b4311f1884172cec0e10 # v6
        with:
{%- if docusaurus_show_last_update == 'enabled' %}
          fetch-depth: 0  # Full history for git timestamps
{%- else %}
          fetch-depth: 1
{%- endif %}

      - uses: pnpm/action-setup@b906affcce14559ad1aafd4ab0e942779e9f58b1 # v4
        with:
          version: 9

      - uses: actions/setup-node@48b55a011bda9f5d6aeb4c2d9c7362e8dae4041e # v6
        with:
          node-version: '22'
          cache: 'pnpm'

      - name: Install dependencies
        run: pnpm install --frozen-lockfile

      - name: Build documentation
        run: pnpm build
        env:
          NODE_OPTIONS: --max-old-space-size=4096
{%- if docusaurus_analytics == 'google' %}
          GOOGLE_ANALYTICS_ID: {% raw %}${{ secrets.GOOGLE_ANALYTICS_ID }}{% endraw %}
{%- endif %}
{%- if docusaurus_analytics == 'posthog' %}
          POSTHOG_API_KEY: {% raw %}${{ secrets.POSTHOG_API_KEY }}{% endraw %}
{%- endif %}
{%- if docusaurus_search_provider == 'algolia' %}
          ALGOLIA_APP_ID: {% raw %}${{ secrets.ALGOLIA_APP_ID }}{% endraw %}
          ALGOLIA_API_KEY: {% raw %}${{ secrets.ALGOLIA_API_KEY }}{% endraw %}
{%- endif %}

      - name: Setup Pages
        uses: actions/configure-pages@983d7736d9b0ae728b81ab479565c72886d7745b # v5

      - name: Upload artifact
        uses: actions/upload-pages-artifact@56afc609e74202658d3ffba0e8f6dda462b719fa # v3
        with:
          path: build

  deploy:
    environment:
      name: github-pages
      url: {% raw %}${{ steps.deployment.outputs.page_url }}{% endraw %}
    runs-on: ubuntu-latest
    needs: build
    steps:
      - name: Deploy to GitHub Pages
        id: deployment
        uses: actions/deploy-pages@d6db90164ac5ed86f2b6aed7e0febac5b3c0c03e # v4
{%- endif -%}
