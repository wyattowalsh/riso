{%- if docs_module == 'enabled' and docs_framework == 'docusaurus' -%}
/* Shared Infima tokens — generated teal scale (#14b8a6) */
:root {
  --ifm-color-primary: #14b8a6;
  --ifm-color-primary-dark: #0d9488;
  --ifm-color-primary-darker: #0f766e;
  --ifm-color-primary-darkest: #115e59;
  --ifm-color-primary-light: #2dd4bf;
  --ifm-color-primary-lighter: #5eead4;
  --ifm-color-primary-lightest: #99f6e4;
  --ifm-code-font-size: 95%;
  --docusaurus-highlighted-code-line-bg: rgba(0, 0, 0, 0.1);
}

[data-theme='dark'] {
  --ifm-color-primary: #2dd4bf;
  --ifm-color-primary-dark: #14b8a6;
  --ifm-color-primary-darker: #0d9488;
  --ifm-color-primary-darkest: #0f766e;
  --ifm-color-primary-light: #5eead4;
  --ifm-color-primary-lighter: #99f6e4;
  --ifm-color-primary-lightest: #ccfbf1;
  --docusaurus-highlighted-code-line-bg: rgba(0, 0, 0, 0.3);
}

{%- if docusaurus_mermaid == 'enabled' %}

.docusaurus-mermaid-container svg,
.mermaid svg {
  background: transparent;
}
{%- endif %}

{%- if docusaurus_theme == 'tailwind' %}

@layer base {
  a {
    @apply no-underline;
  }
}

.hero-gradient {
  @apply bg-gradient-to-r from-teal-500 to-teal-700;
}

.feature-card {
  @apply rounded-lg p-6 shadow-md transition-shadow hover:shadow-lg;
}
{%- else %}

.docusaurus-highlight-code-line {
  background-color: var(--docusaurus-highlighted-code-line-bg);
  display: block;
  margin: 0 calc(-1 * var(--ifm-pre-padding));
  padding: 0 var(--ifm-pre-padding);
}

.hero--primary {
  background: linear-gradient(135deg, var(--ifm-color-primary) 0%, #0f766e 100%);
}

.feature-card {
  border-radius: 0.5rem;
  padding: 1.5rem;
  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
  transition: box-shadow 0.2s ease-in-out;
}

.feature-card:hover {
  box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
}

.menu__link--active {
  font-weight: 600;
}

table {
  display: table;
  width: 100%;
}

@media print {
  .navbar,
  .footer,
  .pagination-nav,
  .theme-doc-sidebar-container {
    display: none !important;
  }
}
{%- endif -%}
{%- endif -%}
