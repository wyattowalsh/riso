# Generated by the Riso template (always-on; not gated by extras).
# Use Node 22; package.json records the patch floor for the selected features.
# After clone: `mise install` (auto_install is also on).

[tools]
python = "3.11"
node = "22"
pnpm = "9.15.0"
uv = "0.4.30"
{%- if 'rust' in mcp_languages or 'rust' in cli_languages or 'rust' in api_languages %}
rust = "1.99.1"
{%- endif %}
{%- if task_runner in ['just', 'both'] %}
just = "1.34"
{%- endif %}

[settings]
auto_install = true
