[run]
branch = {% if quality_profile == 'strict' %}True{% else %}False{% endif %}
source =
    src/{{ package_name }}
    tests
omit =
    */__init__.py
    */migrations/*
    */node_modules/*

[report]
show_missing = True
skip_covered = False
precision = 2
fail_under = {% if cli_module | lower == "enabled" %}90.0{% else %}85.0{% endif %}

[html]
directory = htmlcov
