"""Quality helper aligned with just/make (src layout + coverage --rcfile)."""

from __future__ import annotations

import json
import os
import subprocess
import sys
import time
from pathlib import Path

DEFAULT_PROFILE = "{{ quality_profile|default('standard') }}"
QUALITY_PROFILE = os.environ.get("QUALITY_PROFILE", DEFAULT_PROFILE).lower()
# quality/uv_tasks/quality.py → dest root; canonical pyproject is python/
DEST_ROOT = Path(__file__).resolve().parents[2]
PROJECT_ROOT = DEST_ROOT / "python"

RUFF_FLAGS: list[str] = []
TY_FLAGS: list[str] = []
PYLINT_FLAGS: list[str] = []

if QUALITY_PROFILE == "strict":
    RUFF_FLAGS = ["--select", "ALL", "--ignore", "E203,E266,E501"]
    TY_FLAGS = ["--error-on-warning"]
    PYLINT_FLAGS = ["--errors-only"]

_MODULE_GROUPS: list[str] = []
{% if cli_module == 'enabled' and 'python' in cli_languages %}
_MODULE_GROUPS.extend(["--group", "cli"])
{% endif %}
{% if api_module == 'enabled' and 'python' in api_languages %}
_MODULE_GROUPS.extend(["--group", "api_python", "--group", "api_python_test"])
{% endif %}
{% if (graphql_api_module|default('disabled')) == 'enabled' or 'graphql' in (api_features|default([])) %}
_MODULE_GROUPS.extend(["--group", "graphql_api"])
{% endif %}
{% if (websocket_module|default('disabled')) == 'enabled' or 'websocket' in (api_features|default([])) %}
_MODULE_GROUPS.extend(["--group", "websocket"])
{% endif %}
{% if mcp_module == 'enabled' and 'python' in mcp_languages %}
_MODULE_GROUPS.extend(["--group", "mcp"])
{% endif %}
{% if (codegen_module|default('disabled')) == 'enabled' %}
_MODULE_GROUPS.extend(["--group", "codegen"])
{% endif %}


def _coverage_rcfile() -> str:
    """Prefer python/coverage.cfg, else quality/coverage.cfg relative to python/."""
    python_cfg = PROJECT_ROOT / "coverage.cfg"
    if python_cfg.is_file():
        return "coverage.cfg"
    quality_cfg = DEST_ROOT / "quality" / "coverage.cfg"
    if quality_cfg.is_file():
        return "../quality/coverage.cfg"
    return "coverage.cfg"


_COVERAGE_RC = _coverage_rcfile()

COMMANDS: list[tuple[str, list[str]]] = [
    (
        "ruff",
        [
            "uv",
            "run",
            "--group",
            "quality",
            "--group",
            "test",
            *_MODULE_GROUPS,
            "ruff",
            "check",
            *RUFF_FLAGS,
        ],
    ),
    (
        "ty",
        [
            "uv",
            "run",
            "--group",
            "quality",
            "--group",
            "test",
            *_MODULE_GROUPS,
            "ty",
            "check",
            *TY_FLAGS,
            "src/{{ package_name }}",
        ],
    ),
    (
        "pylint",
        [
            "uv",
            "run",
            "--group",
            "quality",
            "--group",
            "test",
            *_MODULE_GROUPS,
            "pylint",
            *PYLINT_FLAGS,
            "src/{{ package_name }}",
            "tests",
        ],
    ),
    (
        "coverage",
        [
            "uv",
            "run",
            "--group",
            "quality",
            "--group",
            "test",
            *_MODULE_GROUPS,
            "coverage",
            "run",
            "--rcfile",
            _COVERAGE_RC,
            "-m",
            "pytest",
            "-ra",
        ],
    ),
    (
        "coverage-report",
        [
            "uv",
            "run",
            "--group",
            "quality",
            "coverage",
            "report",
            "--rcfile",
            _COVERAGE_RC,
        ],
    ),
]

{% if api_module == 'enabled' and 'node' in api_languages %}
COMMANDS.extend(
    [
        (
            "pnpm-lint",
            ["pnpm", "--filter", "api-node", "lint"],
        ),
        (
            "pnpm-typecheck",
            ["pnpm", "--filter", "api-node", "typecheck"],
        ),
    ]
)
{% endif %}


def run_command(label: str, command: list[str]) -> float:
    start = time.perf_counter()
    result = subprocess.run(command, check=False, cwd=PROJECT_ROOT)
    duration = time.perf_counter() - start
    if result.returncode != 0:
        sys.stderr.write(f"\n[quality] {label} failed with exit code {result.returncode}\n")
        sys.exit(result.returncode)
    sys.stdout.write(f"[quality] {label} completed in {duration:.2f}s\n")
    return duration


def main() -> int:
    durations: dict[str, float] = {}
    for label, command in COMMANDS:
        durations[label] = run_command(label, command)
    out = DEST_ROOT / ".riso" / "quality-durations.json"
    out.parent.mkdir(exist_ok=True, parents=True)
    out.write_text(json.dumps(durations, indent=2), encoding="utf-8")
    sys.stdout.write(f"[quality] Durations written to {out}\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
