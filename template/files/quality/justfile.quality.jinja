# Quality justfile — generated by Riso template
{%- set _python = (cli_module == 'enabled' and 'python' in cli_languages) or (api_module == 'enabled' and 'python' in api_languages) or (mcp_module == 'enabled' and 'python' in mcp_languages) or (docs_module == 'enabled' and docs_framework == 'sphinx-shibuya') -%}
{%- set _node = api_module == 'enabled' and 'node' in api_languages -%}
{%- set uv_mod_groups -%}
{%- if cli_module == 'enabled' and 'python' in cli_languages %} --group cli{% endif -%}
{%- if api_module == 'enabled' and 'python' in api_languages %} --group api_python --group api_python_test{% endif -%}
{%- if (graphql_api_module|default('disabled')) == 'enabled' or 'graphql' in (api_features|default([])) %} --group graphql_api{% endif -%}
{%- if (websocket_module|default('disabled')) == 'enabled' or 'websocket' in (api_features|default([])) %} --group websocket{% endif -%}
{%- if mcp_module == 'enabled' and 'python' in mcp_languages %} --group mcp{% endif -%}
{%- if (codegen_module|default('disabled')) == 'enabled' %} --group codegen{% endif -%}
{%- endset %}
set shell := ["bash", "-eu", "-o", "pipefail", "-c"]

# Render-time default; override at invocation with QUALITY_PROFILE=strict
export QUALITY_PROFILE := env("QUALITY_PROFILE", "{{ quality_profile|default('standard') }}")

{% raw %}
python_dir := if path_exists("python/pyproject.toml") == "true" { "python" } else { "." }
_ruff_flags := if QUALITY_PROFILE == "strict" { "--select ALL --ignore E203,E266,E501" } else { "" }
_ty_flags := if QUALITY_PROFILE == "strict" { "--error-on-warning" } else { "" }
_pylint_flags := if QUALITY_PROFILE == "strict" { "--errors-only" } else { "" }
coverage_rc := if python_dir == "python" { if path_exists("python/coverage.cfg") == "true" { "coverage.cfg" } else if path_exists("quality/coverage.cfg") == "true" { "../quality/coverage.cfg" } else { "coverage.cfg" } } else { if path_exists("coverage.cfg") == "true" { "coverage.cfg" } else if path_exists("quality/coverage.cfg") == "true" { "quality/coverage.cfg" } else if path_exists("../quality/coverage.cfg") == "true" { "../quality/coverage.cfg" } else { "coverage.cfg" } }
_pylint_rc_rel := if path_exists(".pylintrc") == "true" { ".pylintrc" } else if path_exists("pylintrc") == "true" { "pylintrc" } else if path_exists("quality/.pylintrc") == "true" { "quality/.pylintrc" } else if path_exists("quality/pylintrc") == "true" { "quality/pylintrc" } else if path_exists("../quality/.pylintrc") == "true" { "../quality/.pylintrc" } else if path_exists("../quality/pylintrc") == "true" { "../quality/pylintrc" } else { "" }
pylint_rc := if _pylint_rc_rel == "" { "" } else { absolute_path(_pylint_rc_rel) }
pylint_rc_flag := if pylint_rc == "" { "" } else { "--rcfile " + pylint_rc }
{% endraw %}

{% if _python %}
# Quality suite
quality: quality-python{% if _node %} quality-node{% endif %}

quality-python:
    uv --directory {% raw %}{{ python_dir }}{% endraw %} run --group quality --group test{{ uv_mod_groups }} ruff check {% raw %}{{ _ruff_flags }}{% endraw %}
    uv --directory {% raw %}{{ python_dir }}{% endraw %} run --group quality --group test{{ uv_mod_groups }} ty check {% raw %}{{ _ty_flags }}{% endraw %} src/{{ package_name }}
    uv --directory {% raw %}{{ python_dir }}{% endraw %} run --group quality --group test{{ uv_mod_groups }} pylint {% raw %}{{ _pylint_flags }} {{ pylint_rc_flag }}{% endraw %} src/{{ package_name }} tests
    uv --directory {% raw %}{{ python_dir }}{% endraw %} run --group quality --group test{{ uv_mod_groups }} coverage run --rcfile {% raw %}{{ coverage_rc }}{% endraw %} -m pytest -ra
    uv --directory {% raw %}{{ python_dir }}{% endraw %} run --group quality coverage report --rcfile {% raw %}{{ coverage_rc }}{% endraw %}

coverage-report:
    uv --directory {% raw %}{{ python_dir }}{% endraw %} run --group quality coverage html --rcfile {% raw %}{{ coverage_rc }}{% endraw %}

format:
    uv --directory {% raw %}{{ python_dir }}{% endraw %} run --group quality ruff format src/{{ package_name }} tests

lint:
    uv --directory {% raw %}{{ python_dir }}{% endraw %} run --group quality --group test{{ uv_mod_groups }} ruff check {% raw %}{{ _ruff_flags }}{% endraw %}
    uv --directory {% raw %}{{ python_dir }}{% endraw %} run --group quality --group test{{ uv_mod_groups }} pylint {% raw %}{{ _pylint_flags }} {{ pylint_rc_flag }}{% endraw %} src/{{ package_name }} tests

typecheck:
    uv --directory {% raw %}{{ python_dir }}{% endraw %} run --group quality --group test{{ uv_mod_groups }} ty check {% raw %}{{ _ty_flags }}{% endraw %} src/{{ package_name }}
{% elif _node %}
quality: quality-node
{% else %}
quality:
    @echo "No Python or Node quality track on this dest"
{% endif %}

{% if _node %}
quality-node:
    #!/usr/bin/env bash
    set -euo pipefail
    command -v pnpm >/dev/null 2>&1 || { echo "pnpm is required for Node quality checks"; exit 1; }
    pnpm --filter api-node lint
    pnpm --filter api-node typecheck

lint-node:
    pnpm --filter api-node lint
{% endif %}

{% if _python %}
# Pre-commit hooks
hooks:
    uv --directory {% raw %}{{ python_dir }}{% endraw %} run --group quality pre-commit install --install-hooks
{% if changelog_module == 'enabled' or quality_profile == 'strict' %}
    uv --directory {% raw %}{{ python_dir }}{% endraw %} run --group quality pre-commit install --hook-type commit-msg
{% endif %}
{% if quality_profile == 'strict' %}
    uv --directory {% raw %}{{ python_dir }}{% endraw %} run --group quality pre-commit install --hook-type pre-push
{% endif %}

hooks-run:
    uv --directory {% raw %}{{ python_dir }}{% endraw %} run --group quality pre-commit run --all-files

hooks-update:
    uv --directory {% raw %}{{ python_dir }}{% endraw %} run --group quality pre-commit autoupdate
{% endif %}
