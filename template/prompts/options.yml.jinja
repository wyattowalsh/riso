# Riso prompt schema (rendered into docs or automation; SSOT is template/copier.yml)
project_layout:
  default: "{{ project_layout }}"
  choices:
    - single-package
    - monorepo
  description: >
    Select between a lightweight single-package layout or a pnpm-backed monorepo
    with dedicated apps/ and packages/ directories.

quality_profile:
  default: "{{ quality_profile }}"
  choices:
    - standard
    - strict
  description: >
    Configure the quality suite profile. Typecheck is ty (not mypy). `standard`
    runs pragmatic linting/type checks, while `strict` enables extended Ruff
    rules and pylint. Riso 2.0 always renders mise.toml; OpenSpec is optional
    via `openspec_extra` (default disabled).

cli_module:
  default: "{{ cli_module }}"
  choices:
    - disabled
    - enabled
  description: >
    When enabled, scaffold CLI applications for the selected `cli_languages`
    (Python Typer, Rust Clap, Go Cobra).

cli_languages:
  default: "{{ cli_languages }}"
  choices:
    - python
    - rust
    - go
  description: >
    Multiselect CLI implementation languages. TypeScript CLI is not scaffolded yet.

api_module:
  default: "{{ api_module }}"
  choices:
    - disabled
    - enabled
  description: Enable REST/HTTP API scaffolding for selected `api_languages`.

api_languages:
  default: "{{ api_languages }}"
  choices:
    - python
    - node
    - rust
    - go
  description: >
    Multiselect API implementation languages (FastAPI, Fastify, Actix, Go frameworks).

api_features:
  default: "{{ api_features }}"
  choices:
    - graphql
    - websocket
  description: >
    Optional API add-ons (multiselect). Empty selection means no GraphQL or WebSocket.

mcp_module:
  default: "{{ mcp_module }}"
  choices:
    - disabled
    - enabled
  description: >
    Enable MCP server scaffolding for selected `mcp_languages`.

docs_module:
  default: "{{ docs_module }}"
  choices:
    - disabled
    - enabled
  description: Enable documentation site scaffolding.

docs_framework:
  default: "{{ docs_framework }}"
  choices:
    - fumadocs
    - sphinx-shibuya
    - docusaurus
  description: >
    Documentation stack: Fumadocs (Next.js), Sphinx Shibuya (Python), or Docusaurus.

shared_logic:
  default: "{{ shared_logic }}"
  choices:
    - disabled
    - enabled
  description: >
    Generate a reusable shared logic package imported by CLI or API modules.

ci_platform:
  default: "{{ ci_platform }}"
  choices:
    - github-actions
    - gitlab-ci
    - circleci
    - none
  description: >
    CI platform scaffolding (`github-actions`, `gitlab-ci`, `circleci`, or
    skip CI templates with `none`).

openspec_extra:
  default: "{{ openspec_extra }}"
  choices:
    - disabled
    - enabled
  description: >
    Optional OpenSpec extra for generated projects (default disabled). Enable
    to copy `openspec/**`. mise.toml always renders and is not gated by this
    extra. Riso 2.0 remaps removed 1.x Copier keys via `riso migrate` /
    `riso update` (dry-run preview) then fail-closed on leftovers. No dual-path
    aliases after remap.
