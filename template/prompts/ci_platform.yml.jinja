# CI platform configuration prompt

ci_platform:
  default: "{{ ci_platform }}"
  choices:
    - github-actions
    - gitlab-ci
    - circleci
    - none
  description: >
    Configure continuous integration platform. `github-actions` scaffolds
    automated quality workflows with matrix testing, caching, and artifact
    uploads. `gitlab-ci` scaffolds GitLab CI with parallel.matrix and Pages.
    `circleci` scaffolds CircleCI 2.1 with orbs and workspaces. `none` skips
    CI scaffolding entirely for manual setup or alternative platforms.
